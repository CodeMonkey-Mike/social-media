  "end": 20.520816,
  "sil_before": [
   9.723673,
   10.405556
  ],
  "sil_after": [
   20.520816,
   21.183152
  ],
  "i": 1,
  "text": "There are a couple of unique things this time around. So I'm going to say, hey, maybe it's not, or I don't know. Let's see both sides of the story, because this time."
 },
