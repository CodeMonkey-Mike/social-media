# Goal: track CODE ONLY. All assets are regenerable from YouTube + scripts,
# or curated outside the repo. "Nothing of consequence" lives here.
# Agreed with Mike on 2026-05-28. See ./TODO.md for the discussion + move plan.

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ── Bucketed-out directories ─────────────────────────────────────────────────
# NOTE: .gitignore has NO inline comments — "#" only starts a comment at the
# start of a line. Keep each pattern alone on its own line (a trailing "# ..."
# becomes part of the pattern and silently matches nothing).
assets/**
# ^ ignore all assets CONTENT (SFX, b-roll PNGs, logos, clip copies, renders)
# but TRACK code/data/docs under assets (library catalogs, engines, scripts,
# galleries) — changed 2026-06-20; the old blanket `assets/` hid the transitions
# library's own source. Media stays ignored via the extensions block below.
!assets/**/
!assets/**/*.json
!assets/**/*.js
!assets/**/*.ts
!assets/**/*.tsx
!assets/**/*.jsx
!assets/**/*.md
!assets/**/*.html
!assets/**/*.css
!assets/**/*.py
# Keep the huge vendor transition pack fully OUT regardless of file type:
assets/transitions/Swiftly Studio 850 Seamless Transitions/
livestream-repurpose/media/
# ^ source livestreams (on YouTube)
livestream-repurpose/transcripts/
# ^ Whisper output (re-run as needed)
remotion/out/
# ^ renders

# ── Per-clip artifacts (regenerable from source + scripts) ───────────────────
**/preview.mp4
**/whisper-words.json
**/captions.ts.draft

# ── Media file extensions (safety net for stray binaries anywhere) ───────────
*.mp4
*.mov
*.mkv
*.webm
*.m4v
*.mp3
*.wav
*.aiff
*.aif
*.m4a
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.ico

# ── Logs / temp / OS junk ────────────────────────────────────────────────────
*.log
*.timemap.txt
__pycache__/
*.pyc
.DS_Store
Thumbs.db
