  "events": [ {
    "tStartMs": 540,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "- I'm outside the NASDAQ stock market,"
    } ]
  }, {
    "tStartMs": 2280,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "where Anthropic is making"
    } ]
  }, {
    "tStartMs": 3510,
    "dDurationMs": 2013,
    "segs": [ {
      "utf8": "its blockbuster stock market debut."
    } ]
  }, {
    "tStartMs": 12343,
    "dDurationMs": 2237,
    "segs": [ {
      "utf8": "Anthropic priced its IPO at $83 a share,"
    } ]
  }, {
    "tStartMs": 14580,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "giving the company a roughly\n$1.5 trillion valuation"
    } ]
  }, {
    "tStartMs": 18300,
    "dDurationMs": 1863,
    "segs": [ {
      "utf8": "on a fully diluted basis."
    } ]
  }, {
    "tStartMs": 21048,
    "dDurationMs": 2532,
    "segs": [ {
      "utf8": "What makes this valuation so\nincredible is that in 2024,"
    } ]
  }, {
    "tStartMs": 23580,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "the company was worth just $18 billion,"
    } ]
  }, {
    "tStartMs": 27060,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "and six years ago, it\ndidn't even exist yet."
    } ]
  }, {
    "tStartMs": 29970,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "- Today puts the company in a\nstronger financial position,"
    } ]
  }, {
    "tStartMs": 33300,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "and in doing so,"
    } ]
  }, {
    "tStartMs": 34230,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "only strengthens our resolve\nto do the right thing."
    } ]
  }, {
    "tStartMs": 36960,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "- Anthropic raised roughly\n$80 billion in its IPO,"
    } ]
  }, {
    "tStartMs": 40860,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "not including another $26 billion"
    } ]
  }, {
    "tStartMs": 43350,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "that lined up in investments"
    } ]
  }, {
    "tStartMs": 45090,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "from companies like Nvidia and Google."
    } ]
  }, {
    "tStartMs": 47910,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "That's more than the $75 billion"
    } ]
  }, {
    "tStartMs": 50580,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Elon Musk's SpaceX raised in June."
    } ]
  }, {
    "tStartMs": 53310,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Anthropic's road to its IPO"
    } ]
  }, {
    "tStartMs": 54870,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "has been full of twists and turns."
    } ]
  }, {
    "tStartMs": 56580,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "In the past several weeks,"
    } ]
  }, {
    "tStartMs": 59120,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "AI company shares have swooned"
    } ]
  }, {
    "tStartMs": 60390,
    "dDurationMs": 2506,
    "segs": [ {
      "utf8": "following the midterm elections"
    } ]
  }, {
    "tStartMs": 62896,
    "dDurationMs": 2965,
    "segs": [ {
      "utf8": "and expectations for more\ndata center regulation."
    } ]
  }, {
    "tStartMs": 65861,
    "dDurationMs": 1789,
    "segs": [ {
      "utf8": "It's also been on the road\npitching investors at a time"
    } ]
  }, {
    "tStartMs": 67650,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "when Wall Street and\nSilicon Valley are gripped"
    } ]
  }, {
    "tStartMs": 69930,
    "dDurationMs": 4313,
    "segs": [ {
      "utf8": "by the dramatic exit of former\nNvidia CEO, Jensen Huang."
    } ]
  }, {
    "tStartMs": 75104,
    "dDurationMs": 1906,
    "segs": [ {
      "utf8": "In June, many on Wall\nStreet expected Anthropic"
    } ]
  }, {
    "tStartMs": 77010,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "to command evaluation of\ncloser to $2 trillion."
    } ]
  }, {
    "tStartMs": 80190,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "That has come down a lot."
    } ]
  }, {
    "tStartMs": 81750,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "We'll be watching to see how\nbig Anthropic's IPO pop is"
    } ]
  }, {
    "tStartMs": 85590,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "or how much its shares\ntrade up in the first day."
    } ]
  }, {
    "tStartMs": 89295,
    "dDurationMs": 3645,
    "segs": [ {
      "utf8": "Anthropic's debut cements 2026\nas the year of the mega IPO."
    } ]
  }, {
    "tStartMs": 92940,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Companies going public in the US"
    } ]
  }, {
    "tStartMs": 94800,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "through traditional IPOs have raised"
    } ]
  }, {
    "tStartMs": 96510,
    "dDurationMs": 2103,
    "segs": [ {
      "utf8": "a record amount of money this year."
    } ]
  }, {
    "tStartMs": 99561,
    "dDurationMs": 3489,
    "segs": [ {
      "utf8": "Their successes paved the way\nfor more mega IPOs in 2027,"
    } ]
  }, {
    "tStartMs": 103050,
    "dDurationMs": 2650,
    "segs": [ {
      "utf8": "including one from\nAnthropic's rival, OpenAI."
    } ]
