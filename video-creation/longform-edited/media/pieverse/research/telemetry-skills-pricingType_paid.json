sferred to an Exchange\n* [Deflationary Benefit] → Transferred to a Burn Address\n* [Liquidity Operation] → Transferred to a DEX Router\n* [Internal Consolidation / Pending Observation] → Transferred to an Unknown Wallet\n\n## 3. Behavioral Characterization\nComprehensive analysis of fund accumulation intent.\n## 4. Trading Volume Ranking\nTop 3 volume rankings across Binance, OKX, and Bybit.\n## Optional: Deep Analysis\n\npython detect.py --chain eth --token CONTRACT_ADDRESS --etherscan-key YOUR_KEY\n\nProvide an API Key to enable deployer analysis, router transactions, and LP operations.\nSupported Chains: ETH · BSC · Solana\n⚠️ Note: Designed for tokens already listed on mainstream exchanges. Not suitable for unlisted meme coins.","category":"defi","iconUrl":"https://r2-image-worker.pieverse-img.workers.dev/e3c0e8e0a347967cf5f47f6136b8166b149565f609692f999078bfcf5daadbed.png","tarballUrl":"https://r2-archive-worker.pieverse-img.workers.dev/1fa0e49ee4f3bfb52c69600235c7a4fe4fe1360ffece772e692a068284b41757.zip","tarballSizeBytes":19983,"version":"1.0.0","compatibility":[],"tags":["crypto","finance","on-chain"],"screenshots":[],"status":"published","pricingType":"paid","priceUsd":"9.99","priceMonthlyUsd":null,"license":null,"platformDeps":[],"configSchema":[],"source":"native","externalId":null,"externalUrl":null,"downloadable":false,"featured":false,"installCount":0,"ratingSum":0,"reviewCount":0,"securityVerified":false,"securityVerifiedAt":"2026-11-02T18:53:10.133Z","securityVerificationSnapshot":{"scanId":"d5376435-0fa2-4d5f-8e43-98a3275b2fb3","overall":{"score":79,"verdict":"warn"},"summary":{"findingsCount":2,"findingsTruncated":false,"returnedFindingsCount":2},"findings":[{"id":"code_scan:wallet_withdraw_transfer_execution:875b989d7ae08c2b","rule":{"ruleId":"WALLET_WITHDRAW_TRANSFER_EXECUTION","analyzer":"rule_analysis","scannerId":"code_scan"},"category":"data_leakage","location":{"line":46,"path":"SKILL.md","column":39},"severity":"high"},{"id":"code_scan:wal