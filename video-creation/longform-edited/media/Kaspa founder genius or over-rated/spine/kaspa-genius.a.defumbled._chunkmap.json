[
 {
  "start": 4.044036,
  "end": 8.946327,
  "sil_before": [
   0.0,
   4.044036
  ],
  "sil_after": [
   8.946327,
   14.703492
  ],
  "i": 0,
  "text": "There's a name printed inside the Ethereum white paper that almost nobody can pronounce."
 },
 {
  "start": 14.703492,
  "end": 16.919093,
  "sil_before": [
   8.946327,
   14.703492
  ],
  "sil_after": [
   16.919093,
   24.494785
  ],
  "i": 1,
  "text": "That name is Yonatan Sampolinsky."
 },
 {
  "start": 24.494785,
  "end": 28.203333,
  "sil_before": [
   16.919093,
   24.494785
  ],
  "sil_after": [
   28.203333,
   33.756168
  ],
  "i": 2,
  "text": "This is the man whose math is cited in the Ethereum white paper."
 },
 {
  "start": 33.756168,
  "end": 39.483401,
  "sil_before": [
   28.203333,
   33.756168
  ],
  "sil_after": [
   39.483401,
   39.842902
  ],
  "i": 3,
  "text": "The man who looked at Bitcoin, the most secure network ever built, and said it was too slow."
 },
 {
  "start": 39.842902,
  "end": 41.23458,
  "sil_before": [
   39.483401,
   39.842902
  ],
  "sil_after": [
   41.23458,
   44.435805
  ],
  "i": 4,
  "text": "then prove that on paper."
 },
 {
  "start": 50.598617,
  "end": 56.803515,
  "sil_before": [
   44.482857,
   50.598617
  ],
  "sil_after": [
   56.803515,
   60.290499
  ],
  "i": 5,
  "text": "He turned the blockchain into a block dag, where blocks stop fighting and start stacking side by side."
 },
 {
  "start": 60.290499,
  "end": 63.106122,
  "sil_before": [
   56.803515,
   60.290499
  ],
  "sil_after": [
   63.106122,
   63.461701
  ],
  "i": 6,
  "text": "He took an idea off of a university chalkboard."
 },
 {
  "start": 63.461701,
  "end": 65.674694,
  "sil_before": [
   63.106122,
   63.461701
  ],
  "sil_after": [
   65.674694,
   66.086916
  ],
  "i": 7,
  "text": "and launch it into a top crypto network."
 },
 {
  "start": 66.086916,
  "end": 66.849864,
  "sil_before": [
   65.674694,
   66.086916
  ],
  "sil_after": [
   66.849864,
   67.196939
  ],
  "i": 8,
  "text": "no company."
 },
 {
  "start": 67.196939,
  "end": 69.254354,
  "sil_before": [
   66.849864,
   67.196939
  ],
  "sil_after": [
   69.254354,
   69.588027
  ],
  "i": 9,
  "text": "No investors, no pre-mine."
 },
 {
  "start": 69.588027,
  "end": 70.641202,
  "sil_before": [
   69.254354,
   69.588027
  ],
  "sil_after": [
   70.641202,
   77.349116
  ],
  "i": 10,
  "text": "Nothing but code."
 },
 {
  "start": 77.349116,
  "end": 78.494218,
  "sil_before": [
   70.641202,
   77.349116
  ],
  "sil_after": [
   78.494218,
   78.813923
  ],
  "i": 11,
  "text": "He's not a CEO."
 },
 {
  "start": 78.813923,
  "end": 80.034966,
  "sil_before": [
   78.494218,
   78.813923
  ],
  "sil_after": [
   80.034966,
   84.658231
  ],
  "i": 12,
  "text": "He's not an influencer."
 },
 {
  "start": 84.658231,
  "end": 89.745011,
  "sil_before": [
   80.034966,
   84.658231
  ],
  "sil_after": [
   89.745011,
   91.463583
  ],
  "i": 13,
  "text": "He's a quiet academic from Israel who rewrote how blockchains agree on reality."
 },
 {
  "start": 91.463583,
  "end": 94.028299,
  "sil_before": [
   89.745011,
   91.463583
  ],
  "sil_after": [
   94.028299,
   94.586599
  ],
  "i": 14,
  "text": "And while every other founder was selling you a dream."
 },
 {
  "start": 94.586599,
  "end": 97.999637,
  "sil_before": [
   94.028299,
   94.586599
  ],
  "sil_after": [
   97.999637,
   107.404127
  ],
  "i": 15,
  "text": "This man was publishing the papers that other founders quote."
 },
 {
  "start": 107.404127,
  "end": 110.708345,
  "sil_before": [
   97.999637,
   107.404127
  ],
  "sil_after": [
   110.708345,
   116.308186
  ],
  "i": 16,
  "text": "So half of crypto calls him a generational genius."
 },
 {
  "start": 116.308186,
  "end": 121.324898,
  "sil_before": [
   110.708345,
   116.308186
  ],
  "sil_after": [
   121.324898,
   124.185896
  ],
  "i": 17,
  "text": "The other half calls him an overrated academic that the Casper community turned into a messiah."
 },
 {
  "start": 124.185896,
  "end": 126.32746,
  "sil_before": [
   121.324898,
   124.185896
  ],
  "sil_after": [
   126.32746,
   127.174603
  ],
  "i": 18,
  "text": "Today we're not picking a side and shouting it."
 },
 {
  "start": 127.174603,
  "end": 128.94034,
  "sil_before": [
   126.32746,
   127.174603
  ],
  "sil_after": [
   128.94034,
   129.245351
  ],
  "i": 19,
  "text": "We put the receipts on the table."
 },
 {
  "start": 129.245351,
  "end": 132.069751,
  "sil_before": [
   128.94034,
   129.245351
  ],
  "sil_after": [
   132.069751,
   132.579841
  ],
  "i": 20,
  "text": "His story, Ghost Ethereum Spectre"
 },
 {
  "start": 132.579841,
  "end": 134.018685,
  "sil_before": [
   132.069751,
   132.579841
  ],
  "sil_after": [
   134.018685,
   136.320839
  ],
  "i": 21,
  "text": "the chain that he actually built."
 },
 {
  "start": 136.320839,
  "end": 138.269546,
  "sil_before": [
   134.018685,
   136.320839
  ],
  "sil_after": [
   138.269546,
   139.348776
  ],
  "i": 22,
  "text": "And the strongest case against him too."
 },
 {
  "start": 139.348776,
  "end": 140.338345,
  "sil_before": [
   138.269546,
   139.348776
  ],
  "sil_after": [
   140.338345,
   145.150181
  ],
  "i": 23,
  "text": "Then you decide."
 },
 {
  "start": 145.150181,
  "end": 146.089342,
  "sil_before": [
   140.338345,
   145.150181
  ],
  "sil_after": [
   146.089342,
   146.53127
  ],
  "i": 24,
  "text": "Then at the end."
 },
 {
  "start": 146.53127,
  "end": 148.909841,
  "sil_before": [
   146.089342,
   146.53127
  ],
  "sil_after": [
   148.909841,
   149.341791
  ],
  "i": 25,
  "text": "I'll tell you exactly where I land."
 },
 {
  "start": 149.341791,
  "end": 150.05898,
  "sil_before": [
   148.909841,
   149.341791
  ],
  "sil_after": [
   150.05898,
   154.728639
  ],
  "i": 26,
  "text": "and why."
 },
 {
  "start": 156.805329,
  "end": 158.402562,
  "sil_before": [
   154.93678,
   156.805329
  ],
  "sil_after": [
   158.402562,
   160.792063
  ],
  "i": 27,
  "text": "So where does this guy come from?"
 },
 {
  "start": 160.792063,
  "end": 163.995556,
  "sil_before": [
   158.402562,
   160.792063
  ],
  "sil_after": [
   163.995556,
   165.908549
  ],
  "i": 28,
  "text": "Before the white papers. Before Casper. Before any of it."
 },
 {
  "start": 165.908549,
  "end": 168.067188,
  "sil_before": [
   163.995556,
   165.908549
  ],
  "sil_after": [
   168.067188,
   170.532132
  ],
  "i": 29,
  "text": "Yonatan was born and raised in Israel."
 },
 {
  "start": 170.532132,
  "end": 174.715034,
  "sil_before": [
   168.067188,
   170.532132
  ],
  "sil_after": [
   174.715034,
   176.545714
  ],
  "i": 30,
  "text": "And the Sompelinsky name carries a story that most people have no idea about."
 },
 {
  "start": 176.545714,
  "end": 178.182268,
  "sil_before": [
   174.715034,
   176.545714
  ],
  "sil_after": [
   178.182268,
   178.642993
  ],
  "i": 31,
  "text": "His grandfather, David."
 },
 {
  "start": 178.642993,
  "end": 184.286712,
  "sil_before": [
   178.182268,
   178.642993
  ],
  "sil_after": [
   184.286712,
   184.761837
  ],
  "i": 32,
  "text": "was a World War II hero who worked with the Danish resistance to smuggle hundreds of Jews"
 },
 {
  "start": 184.761837,
  "end": 186.563492,
  "sil_before": [
   184.286712,
   184.761837
  ],
  "sil_after": [
   186.563492,
   187.035147
  ],
  "i": 33,
  "text": "Out of Nazi-occupied Denmark."
 },
 {
  "start": 187.035147,
  "end": 187.63483,
  "sil_before": [
   186.563492,
   187.035147
  ],
  "sil_after": [
   187.63483,
   188.002971
  ],
  "i": 34,
  "text": "safely."
 },
 {
  "start": 188.002971,
  "end": 188.675488,
  "sil_before": [
   187.63483,
   188.002971
  ],
  "sil_after": [
   188.675488,
   192.302834
  ],
  "i": 35,
  "text": "into Sweden."
 },
 {
  "start": 192.302834,
  "end": 193.633265,
  "sil_before": [
   188.675488,
   192.302834
  ],
  "sil_after": [
   193.633265,
   194.173651
  ],
  "i": 36,
  "text": "His father, I am."
 },
 {
  "start": 194.173651,
  "end": 197.258889,
  "sil_before": [
   193.633265,
   194.173651
  ],
  "sil_after": [
   197.258889,
   197.774898
  ],
  "i": 37,
  "text": "is one of the most respected brain scientists alive."
 },
 {
  "start": 197.774898,
  "end": 200.48356,
  "sil_before": [
   197.258889,
   197.774898
  ],
  "sil_after": [
   200.48356,
   200.889977
  ],
  "i": 38,
  "text": "a Hebrew University and Harvard professor."
 },
 {
  "start": 200.889977,
  "end": 203.10771,
  "sil_before": [
   200.48356,
   200.889977
  ],
  "sil_after": [
   203.10771,
   205.168571
  ],
  "i": 39,
  "text": "who just won the field's biggest prize."
 },
 {
  "start": 205.168571,
  "end": 207.637778,
  "sil_before": [
   203.10771,
   205.168571
  ],
  "sil_after": [
   207.637778,
   208.195646
  ],
  "i": 40,
  "text": "This is not a kid who fell into crypto for the money."
 },
 {
  "start": 208.195646,
  "end": 211.722971,
  "sil_before": [
   207.637778,
   208.195646
  ],
  "sil_after": [
   211.722971,
   216.489977
  ],
  "i": 41,
  "text": "He comes from a family that did big, serious things."
 },
 {
  "start": 216.489977,
  "end": 220.527438,
  "sil_before": [
   211.722971,
   216.489977
  ],
  "sil_after": [
   220.527438,
   222.775465
  ],
  "i": 42,
  "text": "He went to the Hebrew University in Jerusalem to study computer science and math."
 },
 {
  "start": 222.775465,
  "end": 224.474467,
  "sil_before": [
   220.527438,
   222.775465
  ],
  "sil_after": [
   224.474467,
   224.96
  ],
  "i": 43,
  "text": "And here's the part that matters."
 },
 {
  "start": 224.96,
  "end": 228.712086,
  "sil_before": [
   224.474467,
   224.96
  ],
  "sil_after": [
   228.712086,
   229.92415
  ],
  "i": 44,
  "text": "He was not some rich founder who bought his way in later."
 },
 {
  "start": 229.92415,
  "end": 235.602268,
  "sil_before": [
   228.712086,
   229.92415
  ],
  "sil_after": [
   235.602268,
   236.353469
  ],
  "i": 45,
  "text": "He was still a student in 2013 when he and his advisor Aviv Zohar published Ghost."
 },
 {
  "start": 236.353469,
  "end": 239.773946,
  "sil_before": [
   235.602268,
   236.353469
  ],
  "sil_after": [
   239.773946,
   241.177937
  ],
  "i": 46,
  "text": "The exact paper now sitting inside Ethereum is white paper."
 },
 {
  "start": 241.177937,
  "end": 243.651655,
  "sil_before": [
   239.773946,
   241.177937
  ],
  "sil_after": [
   243.651655,
   244.060907
  ],
  "i": 47,
  "text": "He was reshaping how blockchains work."
 },
 {
  "start": 244.060907,
  "end": 245.890771,
  "sil_before": [
   243.651655,
   244.060907
  ],
  "sil_after": [
   245.890771,
   251.968844
  ],
  "i": 48,
  "text": "before he even finished school."
 },
 {
  "start": 251.968844,
  "end": 254.554104,
  "sil_before": [
   245.890771,
   251.968844
  ],
  "sil_after": [
   254.554104,
   256.770249
  ],
  "i": 49,
  "text": "So he's the opposite of every other crypto founder."
 },
 {
  "start": 257.097596,
  "end": 261.34898,
  "sil_before": [
   256.783991,
   257.097596
  ],
  "sil_after": [
   261.34898,
   261.651429
  ],
  "i": 50,
  "text": "No Lambo posts. No daily threads. No countdown to the moon."
 },
 {
  "start": 264.695964,
  "end": 265.580476,
  "sil_before": [
   261.651497,
   264.695964
  ],
  "sil_after": [
   265.580476,
   266.122948
  ],
  "i": 51,
  "text": "He kept going."
 },
 {
  "start": 266.122948,
  "end": 268.789683,
  "sil_before": [
   265.580476,
   266.122948
  ],
  "sil_after": [
   268.789683,
   269.543515
  ],
  "i": 52,
  "text": "The PhD finished around 2018."
 },
 {
  "start": 269.543515,
  "end": 271.446168,
  "sil_before": [
   268.789683,
   269.543515
  ],
  "sil_after": [
   271.446168,
   272.957029
  ],
  "i": 53,
  "text": "then a postdoc in Harvard."
 },
 {
  "start": 272.957029,
  "end": 275.438005,
  "sil_before": [
   271.446168,
   272.957029
  ],
  "sil_after": [
   275.438005,
   280.313923
  ],
  "i": 54,
  "text": "Then the research lab that became Casper."
 },
 {
  "start": 280.313923,
  "end": 283.905941,
  "sil_before": [
   275.438005,
   280.313923
  ],
  "sil_after": [
   283.905941,
   284.976803
  ],
  "i": 55,
  "text": "This is not a marketer who learned to say the word blockdags."
 },
 {
  "start": 284.976803,
  "end": 290.172608,
  "sil_before": [
   283.905941,
   284.976803
  ],
  "sil_after": [
   290.172608,
   299.22746
  ],
  "i": 56,
  "text": "This is one of the people who did the underlying consensus research that the rest of the space quotes."
 },
 {
  "start": 299.22746,
  "end": 308.046168,
  "sil_before": [
   290.172608,
   299.22746
  ],
  "sil_after": [
   308.046168,
   323.335238
  ],
  "i": 57,
  "text": "when the guy who is supposedly overrated is the guy that everyone else is citing. That's a strange kind of overrated, don't you think?"
 },
 {
  "start": 323.335238,
  "end": 324.425306,
  "sil_before": [
   308.046168,
   323.335238
  ],
  "sil_after": [
   324.425306,
   327.053764
  ],
  "i": 58,
  "text": "Here's the first receipt."
 },
 {
  "start": 327.053764,
  "end": 328.207347,
  "sil_before": [
   324.425306,
   327.053764
  ],
  "sil_after": [
   328.207347,
   328.821383
  ],
  "i": 59,
  "text": "In 2013..."
 },
 {
  "start": 328.821383,
  "end": 334.858299,
  "sil_before": [
   328.207347,
   328.821383
  ],
  "sil_after": [
   334.858299,
   339.630567
  ],
  "i": 60,
  "text": "Sam Poliski and Zohar published a paper called the Secure High-Rate Transaction Processing in Bitcoin."
 },
 {
  "start": 339.630567,
  "end": 342.400816,
  "sil_before": [
   334.858299,
   339.630567
  ],
  "sil_after": [
   342.400816,
   346.752268
  ],
  "i": 61,
  "text": "The idea inside it is called ghost."
 },
 {
  "start": 346.752268,
  "end": 350.113696,
  "sil_before": [
   342.400816,
   346.752268
  ],
  "sil_after": [
   350.113696,
   378.436803
  ],
  "i": 62,
  "text": "Ghost stands for greediest, heaviest, observed subtree."
 },
 {
  "start": 378.436803,
  "end": 380.629569,
  "sil_before": [
   350.113696,
   378.436803
  ],
  "sil_after": [
   380.629569,
   381.888458
  ],
  "i": 63,
  "text": "And if you try to say it without being a geek."
 },
 {
  "start": 381.888458,
  "end": 384.213628,
  "sil_before": [
   380.629569,
   381.888458
  ],
  "sil_after": [
   384.213628,
   387.406531
  ],
  "i": 64,
  "text": "is sort of like when you speed up Bitcoin."
 },
 {
  "start": 387.406531,
  "end": 391.107166,
  "sil_before": [
   384.213628,
   387.406531
  ],
  "sil_after": [
   391.107166,
   392.867166
  ],
  "i": 65,
  "text": "the blocks start getting created faster than the network can agree on."
 },
 {
  "start": 392.867166,
  "end": 396.313084,
  "sil_before": [
   391.107166,
   392.867166
  ],
  "sil_after": [
   396.313084,
   397.934558
  ],
  "i": 66,
  "text": "So there's lots of valid blocks getting orphaned and thrown away."
 },
 {
  "start": 397.934558,
  "end": 400.522608,
  "sil_before": [
   396.313084,
   397.934558
  ],
  "sil_after": [
   400.522608,
   406.794376
  ],
  "i": 67,
  "text": "and throwing them away, weak in security."
 },
 {
  "start": 406.794376,
  "end": 410.289206,
  "sil_before": [
   400.522608,
   406.794376
  ],
  "sil_after": [
   410.289206,
   415.292472
  ],
  "i": 68,
  "text": "Ghost says stop ignoring Noah's orphan blocks."
 },
 {
  "start": 415.292472,
  "end": 418.566485,
  "sil_before": [
   410.289206,
   415.292472
  ],
  "sil_after": [
   418.566485,
   419.534014
  ],
  "i": 69,
  "text": "Count their work too when you decide which branch is the real one."
 },
 {
  "start": 419.534014,
  "end": 423.736281,
  "sil_before": [
   418.566485,
   419.534014
  ],
  "sil_after": [
   423.736281,
   432.91458
  ],
  "i": 70,
  "text": "Pick the heaviest observed subtree, not the longest single line."
 },
 {
  "start": 432.91458,
  "end": 434.155556,
  "sil_before": [
   423.736281,
   432.91458
  ],
  "sil_after": [
   434.155556,
   437.565556
  ],
  "i": 71,
  "text": "This is the careful part."
 },
 {
  "start": 437.565556,
  "end": 440.712676,
  "sil_before": [
   434.155556,
   437.565556
  ],
  "sil_after": [
   440.712676,
   446.056213
  ],
  "i": 72,
  "text": "Ethereum's white paper cites this exact paper."
 },
 {
  "start": 446.056213,
  "end": 449.882721,
  "sil_before": [
   440.712676,
   446.056213
  ],
  "sil_after": [
   449.882721,
   450.505986
  ],
  "i": 73,
  "text": "and early Ethereum use a simplified version of the idea."
 },
 {
  "start": 450.505986,
  "end": 451.626281,
  "sil_before": [
   449.882721,
   450.505986
  ],
  "sil_after": [
   451.626281,
   452.33907
  ],
  "i": 74,
  "text": "The Uncle Reward."
 },
 {
  "start": 452.33907,
  "end": 458.198934,
  "sil_before": [
   451.626281,
   452.33907
  ],
  "sil_after": [
   458.198934,
   472.163605
  ],
  "i": 75,
  "text": "paying miners a little for their orphan block so that the network stays secure at fast block times."
 },
 {
  "start": 472.163605,
  "end": 475.004331,
  "sil_before": [
   458.198934,
   472.163605
  ],
  "sil_after": [
   475.004331,
   475.574762
  ],
  "i": 76,
  "text": "And this is not me connecting the dots after the fact."
 },
 {
  "start": 475.574762,
  "end": 476.375986,
  "sil_before": [
   475.004331,
   475.574762
  ],
  "sil_after": [
   476.375986,
   481.10195
  ],
  "i": 77,
  "text": "watch this."
 },
 {
  "start": 481.10195,
  "end": 484.277664,
  "sil_before": [
   476.375986,
   481.10195
  ],
  "sil_after": [
   484.277664,
   488.390952
  ],
  "i": 78,
  "text": "This is a real talk from a 2017 meetup in Brooklyn."
 },
 {
  "start": 488.390952,
  "end": 490.167143,
  "sil_before": [
   484.277664,
   488.390952
  ],
  "sil_after": [
   490.167143,
   490.697007
  ],
  "i": 79,
  "text": "A guy from the Iota network."
 },
 {
  "start": 490.697007,
  "end": 492.139184,
  "sil_before": [
   490.167143,
   490.697007
  ],
  "sil_after": [
   492.139184,
   500.226735
  ],
  "i": 80,
  "text": "Listen to who he credits."
 },
 {
  "start": 500.226735,
  "end": 502.273061,
  "sil_before": [
   492.139184,
   500.226735
  ],
  "sil_after": [
   502.273061,
   502.748571
  ],
  "i": 81,
  "text": "Ghosts and spectra by name."
 },
 {
  "start": 502.748571,
  "end": 504.721723,
  "sil_before": [
   502.273061,
   502.748571
  ],
  "sil_after": [
   504.721723,
   510.465918
  ],
  "i": 82,
  "text": "as Sampalitsky and Zohar's work."
 },
 {
  "start": 510.465918,
  "end": 514.716508,
  "sil_before": [
   504.721723,
   510.465918
  ],
  "sil_after": [
   514.716508,
   538.304218
  ],
  "i": 83,
  "text": "People in the Dag world were studying this man from years ago."
 },
 {
  "start": 538.304218,
  "end": 543.46,
  "sil_before": [
   514.716508,
   538.304218
  ],
  "sil_after": [
   543.46,
   552.685578
  ],
  "i": 84,
  "text": "Now Ghost only patched Bitcoin's tree, but it still kept one single file chain."
 },
 {
  "start": 552.685578,
  "end": 556.228685,
  "sil_before": [
   543.46,
   552.685578
  ],
  "sil_after": [
   556.228685,
   595.022812
  ],
  "i": 85,
  "text": "The next idea threw this single chain out completely."
 },
 {
  "start": 595.022812,
  "end": 597.617574,
  "sil_before": [
   556.228685,
   595.022812
  ],
  "sil_after": [
   597.617574,
   603.52873
  ],
  "i": 86,
  "text": "Now this goes back to the talk that I just showed you."
 },
 {
  "start": 603.52873,
  "end": 606.250975,
  "sil_before": [
   597.617574,
   603.52873
  ],
  "sil_after": [
   606.250975,
   608.297483
  ],
  "i": 87,
  "text": "The guy on stage walked through Ghost Inspector."
 },
 {
  "start": 608.297483,
  "end": 611.084966,
  "sil_before": [
   606.250975,
   608.297483
  ],
  "sil_after": [
   611.084966,
   611.463991
  ],
  "i": 88,
  "text": "Three years after Ghost, in 2016,"
 },
 {
  "start": 611.463991,
  "end": 615.109388,
  "sil_before": [
   611.084966,
   611.463991
  ],
  "sil_after": [
   615.109388,
   622.331973
  ],
  "i": 89,
  "text": "Sam Polinsky teamed up with Aviv Zohar and a third researcher."
 },
 {
  "start": 622.331973,
  "end": 623.501587,
  "sil_before": [
   615.109388,
   622.331973
  ],
  "sil_after": [
   623.501587,
   626.568005
  ],
  "i": 90,
  "text": "Yod Luemberg"
 },
 {
  "start": 626.568005,
  "end": 628.064104,
  "sil_before": [
   623.501587,
   626.568005
  ],
  "sil_after": [
   628.064104,
   631.268526
  ],
  "i": 91,
  "text": "on this second protocol."
 },
 {
  "start": 632.580091,
  "end": 638.618367,
  "sil_before": [
   631.35254,
   632.580091
  ],
  "sil_after": [
   638.618367,
   642.134104
  ],
  "i": 92,
  "text": "And if you never heard of it, that's the whole point. This is deep academic research. They never had a marketing department behind it."
 },
 {
  "start": 642.134104,
  "end": 643.479342,
  "sil_before": [
   638.618367,
   642.134104
  ],
  "sil_after": [
   643.479342,
   647.62746
  ],
  "i": 93,
  "text": "Spectre is an acronym."
 },
 {
  "start": 648.554127,
  "end": 650.290408,
  "sil_before": [
   647.78263,
   648.554127
  ],
  "sil_after": [
   650.290408,
   650.750884
  ],
  "i": 94,
  "text": "It stands for serialization."
 },
 {
  "start": 650.750884,
  "end": 653.815737,
  "sil_before": [
   650.290408,
   650.750884
  ],
  "sil_after": [
   653.815737,
   654.177642
  ],
  "i": 95,
  "text": "of proof of work events, confirming transactions."
 },
 {
  "start": 654.177642,
  "end": 655.9978,
  "sil_before": [
   653.815737,
   654.177642
  ],
  "sil_after": [
   655.9978,
   671.675057
  ],
  "i": 96,
  "text": "via recursive elections."
 },
 {
  "start": 671.675057,
  "end": 675.381655,
  "sil_before": [
   655.9978,
   671.675057
  ],
  "sil_after": [
   675.381655,
   678.994898
  ],
  "i": 97,
  "text": "And no, I don't think you need to remember a single word of that, but..."
 },
 {
  "start": 679.755986,
  "end": 685.457506,
  "sil_before": [
   679.191338,
   679.755986
  ],
  "sil_after": [
   685.457506,
   688.97263
  ],
  "i": 98,
  "text": "Spectre is a from the ground up design for a cryptocurrency that does not use a blockchain at all."
 },
 {
  "start": 688.97263,
  "end": 690.786349,
  "sil_before": [
   685.457506,
   688.97263
  ],
  "sil_after": [
   690.786349,
   692.025873
  ],
  "i": 99,
  "text": "It's not a coin that you can go buy."
 },
 {
  "start": 692.025873,
  "end": 693.548345,
  "sil_before": [
   690.786349,
   692.025873
  ],
  "sil_after": [
   693.548345,
   694.017211
  ],
  "i": 100,
  "text": "It's the research blueprint."
 },
 {
  "start": 694.017211,
  "end": 696.24059,
  "sil_before": [
   693.548345,
   694.017211
  ],
  "sil_after": [
   696.24059,
   705.206961
  ],
  "i": 101,
  "text": "that the real chain gets built from later."
 },
 {
  "start": 705.206961,
  "end": 708.008322,
  "sil_before": [
   696.24059,
   705.206961
  ],
  "sil_after": [
   708.008322,
   708.349297
  ],
  "i": 102,
  "text": "Bitcoin lines up blocks one behind another."
 },
 {
  "start": 708.349297,
  "end": 709.303628,
  "sil_before": [
   708.008322,
   708.349297
  ],
  "sil_after": [
   709.303628,
   709.669184
  ],
  "i": 103,
  "text": "Single file."
 },
 {
  "start": 709.669184,
  "end": 710.714785,
  "sil_before": [
   709.303628,
   709.669184
  ],
  "sil_after": [
   710.714785,
   711.219048
  ],
  "i": 104,
  "text": "every 10 minutes."
 },
 {
  "start": 711.219048,
  "end": 713.71907,
  "sil_before": [
   710.714785,
   711.219048
  ],
  "sil_after": [
   713.71907,
   714.211746
  ],
  "i": 105,
  "text": "Spectre lets blocks be created in parallel."
 },
 {
  "start": 714.211746,
  "end": 715.58737,
  "sil_before": [
   713.71907,
   714.211746
  ],
  "sil_after": [
   715.58737,
   719.15127
  ],
  "i": 106,
  "text": "many at the same moment."
 },
 {
  "start": 719.15127,
  "end": 722.208277,
  "sil_before": [
   715.58737,
   719.15127
  ],
  "sil_after": [
   722.208277,
   725.92127
  ],
  "i": 107,
  "text": "and each new block points back to several earlier ones."
 },
 {
  "start": 725.92127,
  "end": 727.886259,
  "sil_before": [
   722.208277,
   725.92127
  ],
  "sil_after": [
   727.886259,
   729.156009
  ],
  "i": 108,
  "text": "Instead of a chain, you get a web."
 },
 {
  "start": 729.156009,
  "end": 732.710204,
  "sil_before": [
   727.886259,
   729.156009
  ],
  "sil_after": [
   732.710204,
   744.353356
  ],
  "i": 109,
  "text": "That web is a dag. I directed acyclic graph."
 },
 {
  "start": 744.353356,
  "end": 748.940748,
  "sil_before": [
   732.710204,
   744.353356
  ],
  "sil_after": [
   748.940748,
   759.273401
  ],
  "i": 110,
  "text": "The point of the web is speed. Nobody is stuck waiting in a single file line."
 },
 {
  "start": 759.273401,
  "end": 763.303628,
  "sil_before": [
   748.940748,
   759.273401
  ],
  "sil_after": [
   763.303628,
   763.783855
  ],
  "i": 111,
  "text": "The obvious problem with the web is, which block came first?"
 },
 {
  "start": 763.783855,
  "end": 766.0461,
  "sil_before": [
   763.303628,
   763.783855
  ],
  "sil_after": [
   766.0461,
   770.921814
  ],
  "i": 112,
  "text": "Spectra's answer is to let the blocks vote."
 },
 {
  "start": 771.245646,
  "end": 775.602222,
  "sil_before": [
   770.922336,
   771.245646
  ],
  "sil_after": [
   775.602222,
   775.904263
  ],
  "i": 113,
  "text": "Each new block effectively casts a vote on the order of the older ones."
 },
 {
  "start": 775.904263,
  "end": 778.058526,
  "sil_before": [
   775.602222,
   775.904263
  ],
  "sil_after": [
   778.058526,
   785.171723
  ],
  "i": 114,
  "text": "You tally the votes and that settles it."
 },
 {
  "start": 788.19483,
  "end": 790.967007,
  "sil_before": [
   785.363515,
   788.19483
  ],
  "sil_after": [
   790.967007,
   796.869819
  ],
  "i": 115,
  "text": "That's the recursive elections part of the name."
 },
 {
  "start": 796.869819,
  "end": 800.787891,
  "sil_before": [
   790.967007,
   796.869819
  ],
  "sil_after": [
   800.787891,
   801.260454
  ],
  "i": 116,
  "text": "Voting is fast and it's great for one specific question."
 },
 {
  "start": 801.260454,
  "end": 803.857211,
  "sil_before": [
   800.787891,
   801.260454
  ],
  "sil_after": [
   803.857211,
   809.573787
  ],
  "i": 117,
  "text": "Did payment A happen before payment B?"
 },
 {
  "start": 809.573787,
  "end": 814.121882,
  "sil_before": [
   803.857211,
   809.573787
  ],
  "sil_after": [
   814.121882,
   817.022585
  ],
  "i": 118,
  "text": "But it does not hand you a single master list of every transaction in order."
 },
 {
  "start": 827.029229,
  "end": 830.331043,
  "sil_before": [
   817.116077,
   827.029229
  ],
  "sil_after": [
   830.331043,
   838.587415
  ],
  "i": 119,
  "text": "And you need the master list to run things like smart contracts."
 },
 {
  "start": 838.587415,
  "end": 841.459206,
  "sil_before": [
   830.331043,
   838.587415
  ],
  "sil_after": [
   841.459206,
   852.98229
  ],
  "i": 120,
  "text": "Spectre nailed the head-to-head but not the full lineup."
 },
 {
  "start": 852.98229,
  "end": 857.957483,
  "sil_before": [
   841.459206,
   852.98229
  ],
  "sil_after": [
   857.957483,
   860.095102
  ],
  "i": 121,
  "text": "So Sompolinsky and Zolhar took one more step and generalized Ghost onto the web."
 },
 {
  "start": 860.095102,
  "end": 863.289637,
  "sil_before": [
   857.957483,
   860.095102
  ],
  "sil_after": [
   863.289637,
   863.745329
  ],
  "i": 122,
  "text": "Ghost Dag keeps every honestly created block."
 },
 {
  "start": 863.745329,
  "end": 868.038934,
  "sil_before": [
   863.289637,
   863.745329
  ],
  "sil_after": [
   868.038934,
   868.726712
  ],
  "i": 123,
  "text": "and uses how well connected each block is to pick out the honest cluster."
 },
 {
  "start": 868.726712,
  "end": 871.265306,
  "sil_before": [
   868.038934,
   868.726712
  ],
  "sil_after": [
   871.265306,
   884.305261
  ],
  "i": 124,
  "text": "then lays all of them down in one agreed order."
 },
 {
  "start": 884.305261,
  "end": 885.49678,
  "sil_before": [
   871.265306,
   884.305261
  ],
  "sil_after": [
   885.49678,
   885.799751
  ],
  "i": 125,
  "text": "That's the whole leap."
 },
 {
  "start": 885.799751,
  "end": 888.668345,
  "sil_before": [
   885.49678,
   885.799751
  ],
  "sil_after": [
   888.668345,
   894.59229
  ],
  "i": 126,
  "text": "Bitcoin keeps one block and burns the rest."
 },
 {
  "start": 894.59229,
  "end": 897.596485,
  "sil_before": [
   888.668345,
   894.59229
  ],
  "sil_after": [
   897.596485,
   903.349887
  ],
  "i": 127,
  "text": "Ghostag keeps them all and still agrees on the order."
 },
 {
  "start": 905.790159,
  "end": 908.05449,
  "sil_before": [
   903.380703,
   905.790159
  ],
  "sil_after": [
   908.05449,
   929.086349
  ],
  "i": 128,
  "text": "And that's the engine under Casper."
 },
 {
  "start": 934.685737,
  "end": 942.004762,
  "sil_before": [
   929.319524,
   934.685737
  ],
  "sil_after": [
   942.004762,
   942.321497
  ],
  "i": 129,
  "text": "And by the way, click that like and click the subscribe button if you're not subscribed already. If you like this content and if you want to see more of it, of course."
 },
 {
  "start": 942.321497,
  "end": 951.619546,
  "sil_before": [
   942.004762,
   942.321497
  ],
  "sil_after": [
   951.619546,
   951.93873
  ],
  "i": 130,
  "text": "Click that like button and while you're at it, click the link in the description below. We got tons of tech and we got the most amazing calls ever. We outperform everybody."
 },
 {
  "start": 951.93873,
  "end": 952.786122,
  "sil_before": [
   951.619546,
   951.93873
  ],
  "sil_after": [
   952.786122,
   953.156576
  ],
  "i": 131,
  "text": "I'm serious."
 },
 {
  "start": 953.156576,
  "end": 954.336281,
  "sil_before": [
   952.786122,
   953.156576
  ],
  "sil_after": [
   954.336281,
   954.897596
  ],
  "i": 132,
  "text": "Click the link in the description."
 },
 {
  "start": 954.897596,
  "end": 955.333447,
  "sil_before": [
   954.336281,
   954.897596
  ],
  "sil_after": [
   955.333447,
   996.468413
  ],
  "i": 133,
  "text": "now."
 },
 {
  "start": 996.468413,
  "end": 997.796961,
  "sil_before": [
   955.333447,
   996.468413
  ],
  "sil_after": [
   997.796961,
   999.603401
  ],
  "i": 134,
  "text": "So papers are cheap."
 },
 {
  "start": 999.603401,
  "end": 1003.775692,
  "sil_before": [
   997.796961,
   999.603401
  ],
  "sil_after": [
   1003.775692,
   1004.820635
  ],
  "i": 135,
  "text": "Crypto is full of brilliant white papers and never come to a living network."
 },
 {
  "start": 1004.820635,
  "end": 1010.010227,
  "sil_before": [
   1003.775692,
   1004.820635
  ],
  "sil_after": [
   1010.010227,
   1011.831678
  ],
  "i": 136,
  "text": "The thing that separates Sam Polinsky from a pure academic is that he actually shipped."
 },
 {
  "start": 1011.831678,
  "end": 1012.993265,
  "sil_before": [
   1010.010227,
   1011.831678
  ],
  "sil_after": [
   1012.993265,
   1013.4022
  ],
  "i": 137,
  "text": "In 2021."
 },
 {
  "start": 1013.4022,
  "end": 1017.428685,
  "sil_before": [
   1012.993265,
   1013.4022
  ],
  "sil_after": [
   1017.428685,
   1017.976644
  ],
  "i": 138,
  "text": "Ghost Dag went from a PDF to a live proof of work layer one."
 },
 {
  "start": 1017.976644,
  "end": 1021.607823,
  "sil_before": [
   1017.428685,
   1017.976644
  ],
  "sil_after": [
   1021.607823,
   1021.913288
  ],
  "i": 139,
  "text": "and then launch yourself as part of a genius case. No pre-mind."
 },
 {
  "start": 1021.913288,
  "end": 1025.487347,
  "sil_before": [
   1021.607823,
   1021.913288
  ],
  "sil_after": [
   1025.487347,
   1028.372517
  ],
  "i": 140,
  "text": "No ICO, no pre-sale, no insider allocation."
 },
 {
  "start": 1029.896417,
  "end": 1035.744989,
  "sil_before": [
   1028.580227,
   1029.896417
  ],
  "sil_after": [
   1035.744989,
   1042.503175
  ],
  "i": 141,
  "text": "A founder who could have minted himself a fortune chose to launch it the hard, credibly neutral way."
 },
 {
  "start": 1042.503175,
  "end": 1045.835941,
  "sil_before": [
   1035.744989,
   1042.503175
  ],
  "sil_after": [
   1045.835941,
   1049.402971
  ],
  "i": 142,
  "text": "This is a deliberate choice, and it's the opposite of a hype grift."
 },
 {
  "start": 1049.402971,
  "end": 1053.699546,
  "sil_before": [
   1045.835941,
   1049.402971
  ],
  "sil_after": [
   1053.699546,
   1054.123152
  ],
  "i": 143,
  "text": "And he did not stop. With Michael Sutton, he co-authored Dag Night."
 },
 {
  "start": 1054.123152,
  "end": 1058.897778,
  "sil_before": [
   1053.699546,
   1054.123152
  ],
  "sil_after": [
   1058.897778,
   1059.361429
  ],
  "i": 144,
  "text": "a parameterless responsive consensus that adapts to network conditions."
 },
 {
  "start": 1059.361429,
  "end": 1060.604444,
  "sil_before": [
   1058.897778,
   1059.361429
  ],
  "sil_after": [
   1060.604444,
   1062.611882
  ],
  "i": 145,
  "text": "instead of hard coding them."
 },
 {
  "start": 1062.611882,
  "end": 1065.059252,
  "sil_before": [
   1060.604444,
   1062.611882
  ],
  "sil_after": [
   1065.059252,
   1068.176916
  ],
  "i": 146,
  "text": "That research didn't freeze in 2013."
 },
 {
  "start": 1080.931043,
  "end": 1084.350068,
  "sil_before": [
   1068.341746,
   1080.931043
  ],
  "sil_after": [
   1084.350068,
   1088.871859
  ],
  "i": 147,
  "text": "A real engine. A live chain. A clean network."
 },
 {
  "start": 1088.871859,
  "end": 1091.2222,
  "sil_before": [
   1084.350068,
   1088.871859
  ],
  "sil_after": [
   1091.2222,
   1102.076893
  ],
  "i": 148,
  "text": "And the next protocol actually written."
 },
 {
  "start": 1102.076893,
  "end": 1105.157937,
  "sil_before": [
   1091.2222,
   1102.076893
  ],
  "sil_after": [
   1105.157937,
   1125.432177
  ],
  "i": 149,
  "text": "So that's not a man resting on a 2013 citation."
 },
 {
  "start": 1125.432177,
  "end": 1127.59068,
  "sil_before": [
   1105.157937,
   1125.432177
  ],
  "sil_after": [
   1127.59068,
   1131.590181
  ],
  "i": 150,
  "text": "But let's be honest, here's the other side."
 },
 {
  "start": 1131.590181,
  "end": 1133.546825,
  "sil_before": [
   1127.59068,
   1131.590181
  ],
  "sil_after": [
   1133.546825,
   1134.43517
  ],
  "i": 151,
  "text": "If I only gave you the genius case."
 },
 {
  "start": 1134.43517,
  "end": 1136.159297,
  "sil_before": [
   1133.546825,
   1134.43517
  ],
  "sil_after": [
   1136.159297,
   1137.322517
  ],
  "i": 152,
  "text": "I'm selling you, not informing you."
 },
 {
  "start": 1137.322517,
  "end": 1140.085102,
  "sil_before": [
   1136.159297,
   1137.322517
  ],
  "sil_after": [
   1140.085102,
   1143.729184
  ],
  "i": 153,
  "text": "So here's the strongest version of overrated straight."
 },
 {
  "start": 1143.729184,
  "end": 1148.247619,
  "sil_before": [
   1140.085102,
   1143.729184
  ],
  "sil_after": [
   1148.247619,
   1148.83263
  ],
  "i": 154,
  "text": "Being cited in the Ethereum white paper is not the same as Ethereum depending on you."
 },
 {
  "start": 1149.271202,
  "end": 1154.955215,
  "sil_before": [
   1148.834036,
   1149.271202
  ],
  "sil_after": [
   1154.955215,
   1156.066508
  ],
  "i": 155,
  "text": "Full Ghost was never the live fork choice. What shipped was a simplified uncle reward."
 },
 {
  "start": 1156.940816,
  "end": 1158.123175,
  "sil_before": [
   1156.23941,
   1156.940816
  ],
  "sil_after": [
   1158.123175,
   1158.494649
  ],
  "i": 156,
  "text": "A footnote in history."
 },
 {
  "start": 1158.494649,
  "end": 1159.431723,
  "sil_before": [
   1158.123175,
   1158.494649
  ],
  "sil_after": [
   1159.431723,
   1162.733356
  ],
  "i": 157,
  "text": "is not a throne."
 },
 {
  "start": 1162.733356,
  "end": 1163.488503,
  "sil_before": [
   1159.431723,
   1162.733356
  ],
  "sil_after": [
   1163.488503,
   1163.944286
  ],
  "i": 158,
  "text": "Zohar."
 },
 {
  "start": 1163.944286,
  "end": 1166.145964,
  "sil_before": [
   1163.488503,
   1163.944286
  ],
  "sil_after": [
   1166.145964,
   1166.598798
  ],
  "i": 159,
  "text": "Lewinburg, Wyborski, Sutton."
 },
 {
  "start": 1166.598798,
  "end": 1168.150023,
  "sil_before": [
   1166.145964,
   1166.598798
  ],
  "sil_after": [
   1168.150023,
   1179.970385
  ],
  "i": 160,
  "text": "These papers were co-authored."
 },
 {
  "start": 1179.970385,
  "end": 1182.888571,
  "sil_before": [
   1168.150023,
   1179.970385
  ],
  "sil_after": [
   1182.888571,
   1183.240476
  ],
  "i": 161,
  "text": "The Casper Community's One Lone Genius Story."
 },
 {
  "start": 1183.240476,
  "end": 1187.54322,
  "sil_before": [
   1182.888571,
   1183.240476
  ],
  "sil_after": [
   1187.54322,
   1193.319955
  ],
  "i": 162,
  "text": "flattens a body of collaborative academic work into a cult of personality."
 },
 {
  "start": 1193.319955,
  "end": 1195.915873,
  "sil_before": [
   1187.54322,
   1193.319955
  ],
  "sil_after": [
   1195.915873,
   1196.308571
  ],
  "i": 163,
  "text": "IOTAS Tangle Nano Hashgraph"
 },
 {
  "start": 1196.308571,
  "end": 1199.070181,
  "sil_before": [
   1195.915873,
   1196.308571
  ],
  "sil_after": [
   1199.070181,
   1202.7078
  ],
  "i": 164,
  "text": "and others chase dag style ledgers in parallel."
 },
 {
  "start": 1202.7078,
  "end": 1205.631429,
  "sil_before": [
   1199.070181,
   1202.7078
  ],
  "sil_after": [
   1205.631429,
   1225.354354
  ],
  "i": 165,
  "text": "The idea of blocks in a graph was in the water."
 },
 {
  "start": 1225.354354,
  "end": 1226.447914,
  "sil_before": [
   1205.631429,
   1225.354354
  ],
  "sil_after": [
   1226.447914,
   1226.935147
  ],
  "i": 166,
  "text": "For all the research..."
 },
 {
  "start": 1226.935147,
  "end": 1230.350045,
  "sil_before": [
   1226.447914,
   1226.935147
  ],
  "sil_after": [
   1230.350045,
   1232.855125
  ],
  "i": 167,
  "text": "Casper is a fraction of the size of all the changes compared to."
 },
 {
  "start": 1234.068707,
  "end": 1237.107596,
  "sil_before": [
   1232.870091,
   1234.068707
  ],
  "sil_after": [
   1237.107596,
   1237.452426
  ],
  "i": 168,
  "text": "If the tech is this far ahead as skeptic asks."
 },
 {
  "start": 1237.452426,
  "end": 1240.075828,
  "sil_before": [
   1237.107596,
   1237.452426
  ],
  "sil_after": [
   1240.075828,
   1254.219683
  ],
  "i": 169,
  "text": "Why is the market not pricing a genius?"
 },
 {
  "start": 1254.219683,
  "end": 1256.719841,
  "sil_before": [
   1240.075828,
   1254.219683
  ],
  "sil_after": [
   1256.719841,
   1257.265646
  ],
  "i": 170,
  "text": "Yes, haters are everywhere."
 },
 {
  "start": 1257.265646,
  "end": 1259.525805,
  "sil_before": [
   1256.719841,
   1257.265646
  ],
  "sil_after": [
   1259.525805,
   1260.594308
  ],
  "i": 171,
  "text": "He's not a messiah, of course."
 },
 {
  "start": 1275.010748,
  "end": 1276.054535,
  "sil_before": [
   1260.666712,
   1275.010748
  ],
  "sil_after": [
   1276.054535,
   1276.525533
  ],
  "i": 172,
  "text": "So what's the verdict?"
 },
 {
  "start": 1276.525533,
  "end": 1278.423401,
  "sil_before": [
   1276.054535,
   1276.525533
  ],
  "sil_after": [
   1278.423401,
   1284.309116
  ],
  "i": 173,
  "text": "So the cold framing loses."
 },
 {
  "start": 1284.309116,
  "end": 1285.543039,
  "sil_before": [
   1278.423401,
   1284.309116
  ],
  "sil_after": [
   1285.543039,
   1285.986213
  ],
  "i": 174,
  "text": "He's not a messiah."
 },
 {
  "start": 1285.986213,
  "end": 1288.111587,
  "sil_before": [
   1285.543039,
   1285.986213
  ],
  "sil_after": [
   1288.111587,
   1291.790272
  ],
  "i": 175,
  "text": "He didn't invent DAGs alone."
 },
 {
  "start": 1291.790272,
  "end": 1294.054626,
  "sil_before": [
   1288.111587,
   1291.790272
  ],
  "sil_after": [
   1294.054626,
   1302.446576
  ],
  "i": 176,
  "text": "And a citation is not a coronation."
 },
 {
  "start": 1302.446576,
  "end": 1305.473741,
  "sil_before": [
   1294.054626,
   1302.446576
  ],
  "sil_after": [
   1305.473741,
   1306.19483
  ],
  "i": 177,
  "text": "But strip all that away and look at what's still standing."
 },
 {
  "start": 1306.19483,
  "end": 1310.361678,
  "sil_before": [
   1305.473741,
   1306.19483
  ],
  "sil_after": [
   1310.361678,
   1314.021179
  ],
  "i": 178,
  "text": "2013 idea cited by the second biggest network in crypto"
 },
 {
  "start": 1314.021179,
  "end": 1319.066213,
  "sil_before": [
   1310.361678,
   1314.021179
  ],
  "sil_after": [
   1319.066213,
   1319.849819
  ],
  "i": 179,
  "text": "A line of protocols, ghost to spectre to ghostag to dagnight."
 },
 {
  "start": 1319.849819,
  "end": 1322.700181,
  "sil_before": [
   1319.066213,
   1319.849819
  ],
  "sil_after": [
   1322.700181,
   1325.950794
  ],
  "i": 180,
  "text": "Each one solving what the latest one left open."
 },
 {
  "start": 1325.950794,
  "end": 1328.261746,
  "sil_before": [
   1322.700181,
   1325.950794
  ],
  "sil_after": [
   1328.261746,
   1328.700454
  ],
  "i": 181,
  "text": "and a live chain, fairly launched."
 },
 {
  "start": 1328.700454,
  "end": 1330.926757,
  "sil_before": [
   1328.261746,
   1328.700454
  ],
  "sil_after": [
   1330.926757,
   1335.397619
  ],
  "i": 182,
  "text": "running the thing he proved on paper."
 },
 {
  "start": 1335.397619,
  "end": 1336.521746,
  "sil_before": [
   1330.926757,
   1335.397619
  ],
  "sil_after": [
   1336.521746,
   1336.876825
  ],
  "i": 183,
  "text": "overrated men."
 },
 {
  "start": 1336.876825,
  "end": 1339.64619,
  "sil_before": [
   1336.521746,
   1336.876825
  ],
  "sil_after": [
   1339.64619,
   1346.670658
  ],
  "i": 184,
  "text": "Have one good year and a loud fan club."
 },
 {
  "start": 1349.255034,
  "end": 1354.516395,
  "sil_before": [
   1346.724989,
   1349.255034
  ],
  "sil_after": [
   1354.516395,
   1361.707302
  ],
  "i": 185,
  "text": "This man has a decade of work that other people keep building on."
 },
 {
  "start": 1361.707302,
  "end": 1364.063787,
  "sil_before": [
   1354.516395,
   1361.707302
  ],
  "sil_after": [
   1364.063787,
   1367.431723
  ],
  "i": 186,
  "text": "So that's not overrated."
 },
 {
  "start": 1367.431723,
  "end": 1371.222698,
  "sil_before": [
   1364.063787,
   1367.431723
  ],
  "sil_after": [
   1371.222698,
   1372.086236
  ],
  "i": 187,
  "text": "This is a quiet genius, the timeline is too distracted to notice."
 },
 {
  "start": 1372.086236,
  "end": 1376.338934,
  "sil_before": [
   1371.222698,
   1372.086236
  ],
  "sil_after": [
   1376.338934,
   1383.825011
  ],
  "i": 188,
  "text": "And the market noticing late is exactly the asymmetry I look for."
 },
 {
  "start": 1383.825011,
  "end": 1387.124875,
  "sil_before": [
   1376.338934,
   1383.825011
  ],
  "sil_after": [
   1387.124875,
   1389.849456
  ],
  "i": 189,
  "text": "Tell me in the comments, genius overrated."
 },
 {
  "start": 1389.849456,
  "end": 1391.005805,
  "sil_before": [
   1387.124875,
   1389.849456
  ],
  "sil_after": [
   1391.005805,
   1397.60907
  ],
  "i": 190,
  "text": "I already told you mine."
 }
]