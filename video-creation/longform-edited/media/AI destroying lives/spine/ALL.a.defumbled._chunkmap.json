[
 {
  "start": 8.662857,
  "end": 11.869932,
  "sil_before": [
   0.0,
   8.662857
  ],
  "sil_after": [
   11.869932,
   12.239342
  ],
  "i": 0,
  "text": "Some of those people say that AI took their work."
 },
 {
  "start": 12.239342,
  "end": 14.884875,
  "sil_before": [
   11.869932,
   12.239342
  ],
  "sil_after": [
   14.884875,
   22.354444
  ],
  "i": 1,
  "text": "and all of them have been searching for months."
 },
 {
  "start": 22.354444,
  "end": 29.018322,
  "sil_before": [
   14.884875,
   22.354444
  ],
  "sil_after": [
   29.018322,
   33.62288
  ],
  "i": 2,
  "text": "This is not a warning about the future. It's already happening in jobs that felt safe just two years ago."
 },
 {
  "start": 33.62288,
  "end": 38.69254,
  "sil_before": [
   29.018322,
   33.62288
  ],
  "sil_after": [
   38.69254,
   44.569955
  ],
  "i": 3,
  "text": "And the next jobs in line are the ones you were told a machine could never do."
 },
 {
  "start": 44.569955,
  "end": 46.057937,
  "sil_before": [
   38.69254,
   44.569955
  ],
  "sil_after": [
   46.057937,
   54.224558
  ],
  "i": 4,
  "text": "So let's unpack all of this."
 },
 {
  "start": 54.224558,
  "end": 56.782948,
  "sil_before": [
   46.057937,
   54.224558
  ],
  "sil_after": [
   56.782948,
   57.156304
  ],
  "i": 5,
  "text": "I covered the first wave in my last two videos."
 },
 {
  "start": 57.156304,
  "end": 59.745057,
  "sil_before": [
   56.782948,
   57.156304
  ],
  "sil_after": [
   59.745057,
   69.132834
  ],
  "i": 6,
  "text": "So I'm not going to go back over those jobs in particular."
 },
 {
  "start": 69.132834,
  "end": 70.786621,
  "sil_before": [
   59.745057,
   69.132834
  ],
  "sil_after": [
   70.786621,
   71.431406
  ],
  "i": 7,
  "text": "this year through October."
 },
 {
  "start": 71.431406,
  "end": 77.486349,
  "sil_before": [
   70.786621,
   71.431406
  ],
  "sil_after": [
   77.486349,
   81.305329
  ],
  "i": 8,
  "text": "Employers named AI as a reason for 121,000 401 job cuts."
 },
 {
  "start": 81.305329,
  "end": 82.924535,
  "sil_before": [
   77.486349,
   81.305329
  ],
  "sil_after": [
   82.924535,
   83.299955
  ],
  "i": 9,
  "text": "since 2023."
 },
 {
  "start": 83.299955,
  "end": 85.074807,
  "sil_before": [
   82.924535,
   83.299955
  ],
  "sil_after": [
   85.074807,
   85.407506
  ],
  "i": 10,
  "text": "193,000."
 },
 {
  "start": 85.407506,
  "end": 86.278844,
  "sil_before": [
   85.074807,
   85.407506
  ],
  "sil_after": [
   86.278844,
   92.118345
  ],
  "i": 11,
  "text": "226."
 },
 {
  "start": 92.118345,
  "end": 92.711451,
  "sil_before": [
   86.278844,
   92.118345
  ],
  "sil_after": [
   92.711451,
   93.109819
  ],
  "i": 12,
  "text": "Here's the thing."
 },
 {
  "start": 93.109819,
  "end": 95.65932,
  "sil_before": [
   92.711451,
   93.109819
  ],
  "sil_after": [
   95.65932,
   96.031474
  ],
  "i": 13,
  "text": "October was the lowest month of the year."
 },
 {
  "start": 96.031474,
  "end": 97.847574,
  "sil_before": [
   95.65932,
   96.031474
  ],
  "sil_after": [
   97.847574,
   101.105737
  ],
  "i": 14,
  "text": "only 1265."
 },
 {
  "start": 101.105737,
  "end": 103.353946,
  "sil_before": [
   97.847574,
   101.105737
  ],
  "sil_after": [
   103.353946,
   103.778957
  ],
  "i": 15,
  "text": "But a layoff announcement is the loud part."
 },
 {
  "start": 103.778957,
  "end": 107.060567,
  "sil_before": [
   103.353946,
   103.778957
  ],
  "sil_after": [
   107.060567,
   111.896553
  ],
  "i": 16,
  "text": "The quiet part is the job that never gets posted."
 },
 {
  "start": 111.896553,
  "end": 118.297166,
  "sil_before": [
   107.060567,
   111.896553
  ],
  "sil_after": [
   118.297166,
   118.934036
  ],
  "i": 17,
  "text": "Entry level job postings are down 7.5% in a year, while senior postings are up."
 },
 {
  "start": 118.934036,
  "end": 120.467256,
  "sil_before": [
   118.297166,
   118.934036
  ],
  "sil_after": [
   120.467256,
   122.406508
  ],
  "i": 18,
  "text": "14.7%."
 },
 {
  "start": 122.406508,
  "end": 123.850884,
  "sil_before": [
   120.467256,
   122.406508
  ],
  "sil_after": [
   123.850884,
   124.423946
  ],
  "i": 19,
  "text": "Companies are still hiring."
 },
 {
  "start": 124.423946,
  "end": 125.890159,
  "sil_before": [
   123.850884,
   124.423946
  ],
  "sil_after": [
   125.890159,
   136.328005
  ],
  "i": 20,
  "text": "They're not hiring the beginners."
 },
 {
  "start": 136.328005,
  "end": 138.817551,
  "sil_before": [
   125.890159,
   136.328005
  ],
  "sil_after": [
   138.817551,
   140.093197
  ],
  "i": 21,
  "text": "The researchers don't put an all on AI."
 },
 {
  "start": 140.093197,
  "end": 142.634036,
  "sil_before": [
   138.817551,
   140.093197
  ],
  "sil_after": [
   142.634036,
   143.142834
  ],
  "i": 22,
  "text": "But if you're 22 with a brand new degree..."
 },
 {
  "start": 143.142834,
  "end": 144.817188,
  "sil_before": [
   142.634036,
   143.142834
  ],
  "sil_after": [
   144.817188,
   153.052177
  ],
  "i": 23,
  "text": "The reason doesn't change the result."
 },
 {
  "start": 153.052177,
  "end": 155.793356,
  "sil_before": [
   144.817188,
   153.052177
  ],
  "sil_after": [
   155.793356,
   159.022948
  ],
  "i": 24,
  "text": "Now look at what the government itself expects."
 },
 {
  "start": 159.022948,
  "end": 163.087574,
  "sil_before": [
   155.793356,
   159.022948
  ],
  "sil_after": [
   163.087574,
   163.67068
  ],
  "i": 25,
  "text": "The Bureau of Labor Statistics projects that office and administrative support."
 },
 {
  "start": 163.67068,
  "end": 167.727959,
  "sil_before": [
   163.087574,
   163.67068
  ],
  "sil_after": [
   167.727959,
   168.332948
  ],
  "i": 26,
  "text": "will lose 752,000 jobs by 2035."
 },
 {
  "start": 168.332948,
  "end": 169.619229,
  "sil_before": [
   167.727959,
   168.332948
  ],
  "sil_after": [
   169.619229,
   172.005873
  ],
  "i": 27,
  "text": "most of any group."
 },
 {
  "start": 172.005873,
  "end": 173.551905,
  "sil_before": [
   169.619229,
   172.005873
  ],
  "sil_after": [
   173.551905,
   174.21229
  ],
  "i": 28,
  "text": "and it puts the reason in writing."
 },
 {
  "start": 174.21229,
  "end": 177.810431,
  "sil_before": [
   173.551905,
   174.21229
  ],
  "sil_after": [
   177.810431,
   182.226485
  ],
  "i": 29,
  "text": "automation tools, including those powered by AI."
 },
 {
  "start": 182.226485,
  "end": 184.226621,
  "sil_before": [
   177.810431,
   182.226485
  ],
  "sil_after": [
   184.226621,
   184.950907
  ],
  "i": 30,
  "text": "Typus down 34%."
 },
 {
  "start": 184.950907,
  "end": 186.995442,
  "sil_before": [
   184.226621,
   184.950907
  ],
  "sil_after": [
   186.995442,
   187.925057
  ],
  "i": 31,
  "text": "Data entry down 25%."
 },
 {
  "start": 187.925057,
  "end": 188.764898,
  "sil_before": [
   186.995442,
   187.925057
  ],
  "sil_after": [
   188.764898,
   189.077098
  ],
  "i": 32,
  "text": "telemarketers."
 },
 {
  "start": 189.077098,
  "end": 190.182472,
  "sil_before": [
   188.764898,
   189.077098
  ],
  "sil_after": [
   190.182472,
   197.485533
  ],
  "i": 33,
  "text": "down 21%."
 },
 {
  "start": 197.485533,
  "end": 200.227279,
  "sil_before": [
   190.182472,
   197.485533
  ],
  "sil_after": [
   200.227279,
   200.619297
  ],
  "i": 34,
  "text": "That's a forecast, not jobs gone already."
 },
 {
  "start": 200.619297,
  "end": 202.007166,
  "sil_before": [
   200.227279,
   200.619297
  ],
  "sil_after": [
   202.007166,
   205.962608
  ],
  "i": 35,
  "text": "what it is from the government."
 },
 {
  "start": 205.962608,
  "end": 207.659773,
  "sil_before": [
   202.007166,
   205.962608
  ],
  "sil_after": [
   207.659773,
   208.056667
  ],
  "i": 36,
  "text": "Then there's freelance work."
 },
 {
  "start": 208.056667,
  "end": 209.759773,
  "sil_before": [
   207.659773,
   208.056667
  ],
  "sil_after": [
   209.759773,
   211.698821
  ],
  "i": 37,
  "text": "where nobody announces anything."
 },
 {
  "start": 211.698821,
  "end": 213.614354,
  "sil_before": [
   209.759773,
   211.698821
  ],
  "sil_after": [
   213.614354,
   215.693968
  ],
  "i": 38,
  "text": "The jobs just stopped showing up."
 },
 {
  "start": 215.693968,
  "end": 218.678277,
  "sil_before": [
   213.614354,
   215.693968
  ],
  "sil_after": [
   218.678277,
   219.013832
  ],
  "i": 39,
  "text": "A study of more than 3 million freelance job posts."
 },
 {
  "start": 219.013832,
  "end": 221.593129,
  "sil_before": [
   218.678277,
   219.013832
  ],
  "sil_after": [
   221.593129,
   222.055624
  ],
  "i": 40,
  "text": "that in the first year after ChadGPT."
 },
 {
  "start": 222.055624,
  "end": 225.663175,
  "sil_before": [
   221.593129,
   222.055624
  ],
  "sil_after": [
   225.663175,
   232.522177
  ],
  "i": 41,
  "text": "Translation work in Western languages fell 30%."
 },
 {
  "start": 232.522177,
  "end": 235.569002,
  "sil_before": [
   225.663175,
   232.522177
  ],
  "sil_after": [
   235.569002,
   244.368481
  ],
  "i": 42,
  "text": "and one-of-a-kind routine writing fell by 50%."
 },
 {
  "start": 244.368481,
  "end": 246.709977,
  "sil_before": [
   235.569002,
   244.368481
  ],
  "sil_after": [
   246.709977,
   247.174626
  ],
  "i": 43,
  "text": "One of the people you heard at the start is a translator."
 },
 {
  "start": 247.174626,
  "end": 248.579365,
  "sil_before": [
   246.709977,
   247.174626
  ],
  "sil_after": [
   248.579365,
   256.318776
  ],
  "i": 44,
  "text": "And this is how she said it happened."
 },
 {
  "start": 256.318776,
  "end": 259.617664,
  "sil_before": [
   248.579365,
   256.318776
  ],
  "sil_after": [
   259.617664,
   268.684649
  ],
  "i": 45,
  "text": "That's what a 30% drop feels like from the inside."
 },
 {
  "start": 268.684649,
  "end": 269.43034,
  "sil_before": [
   259.617664,
   268.684649
  ],
  "sil_after": [
   269.43034,
   270.023696
  ],
  "i": 46,
  "text": "Here's the thing."
 },
 {
  "start": 270.023696,
  "end": 275.538027,
  "sil_before": [
   269.43034,
   270.023696
  ],
  "sil_after": [
   275.538027,
   280.95059
  ],
  "i": 47,
  "text": "Total Freelance demand went up over that same year. It just moved away from them."
 },
 {
  "start": 280.95059,
  "end": 285.574218,
  "sil_before": [
   275.538027,
   280.95059
  ],
  "sil_after": [
   285.574218,
   288.614512
  ],
  "i": 48,
  "text": "Now we get to the jobs that nobody believes are at risk."
 },
 {
  "start": 288.614512,
  "end": 290.683016,
  "sil_before": [
   285.574218,
   288.614512
  ],
  "sil_after": [
   290.683016,
   291.429977
  ],
  "i": 49,
  "text": "welders, maintenance workers."
 },
 {
  "start": 291.429977,
  "end": 296.242993,
  "sil_before": [
   290.683016,
   291.429977
  ],
  "sil_after": [
   296.242993,
   298.55458
  ],
  "i": 50,
  "text": "People tell me that no robot with a human body will ever do the work as well as a person."
 },
 {
  "start": 298.55458,
  "end": 300.235692,
  "sil_before": [
   296.242993,
   298.55458
  ],
  "sil_after": [
   300.235692,
   302.977098
  ],
  "i": 51,
  "text": "So here's exactly where it stands."
 },
 {
  "start": 302.977098,
  "end": 303.934399,
  "sil_before": [
   300.235692,
   302.977098
  ],
  "sil_after": [
   303.934399,
   304.795714
  ],
  "i": 52,
  "text": "Start with welding."
 },
 {
  "start": 304.795714,
  "end": 306.99161,
  "sil_before": [
   303.934399,
   304.795714
  ],
  "sil_after": [
   306.99161,
   307.356712
  ],
  "i": 53,
  "text": "Robots already weld in production."
 },
 {
  "start": 307.356712,
  "end": 307.988707,
  "sil_before": [
   306.99161,
   307.356712
  ],
  "sil_after": [
   307.988707,
   313.480726
  ],
  "i": 54,
  "text": "every day."
 },
 {
  "start": 313.480726,
  "end": 315.144603,
  "sil_before": [
   307.988707,
   313.480726
  ],
  "sil_after": [
   315.144603,
   316.108912
  ],
  "i": 55,
  "text": "They just don't look like people."
 },
 {
  "start": 316.108912,
  "end": 320.838277,
  "sil_before": [
   315.144603,
   316.108912
  ],
  "sil_after": [
   320.838277,
   323.308095
  ],
  "i": 56,
  "text": "They are arms and smaller collaborative robots called cobots."
 },
 {
  "start": 323.308095,
  "end": 324.928639,
  "sil_before": [
   320.838277,
   323.308095
  ],
  "sil_after": [
   324.928639,
   325.507778
  ],
  "i": 57,
  "text": "one Korean shipbuilder group."
 },
 {
  "start": 325.507778,
  "end": 326.487098,
  "sil_before": [
   324.928639,
   325.507778
  ],
  "sil_after": [
   326.487098,
   326.862449
  ],
  "i": 58,
  "text": "HD Hyundai."
 },
 {
  "start": 326.862449,
  "end": 329.773265,
  "sil_before": [
   326.487098,
   326.862449
  ],
  "sil_after": [
   329.773265,
   331.247868
  ],
  "i": 59,
  "text": "went from 129 of these robots to 211."
 },
 {
  "start": 331.247868,
  "end": 333.016485,
  "sil_before": [
   329.773265,
   331.247868
  ],
  "sil_after": [
   333.016485,
   338.136032
  ],
  "i": 60,
  "text": "Mostly for cutting and welding steel."
 },
 {
  "start": 338.136032,
  "end": 338.565351,
  "sil_before": [
   333.016485,
   338.136032
  ],
  "sil_after": [
   338.565351,
   343.964649
  ],
  "i": 61,
  "text": "Why?"
 },
 {
  "start": 343.964649,
  "end": 346.915986,
  "sil_before": [
   338.565351,
   343.964649
  ],
  "sil_after": [
   346.915986,
   349.199206
  ],
  "i": 62,
  "text": "because the industry just cannot find the people."
 },
 {
  "start": 349.199206,
  "end": 355.786304,
  "sil_before": [
   346.915986,
   349.199206
  ],
  "sil_after": [
   355.786304,
   357.517664
  ],
  "i": 63,
  "text": "The U.S. is projected to need over 320,000 new welding professionals by 2029."
 },
 {
  "start": 357.517664,
  "end": 361.517188,
  "sil_before": [
   355.786304,
   357.517664
  ],
  "sil_after": [
   361.517188,
   368.632404
  ],
  "i": 64,
  "text": "and more than 157,000 are getting close to retirement."
 },
 {
  "start": 368.632404,
  "end": 370.532585,
  "sil_before": [
   361.517188,
   368.632404
  ],
  "sil_after": [
   370.532585,
   370.852358
  ],
  "i": 65,
  "text": "By the way, if you're new here..."
 },
 {
  "start": 370.852358,
  "end": 371.997166,
  "sil_before": [
   370.532585,
   370.852358
  ],
  "sil_after": [
   371.997166,
   372.324943
  ],
  "i": 66,
  "text": "I'm CodeMonkeyMike."
 },
 {
  "start": 372.324943,
  "end": 376.938798,
  "sil_before": [
   371.997166,
   372.324943
  ],
  "sil_after": [
   376.938798,
   377.675125
  ],
  "i": 67,
  "text": "I run a crypto community, build software for my members, create courses and so on."
 },
 {
  "start": 377.675125,
  "end": 383.362698,
  "sil_before": [
   376.938798,
   377.675125
  ],
  "sil_after": [
   383.362698,
   387.709161
  ],
  "i": 68,
  "text": "The goal of my channel is to get people invested into assets before the paychecks run out."
 },
 {
  "start": 387.709161,
  "end": 390.603265,
  "sil_before": [
   383.362698,
   387.709161
  ],
  "sil_after": [
   390.603265,
   390.9461
  ],
  "i": 69,
  "text": "and my calls more than make up for the memberships."
 },
 {
  "start": 390.9461,
  "end": 391.680113,
  "sil_before": [
   390.603265,
   390.9461
  ],
  "sil_after": [
   391.680113,
   392.183605
  ],
  "i": 70,
  "text": "For example,"
 },
 {
  "start": 392.183605,
  "end": 395.527075,
  "sil_before": [
   391.680113,
   392.183605
  ],
  "sil_after": [
   395.527075,
   398.054195
  ],
  "i": 71,
  "text": "Three weeks ago, I called a new AI crypto called Jankson."
 },
 {
  "start": 398.054195,
  "end": 400.464308,
  "sil_before": [
   395.527075,
   398.054195
  ],
  "sil_after": [
   400.464308,
   401.746825
  ],
  "i": 72,
  "text": "and it shot up 6x a few days ago."
 },
 {
  "start": 401.746825,
  "end": 407.258209,
  "sil_before": [
   400.464308,
   401.746825
  ],
  "sil_after": [
   407.258209,
   408.79907
  ],
  "i": 73,
  "text": "Just a simple $300 investment would have more than paid for my community's lifetime membership."
 },
 {
  "start": 408.79907,
  "end": 410.189342,
  "sil_before": [
   407.258209,
   408.79907
  ],
  "sil_after": [
   410.189342,
   410.822154
  ],
  "i": 74,
  "text": "Click the link in the description."
 },
 {
  "start": 410.822154,
  "end": 411.76034,
  "sil_before": [
   410.189342,
   410.822154
  ],
  "sil_after": [
   411.76034,
   412.73483
  ],
  "i": 75,
  "text": "if you're interested."
 },
 {
  "start": 412.73483,
  "end": 413.978481,
  "sil_before": [
   411.76034,
   412.73483
  ],
  "sil_after": [
   413.978481,
   418.736599
  ],
  "i": 76,
  "text": "Now let's get back to the data."
 },
 {
  "start": 418.736599,
  "end": 421.389184,
  "sil_before": [
   413.978481,
   418.736599
  ],
  "sil_after": [
   421.389184,
   423.066032
  ],
  "i": 77,
  "text": "So next, the robot with the human body."
 },
 {
  "start": 423.066032,
  "end": 427.248776,
  "sil_before": [
   421.389184,
   423.066032
  ],
  "sil_after": [
   427.248776,
   427.875941
  ],
  "i": 78,
  "text": "A figure humanoid loaded sheet metal at a BMW plant for 11 months."
 },
 {
  "start": 427.875941,
  "end": 429.492925,
  "sil_before": [
   427.248776,
   427.875941
  ],
  "sil_after": [
   429.492925,
   431.288209
  ],
  "i": 79,
  "text": "and BMW called it a pilot."
 },
 {
  "start": 431.288209,
  "end": 436.278345,
  "sil_before": [
   429.492925,
   431.288209
  ],
  "sil_after": [
   436.278345,
   445.765102
  ],
  "i": 80,
  "text": "Another one called Digit has moved more than 100,000 totes in a working warehouse."
 },
 {
  "start": 445.765102,
  "end": 450.591791,
  "sil_before": [
   436.278345,
   445.765102
  ],
  "sil_after": [
   450.591791,
   457.405578
  ],
  "i": 81,
  "text": "And that company's CEO says that humanoids are a couple years away from paying for themselves."
 },
 {
  "start": 457.405578,
  "end": 458.721179,
  "sil_before": [
   450.591791,
   457.405578
  ],
  "sil_after": [
   458.721179,
   459.394286
  ],
  "i": 82,
  "text": "and a humanoid welder?"
 },
 {
  "start": 459.394286,
  "end": 460.159456,
  "sil_before": [
   458.721179,
   459.394286
  ],
  "sil_after": [
   460.159456,
   460.590499
  ],
  "i": 83,
  "text": "it exists."
 },
 {
  "start": 460.590499,
  "end": 463.276168,
  "sil_before": [
   460.159456,
   460.590499
  ],
  "sil_after": [
   463.276168,
   466.987528
  ],
  "i": 84,
  "text": "Persona AI is building one with HD Hyundai."
 },
 {
  "start": 466.987528,
  "end": 469.339002,
  "sil_before": [
   463.276168,
   466.987528
  ],
  "sil_after": [
   469.339002,
   469.703832
  ],
  "i": 85,
  "text": "And right now, it's learning to weld."
 },
 {
  "start": 469.703832,
  "end": 472.498866,
  "sil_before": [
   469.339002,
   469.703832
  ],
  "sil_after": [
   472.498866,
   477.104921
  ],
  "i": 86,
  "text": "in straight lines at around one centimeter per second."
 },
 {
  "start": 477.104921,
  "end": 479.607778,
  "sil_before": [
   472.498866,
   477.104921
  ],
  "sil_after": [
   479.607778,
   483.748617
  ],
  "i": 87,
  "text": "Mule tests are planned for 2027."
 },
 {
  "start": 483.748617,
  "end": 488.960522,
  "sil_before": [
   479.607778,
   483.748617
  ],
  "sil_after": [
   488.960522,
   494.463447
  ],
  "i": 88,
  "text": "So no, a humanoid robot is not welding in a shipyard today."
 },
 {
  "start": 494.463447,
  "end": 501.263424,
  "sil_before": [
   488.960522,
   494.463447
  ],
  "sil_after": [
   501.263424,
   502.912766
  ],
  "i": 89,
  "text": "but the arms already are. The humanoid is in training, and the industry just cannot hire welders fast enough."
 },
 {
  "start": 502.912766,
  "end": 504.205692,
  "sil_before": [
   501.263424,
   502.912766
  ],
  "sil_after": [
   504.205692,
   504.561224
  ],
  "i": 90,
  "text": "So it's early."
 },
 {
  "start": 504.561224,
  "end": 505.98771,
  "sil_before": [
   504.205692,
   504.561224
  ],
  "sil_after": [
   505.98771,
   508.552698
  ],
  "i": 91,
  "text": "but it has started."
 },
 {
  "start": 508.552698,
  "end": 509.868934,
  "sil_before": [
   505.98771,
   508.552698
  ],
  "sil_after": [
   509.868934,
   511.795215
  ],
  "i": 92,
  "text": "Now the maintenance worker."
 },
 {
  "start": 511.795215,
  "end": 512.63619,
  "sil_before": [
   509.868934,
   511.795215
  ],
  "sil_after": [
   512.63619,
   512.962086
  ],
  "i": 93,
  "text": "In the US."
 },
 {
  "start": 512.962086,
  "end": 515.5039,
  "sil_before": [
   512.63619,
   512.962086
  ],
  "sil_after": [
   515.5039,
   520.592245
  ],
  "i": 94,
  "text": "Around 1.6 million people do this job."
 },
 {
  "start": 520.592245,
  "end": 523.054331,
  "sil_before": [
   515.5039,
   520.592245
  ],
  "sil_after": [
   523.054331,
   524.986327
  ],
  "i": 95,
  "text": "And look at how the government itself describes the job."
 },
 {
  "start": 524.986327,
  "end": 531.300272,
  "sil_before": [
   523.054331,
   524.986327
  ],
  "sil_after": [
   531.300272,
   534.305102
  ],
  "i": 96,
  "text": "Fix or replace faulty switches, outlets, or circuit breakers. Figure out what went wrong. Order the parts."
 },
 {
  "start": 534.305102,
  "end": 536.693764,
  "sil_before": [
   531.300272,
   534.305102
  ],
  "sil_after": [
   536.693764,
   537.00517
  ],
  "i": 97,
  "text": "A maintenance worker doesn't do just one task."
 },
 {
  "start": 537.00517,
  "end": 538.569025,
  "sil_before": [
   536.693764,
   537.00517
  ],
  "sil_after": [
   538.569025,
   540.803016
  ],
  "i": 98,
  "text": "They do whatever broke that day."
 },
 {
  "start": 540.803016,
  "end": 543.607778,
  "sil_before": [
   538.569025,
   540.803016
  ],
  "sil_after": [
   543.607778,
   547.820703
  ],
  "i": 99,
  "text": "And a humanoid robot isn't built for one task either."
 },
 {
  "start": 547.820703,
  "end": 548.654535,
  "sil_before": [
   543.607778,
   547.820703
  ],
  "sil_after": [
   548.654535,
   549.20585
  ],
  "i": 100,
  "text": "in my video."
 },
 {
  "start": 549.20585,
  "end": 550.81102,
  "sil_before": [
   548.654535,
   549.20585
  ],
  "sil_after": [
   550.81102,
   551.422517
  ],
  "i": 101,
  "text": "Literally every job is at risk."
 },
 {
  "start": 551.422517,
  "end": 554.525057,
  "sil_before": [
   550.81102,
   551.422517
  ],
  "sil_after": [
   554.525057,
   556.128503
  ],
  "i": 102,
  "text": "I said that one day these robots work inside your house."
 },
 {
  "start": 556.128503,
  "end": 557.561066,
  "sil_before": [
   554.525057,
   556.128503
  ],
  "sil_after": [
   557.561066,
   558.17381
  ],
  "i": 103,
  "text": "You don't need to call a plumber."
 },
 {
  "start": 558.17381,
  "end": 559.642109,
  "sil_before": [
   557.561066,
   558.17381
  ],
  "sil_after": [
   559.642109,
   560.245986
  ],
  "i": 104,
  "text": "You don't need to call an electrician."
 },
 {
  "start": 560.245986,
  "end": 561.34678,
  "sil_before": [
   559.642109,
   560.245986
  ],
  "sil_after": [
   561.34678,
   562.32229
  ],
  "i": 105,
  "text": "You don't need to call a roofer."
 },
 {
  "start": 562.32229,
  "end": 564.478707,
  "sil_before": [
   561.34678,
   562.32229
  ],
  "sil_after": [
   564.478707,
   565.201179
  ],
  "i": 106,
  "text": "A humanoid electrician needs an apprenticeship."
 },
 {
  "start": 565.201179,
  "end": 566.859751,
  "sil_before": [
   564.478707,
   565.201179
  ],
  "sil_after": [
   566.859751,
   575.429501
  ],
  "i": 107,
  "text": "A robot needs a download."
 },
 {
  "start": 575.429501,
  "end": 577.712358,
  "sil_before": [
   566.859751,
   575.429501
  ],
  "sil_after": [
   577.712358,
   578.827415
  ],
  "i": 108,
  "text": "And that's how these robots are already being taught."
 },
 {
  "start": 578.827415,
  "end": 580.618934,
  "sil_before": [
   577.712358,
   578.827415
  ],
  "sil_after": [
   580.618934,
   581.024739
  ],
  "i": 109,
  "text": "CrossFit Dynamics and Toyota."
 },
 {
  "start": 581.024739,
  "end": 583.894535,
  "sil_before": [
   580.618934,
   581.024739
  ],
  "sil_after": [
   583.894535,
   589.914966
  ],
  "i": 110,
  "text": "Teach their Atlas humanoid new skills by showing it."
 },
 {
  "start": 589.914966,
  "end": 593.905714,
  "sil_before": [
   583.894535,
   589.914966
  ],
  "sil_after": [
   593.905714,
   594.607687
  ],
  "i": 111,
  "text": "And they say it needs fewer and fewer demonstrations each time."
 },
 {
  "start": 594.607687,
  "end": 595.246485,
  "sil_before": [
   593.905714,
   594.607687
  ],
  "sil_after": [
   595.246485,
   595.768662
  ],
  "i": 112,
  "text": "For now."
 },
 {
  "start": 595.768662,
  "end": 596.824059,
  "sil_before": [
   595.246485,
   595.768662
  ],
  "sil_after": [
   596.824059,
   597.529388
  ],
  "i": 113,
  "text": "That's in the lab."
 },
 {
  "start": 597.529388,
  "end": 599.461587,
  "sil_before": [
   596.824059,
   597.529388
  ],
  "sil_after": [
   599.461587,
   604.185828
  ],
  "i": 114,
  "text": "on tasks like packing and sorting."
 },
 {
  "start": 604.185828,
  "end": 606.249002,
  "sil_before": [
   599.461587,
   604.185828
  ],
  "sil_after": [
   606.249002,
   607.866735
  ],
  "i": 115,
  "text": "The ordering part already exists too."
 },
 {
  "start": 607.866735,
  "end": 610.891519,
  "sil_before": [
   606.249002,
   607.866735
  ],
  "sil_after": [
   610.891519,
   611.498798
  ],
  "i": 116,
  "text": "Amazon has an AI that completes the purchase for you."
 },
 {
  "start": 611.498798,
  "end": 612.643016,
  "sil_before": [
   610.891519,
   611.498798
  ],
  "sil_after": [
   612.643016,
   614.177302
  ],
  "i": 117,
  "text": "You just press confirm."
 },
 {
  "start": 614.177302,
  "end": 614.814308,
  "sil_before": [
   612.643016,
   614.177302
  ],
  "sil_after": [
   614.814308,
   615.510975
  ],
  "i": 118,
  "text": "So picture it."
 },
 {
  "start": 615.510975,
  "end": 617.322698,
  "sil_before": [
   614.814308,
   615.510975
  ],
  "sil_after": [
   617.322698,
   618.582812
  ],
  "i": 119,
  "text": "An outlet in your house stops working."
 },
 {
  "start": 618.582812,
  "end": 625.215873,
  "sil_before": [
   617.322698,
   618.582812
  ],
  "sil_after": [
   625.215873,
   627.559025
  ],
  "i": 120,
  "text": "The robot already in your house lowers the skill of an expert electrician, orders the wire and the parts it needs, and does the repair."
 },
 {
  "start": 627.559025,
  "end": 631.281247,
  "sil_before": [
   625.215873,
   627.559025
  ],
  "sil_after": [
   631.281247,
   648.335057
  ],
  "i": 121,
  "text": "A leak in your roof. Same thing. It goes up the ladder and fixes it."
 },
 {
  "start": 648.335057,
  "end": 651.677347,
  "sil_before": [
   631.281247,
   648.335057
  ],
  "sil_after": [
   651.677347,
   657.911474
  ],
  "i": 122,
  "text": "Can it do that today in 2026? No."
 },
 {
  "start": 657.911474,
  "end": 660.603424,
  "sil_before": [
   651.677347,
   657.911474
  ],
  "sil_after": [
   660.603424,
   661.343129
  ],
  "i": 123,
  "text": "Nobody's put those pieces together inside a house yet."
 },
 {
  "start": 661.343129,
  "end": 663.924694,
  "sil_before": [
   660.603424,
   661.343129
  ],
  "sil_after": [
   663.924694,
   664.384807
  ],
  "i": 124,
  "text": "But my prediction is that by 2029."
 },
 {
  "start": 664.384807,
  "end": 664.844082,
  "sil_before": [
   663.924694,
   664.384807
  ],
  "sil_after": [
   664.844082,
   666.526032
  ],
  "i": 125,
  "text": "It will."
 },
 {
  "start": 666.526032,
  "end": 668.727891,
  "sil_before": [
   664.844082,
   666.526032
  ],
  "sil_after": [
   668.727891,
   669.709342
  ],
  "i": 126,
  "text": "And Elon Musk goes even further than that."
 },
 {
  "start": 669.709342,
  "end": 672.274036,
  "sil_before": [
   668.727891,
   669.709342
  ],
  "sil_after": [
   672.274036,
   699.436395
  ],
  "i": 127,
  "text": "This is what he said at a G20 meeting this September."
 },
 {
  "start": 699.436395,
  "end": 702.190363,
  "sil_before": [
   672.274036,
   699.436395
  ],
  "sil_after": [
   702.190363,
   702.51966
  ],
  "i": 128,
  "text": "A robot doesn't need to be a better electrician than you."
 },
 {
  "start": 702.51966,
  "end": 704.866621,
  "sil_before": [
   702.190363,
   702.51966
  ],
  "sil_after": [
   704.866621,
   705.387347
  ],
  "i": 129,
  "text": "It just needs to be already in the house."
 },
 {
  "start": 705.387347,
  "end": 707.313401,
  "sil_before": [
   704.866621,
   705.387347
  ],
  "sil_after": [
   707.313401,
   722.673719
  ],
  "i": 130,
  "text": "Receive an expert electrician download."
 },
 {
  "start": 722.673719,
  "end": 723.883537,
  "sil_before": [
   707.313401,
   722.673719
  ],
  "sil_after": [
   723.883537,
   724.300544
  ],
  "i": 131,
  "text": "The problem here is that..."
 },
 {
  "start": 724.300544,
  "end": 725.925147,
  "sil_before": [
   723.883537,
   724.300544
  ],
  "sil_after": [
   725.925147,
   741.472358
  ],
  "i": 132,
  "text": "Just not in the house yet"
 },
 {
  "start": 741.472358,
  "end": 745.428322,
  "sil_before": [
   725.925147,
   741.472358
  ],
  "sil_after": [
   745.428322,
   749.955918
  ],
  "i": 133,
  "text": "And yet, people ask about their own job, and most of them are not even worried."
 },
 {
  "start": 749.955918,
  "end": 754.672177,
  "sil_before": [
   745.428322,
   749.955918
  ],
  "sil_after": [
   754.672177,
   755.81619
  ],
  "i": 134,
  "text": "In one poll in March, 70% of Americans said AI will cut jobs."
 },
 {
  "start": 755.81619,
  "end": 759.366939,
  "sil_before": [
   754.672177,
   755.81619
  ],
  "sil_after": [
   759.366939,
   762.294059
  ],
  "i": 135,
  "text": "But only 30% of these people with a job were worried about their own."
 },
 {
  "start": 762.294059,
  "end": 764.089932,
  "sil_before": [
   759.366939,
   762.294059
  ],
  "sil_after": [
   764.089932,
   770.640726
  ],
  "i": 136,
  "text": "Blue collar workers show it the most."
 },
 {
  "start": 770.640726,
  "end": 773.565374,
  "sil_before": [
   764.089932,
   770.640726
  ],
  "sil_after": [
   773.565374,
   777.409955
  ],
  "i": 137,
  "text": "Around three in four expect AI to cut jobs."
 },
 {
  "start": 777.409955,
  "end": 779.506576,
  "sil_before": [
   773.565374,
   777.409955
  ],
  "sil_after": [
   779.506576,
   789.883492
  ],
  "i": 138,
  "text": "and three and four are not worried about theirs."
 },
 {
  "start": 789.883492,
  "end": 790.895125,
  "sil_before": [
   779.506576,
   789.883492
  ],
  "sil_after": [
   790.895125,
   797.582608
  ],
  "i": 139,
  "text": "Here's what it sounds like."
 },
 {
  "start": 797.582608,
  "end": 798.882857,
  "sil_before": [
   790.895125,
   797.582608
  ],
  "sil_after": [
   798.882857,
   799.364671
  ],
  "i": 140,
  "text": "I get why people say it."
 },
 {
  "start": 799.364671,
  "end": 803.616848,
  "sil_before": [
   798.882857,
   799.364671
  ],
  "sil_after": [
   803.616848,
   805.226757
  ],
  "i": 141,
  "text": "Nobody wants to believe that the thing they spent years getting good at can be done by a machine."
 },
 {
  "start": 805.226757,
  "end": 806.315556,
  "sil_before": [
   803.616848,
   805.226757
  ],
  "sil_after": [
   806.315556,
   807.903696
  ],
  "i": 142,
  "text": "And notice the pattern."
 },
 {
  "start": 807.903696,
  "end": 810.859048,
  "sil_before": [
   806.315556,
   807.903696
  ],
  "sil_after": [
   810.859048,
   812.026236
  ],
  "i": 143,
  "text": "Almost everyone expects this to happen to somebody else."
 },
 {
  "start": 812.026236,
  "end": 814.303923,
  "sil_before": [
   810.859048,
   812.026236
  ],
  "sil_after": [
   814.303923,
   817.860862
  ],
  "i": 144,
  "text": "Listen to how this woman in a trade program puts it."
 },
 {
  "start": 817.860862,
  "end": 819.866735,
  "sil_before": [
   814.303923,
   817.860862
  ],
  "sil_after": [
   819.866735,
   820.393152
  ],
  "i": 145,
  "text": "A study in Germany measured that gap."
 },
 {
  "start": 820.393152,
  "end": 825.212358,
  "sil_before": [
   819.866735,
   820.393152
  ],
  "sil_after": [
   825.212358,
   825.811905
  ],
  "i": 146,
  "text": "Workers in the jobs most exposed to automation guess that about 30% of their work"
 },
 {
  "start": 825.811905,
  "end": 826.992018,
  "sil_before": [
   825.212358,
   825.811905
  ],
  "sil_after": [
   826.992018,
   829.076213
  ],
  "i": 147,
  "text": "be done by a machine."
 },
 {
  "start": 829.076213,
  "end": 830.73712,
  "sil_before": [
   826.992018,
   829.076213
  ],
  "sil_after": [
   830.73712,
   836.869683
  ],
  "i": 148,
  "text": "The measured figure was 75."
 },
 {
  "start": 836.869683,
  "end": 841.117528,
  "sil_before": [
   830.73712,
   836.869683
  ],
  "sil_after": [
   841.117528,
   842.870249
  ],
  "i": 149,
  "text": "And the translator you heard at the start of this video had more than 15 years in her job."
 },
 {
  "start": 842.870249,
  "end": 844.892857,
  "sil_before": [
   841.117528,
   842.870249
  ],
  "sil_after": [
   844.892857,
   848.88712
  ],
  "i": 150,
  "text": "She says AI took her livelihood."
 },
 {
  "start": 848.88712,
  "end": 851.582766,
  "sil_before": [
   844.892857,
   848.88712
  ],
  "sil_after": [
   851.582766,
   852.031451
  ],
  "i": 151,
  "text": "Feeling safe isn't the same thing as being safe."
 },
 {
  "start": 852.031451,
  "end": 852.801746,
  "sil_before": [
   851.582766,
   852.031451
  ],
  "sil_after": [
   852.801746,
   859.827687
  ],
  "i": 152,
  "text": "Unfortunately."
 },
 {
  "start": 859.827687,
  "end": 861.377007,
  "sil_before": [
   852.801746,
   859.827687
  ],
  "sil_after": [
   861.377007,
   862.456259
  ],
  "i": 153,
  "text": "So what does this mean for you?"
 },
 {
  "start": 862.456259,
  "end": 864.114082,
  "sil_before": [
   861.377007,
   862.456259
  ],
  "sil_after": [
   864.114082,
   864.783537
  ],
  "i": 154,
  "text": "The damage so far is quiet."
 },
 {
  "start": 864.783537,
  "end": 871.861429,
  "sil_before": [
   864.114082,
   864.783537
  ],
  "sil_after": [
   871.861429,
   884.935986
  ],
  "i": 155,
  "text": "The entry-level job that never gets posted, the freelance work that stops coming, the office job already expected to shrink."
 },
 {
  "start": 884.935986,
  "end": 888.834966,
  "sil_before": [
   871.861429,
   884.935986
  ],
  "sil_after": [
   888.834966,
   907.435601
  ],
  "i": 156,
  "text": "Don't wait for a layoff announcement to tell you that your job has changed."
 },
 {
  "start": 907.435601,
  "end": 912.006032,
  "sil_before": [
   888.834966,
   907.435601
  ],
  "sil_after": [
   912.006032,
   915.624943
  ],
  "i": 157,
  "text": "I made two videos over the last couple of weeks on which jobs are next and how to protect yourself."
 },
 {
  "start": 915.624943,
  "end": 918.363175,
  "sil_before": [
   912.006032,
   915.624943
  ],
  "sil_after": [
   918.363175,
   919.225283
  ],
  "i": 158,
  "text": "This one right here called literally every job is at risk."
 },
 {
  "start": 919.225283,
  "end": 921.8022,
  "sil_before": [
   918.363175,
   919.225283
  ],
  "sil_after": [
   921.8022,
   922.333651
  ],
  "i": 159,
  "text": "And then this one, AI will wipe out these jobs next."
 },
 {
  "start": 922.333651,
  "end": 923.338163,
  "sil_before": [
   921.8022,
   922.333651
  ],
  "sil_after": [
   923.338163,
   928.220612
