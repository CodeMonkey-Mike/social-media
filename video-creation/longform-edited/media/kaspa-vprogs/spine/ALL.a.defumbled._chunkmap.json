  ],
  "sil_after": [
   5.701746,
   11.548367
  ],
  "i": 0,
  "text": "Casper is building Vprogs, verifiable programs."
 },
 {
  "start": 11.548367,
  "end": 12.272313,
  "sil_before": [
   5.701746,
   11.548367
  ],
  "sil_after": [
   12.272313,
   12.597392
  ],
  "i": 1,
  "text": "Real apps."
 },
 {
  "start": 12.597392,
  "end": 13.605692,
  "sil_before": [
   12.272313,
   12.597392
  ],
  "sil_after": [
   13.605692,
   14.351837
  ],
  "i": 2,
  "text": "on a base layer."
 },
 {
  "start": 14.351837,
  "end": 15.386825,
  "sil_before": [
   13.605692,
   14.351837
  ],
  "sil_after": [
   15.386825,
   15.846032
  ],
  "i": 3,
  "text": "on a proof of work."
 },
 {
  "start": 15.846032,
  "end": 16.773084,
  "sil_before": [
   15.386825,
   15.846032
  ],
  "sil_after": [
   16.773084,
   20.323719
  ],
  "i": 4,
  "text": "Not an L2."
 },
 {
  "start": 20.323719,
  "end": 23.040658,
  "sil_before": [
   16.773084,
   20.323719
  ],
  "sil_after": [
   23.040658,
   24.794308
  ],
  "i": 5,
  "text": "A Vprog is an app that runs on its own node."
 },
 {
  "start": 24.794308,
  "end": 25.879637,
  "sil_before": [
   23.040658,
   24.794308
  ],
  "sil_after": [
   25.879637,
   26.75483
  ],
  "i": 6,
  "text": "keeps its own state."
 },
 {
  "start": 26.75483,
  "end": 29.949592,
  "sil_before": [
   25.879637,
   26.75483
  ],
  "sil_after": [
   29.949592,
   32.952018
  ],
  "i": 7,
  "text": "and post zero-knowledge proof of that state back to Casper."
 },
 {
  "start": 32.952018,
  "end": 35.638549,
  "sil_before": [
   29.949592,
   32.952018
  ],
  "sil_after": [
   35.638549,
   36.646168
  ],
  "i": 8,
  "text": "Now Casper already has smart contracts."
 },
 {
  "start": 36.646168,
  "end": 39.244172,
  "sil_before": [
   35.638549,
   36.646168
  ],
  "sil_after": [
   39.244172,
   39.742517
  ],
  "i": 9,
  "text": "Covenants live on mainnet since June"
 },
 {
  "start": 39.742517,
  "end": 41.099524,
  "sil_before": [
   39.244172,
   39.742517
  ],
  "sil_after": [
   41.099524,
   44.171474
  ],
  "i": 10,
  "text": "straight from the core devs."
 },
 {
  "start": 44.171474,
  "end": 46.239274,
  "sil_before": [
   41.099524,
   44.171474
  ],
  "sil_after": [
   46.239274,
   48.580726
  ],
  "i": 11,
  "text": "Vprogs are the next layer up."
 },
 {
  "start": 48.580726,
  "end": 49.853719,
  "sil_before": [
   46.239274,
   48.580726
  ],
  "sil_after": [
   49.853719,
   50.200385
  ],
  "i": 12,
  "text": "whole applications."
 },
 {
  "start": 50.200385,
  "end": 53.90229,
  "sil_before": [
   49.853719,
   50.200385
  ],
  "sil_after": [
   53.90229,
   65.416621
  ],
  "i": 13,
  "text": "on a chain that already runs 10 blocks every single second."
 },
 {
  "start": 65.416621,
  "end": 67.623129,
  "sil_before": [
   53.90229,
   65.416621
  ],
  "sil_after": [
   67.623129,
   68.052336
  ],
  "i": 14,
  "text": "Casper is never gonna run your app."
 },
 {
  "start": 68.052336,
  "end": 69.497551,
  "sil_before": [
   67.623129,
   68.052336
  ],
  "sil_after": [
   69.497551,
   73.400272
  ],
  "i": 15,
  "text": "Casper's going to verify it."
 },
 {
  "start": 73.400272,
  "end": 76.835125,
  "sil_before": [
   69.497551,
   73.400272
  ],
  "sil_after": [
   76.835125,
   77.215102
  ],
  "i": 16,
  "text": "And that one flip is how you get apps on the base layer."
 },
 {
  "start": 77.215102,
  "end": 78.564694,
  "sil_before": [
   76.835125,
   77.215102
  ],
  "sil_after": [
   78.564694,
   79.064195
  ],
  "i": 17,
  "text": "with Proof of Work Security."
 },
 {
  "start": 79.064195,
  "end": 80.253401,
  "sil_before": [
   78.564694,
   79.064195
  ],
  "sil_after": [
   80.253401,
   88.54356
  ],
  "i": 18,
  "text": "and no L2 in the middle."
 },
 {
  "start": 88.54356,
  "end": 89.947007,
  "sil_before": [
   80.253401,
   88.54356
  ],
  "sil_after": [
   89.947007,
   104.509955
  ],
  "i": 19,
  "text": "So let's break this all down."
 },
 {
  "start": 104.509955,
  "end": 105.703878,
  "sil_before": [
   89.947007,
   104.509955
  ],
  "sil_after": [
   105.703878,
   106.130159
  ],
  "i": 20,
  "text": "So back in 2020."
 },
 {
  "start": 106.130159,
  "end": 108.141406,
  "sil_before": [
   105.703878,
   106.130159
  ],
  "sil_after": [
   108.141406,
   108.811633
  ],
  "i": 21,
  "text": "Vitalik laid out Ethereum's plan."
 },
 {
  "start": 108.811633,
  "end": 110.198027,
  "sil_before": [
   108.141406,
   108.811633
  ],
  "sil_after": [
   110.198027,
   110.91805
  ],
  "i": 22,
  "text": "And it said in plain English."
 },
 {
  "start": 110.91805,
  "end": 115.591361,
  "sil_before": [
   110.198027,
   110.91805
  ],
  "sil_after": [
   115.591361,
   116.084331
  ],
  "i": 23,
  "text": "All in on roll ups, your accounts, your businesses, your assets."
 },
 {
  "start": 116.084331,
  "end": 117.540499,
  "sil_before": [
   115.591361,
   116.084331
  ],
  "sil_after": [
   117.540499,
   118.10034
  ],
  "i": 24,
  "text": "living inside a layer 2."
 },
 {
  "start": 122.365283,
  "end": 124.543764,
  "sil_before": [
   118.295329,
   122.365283
  ],
  "sil_after": [
   124.543764,
   124.925374
  ],
  "i": 25,
  "text": "And every roll up is its own chain."
 },
 {
  "start": 124.925374,
  "end": 128.497075,
  "sil_before": [
   124.543764,
   124.925374
  ],
  "sil_after": [
   128.497075,
   130.631791
  ],
  "i": 26,
  "text": "its own sequencer, the machine that orders your transactions."
 },
 {
  "start": 130.631791,
  "end": 131.691769,
  "sil_before": [
   128.497075,
   130.631791
  ],
  "sil_after": [
   131.691769,
   132.321678
  ],
  "i": 27,
  "text": "its own bridge."
 },
 {
  "start": 132.321678,
  "end": 133.92746,
  "sil_before": [
   131.691769,
   132.321678
  ],
  "sil_after": [
   133.92746,
   144.869184
  ],
  "i": 28,
  "text": "its own slice of liquidity."
 },
 {
  "start": 144.869184,
  "end": 146.5139,
  "sil_before": [
   133.92746,
   144.869184
  ],
  "sil_after": [
   146.5139,
   147.08576
  ],
  "i": 29,
  "text": "and every one of those pieces."
 },
 {
  "start": 147.08576,
  "end": 149.147937,
  "sil_before": [
   146.5139,
   147.08576
  ],
  "sil_after": [
   149.147937,
   151.522562
  ],
  "i": 30,
  "text": "is a place for something to break."
 },
 {
  "start": 151.522562,
  "end": 153.124943,
  "sil_before": [
   149.147937,
   151.522562
  ],
  "sil_after": [
   153.124943,
   153.541156
  ],
  "i": 31,
  "text": "and a place for your liquidity."
 },
 {
  "start": 153.541156,
  "end": 154.267029,
  "sil_before": [
   153.124943,
   153.541156
  ],
  "sil_after": [
   154.267029,
   157.486667
  ],
  "i": 32,
  "text": "get split up."
 },
 {
  "start": 157.486667,
  "end": 158.703787,
  "sil_before": [
   154.267029,
   157.486667
  ],
  "sil_after": [
   158.703787,
   159.216712
  ],
  "i": 33,
  "text": "Now Casper's founder."
 },
 {
  "start": 159.216712,
  "end": 160.570839,
  "sil_before": [
   158.703787,
   159.216712
  ],
  "sil_after": [
   160.570839,
   161.21127
  ],
  "i": 34,
  "text": "Jan Tamson-Polinski"
 },
 {
  "start": 161.21127,
  "end": 162.069365,
  "sil_before": [
   160.570839,
   161.21127
  ],
  "sil_after": [
   162.069365,
   172.497596
  ],
  "i": 35,
  "text": "Licked out all of that."
 },
 {
  "start": 172.497596,
  "end": 179.516803,
  "sil_before": [
   162.069365,
   172.497596
  ],
  "sil_after": [
   179.516803,
   180.180635
  ],
  "i": 36,
  "text": "And back in December, he said the whole point of Vprogs was to avoid the obsolete path of L2s."
 },
 {
  "start": 180.180635,
  "end": 181.485147,
  "sil_before": [
   179.516803,
   180.180635
  ],
  "sil_after": [
   181.485147,
   189.891315
  ],
  "i": 37,
  "text": "His words, not mine."
 },
 {
  "start": 189.891315,
  "end": 191.496032,
  "sil_before": [
   181.485147,
   189.891315
  ],
  "sil_after": [
   191.496032,
   192.922381
  ],
  "i": 38,
  "text": "and he hasn't softened on it."
 },
 {
  "start": 194.844263,
  "end": 195.714014,
  "sil_before": [
   193.15381,
   194.844263
  ],
  "sil_after": [
   195.714014,
   196.824739
  ],
  "i": 39,
  "text": "This August."
 },
 {
  "start": 196.824739,
  "end": 198.876485,
  "sil_before": [
   195.714014,
   196.824739
  ],
  "sil_after": [
   198.876485,
   199.964172
  ],
  "i": 40,
  "text": "on the Bitcoin Takeover Podcast."
 },
 {
  "start": 199.964172,
  "end": 201.723673,
  "sil_before": [
   198.876485,
   199.964172
  ],
  "sil_after": [
   201.723673,
   202.048345
  ],
  "i": 41,
  "text": "He said as plainly as you can."
 },
 {
  "start": 202.048345,
  "end": 202.733061,
  "sil_before": [
   201.723673,
   202.048345
  ],
  "sil_after": [
   202.733061,
   203.24356
  ],
  "i": 42,
  "text": "for the record."
 },
 {
  "start": 203.24356,
  "end": 205.366553,
  "sil_before": [
   202.733061,
   203.24356
  ],
  "sil_after": [
   205.366553,
   213.550862
  ],
  "i": 43,
  "text": "I'm very bullish on roll ups."
 },
 {
  "start": 213.550862,
  "end": 215.90093,
  "sil_before": [
   205.366553,
   213.550862
  ],
  "sil_after": [
   215.90093,
   219.359365
  ],
  "i": 44,
  "text": "So here's how a Vprog actually works."
 },
 {
  "start": 219.359365,
  "end": 223.12737,
  "sil_before": [
   215.90093,
   219.359365
  ],
  "sil_after": [
   223.12737,
   224.078866
  ],
  "i": 45,
  "text": "You send a transaction and you declare upfront which account it reads."
 },
 {
  "start": 224.078866,
  "end": 225.268186,
  "sil_before": [
   223.12737,
   224.078866
  ],
  "sil_after": [
   225.268186,
   236.655329
  ],
  "i": 46,
  "text": "and which one it writes."
 },
 {
  "start": 236.655329,
  "end": 238.37517,
  "sil_before": [
   225.268186,
   236.655329
  ],
  "sil_after": [
   238.37517,
   239.404989
  ],
  "i": 47,
  "text": "Casper does four jobs."
 },
 {
  "start": 239.404989,
  "end": 240.930726,
  "sil_before": [
   238.37517,
   239.404989
  ],
  "sil_after": [
   240.930726,
   241.70746
  ],
  "i": 48,
  "text": "It orders every transaction."
 },
 {
  "start": 241.70746,
  "end": 243.744376,
  "sil_before": [
   240.930726,
   241.70746
  ],
  "sil_after": [
   243.744376,
   248.61907
  ],
  "i": 49,
  "text": "So Casper itself is a sequencer."
 },
 {
  "start": 248.61907,
  "end": 249.698277,
  "sil_before": [
   243.744376,
   248.61907
  ],
  "sil_after": [
   249.698277,
   250.084626
  ],
  "i": 50,
  "text": "It stores the data."
 },
 {
  "start": 250.084626,
  "end": 251.286032,
  "sil_before": [
   249.698277,
   250.084626
  ],
  "sil_after": [
   251.286032,
   257.597687
  ],
  "i": 51,
  "text": "It checks the proofs."
 },
 {
  "start": 257.597687,
  "end": 258.531247,
  "sil_before": [
   251.286032,
   257.597687
  ],
  "sil_after": [
   258.531247,
   263.306667
  ],
  "i": 52,
  "text": "meters that work."
 },
 {
  "start": 263.306667,
  "end": 265.56415,
  "sil_before": [
   258.531247,
   263.306667
  ],
  "sil_after": [
   265.56415,
   272.660794
  ],
  "i": 53,
  "text": "And what it never does is run the app."
 },
 {
  "start": 272.660794,
  "end": 274.476032,
  "sil_before": [
   265.56415,
   272.660794
  ],
  "sil_after": [
   274.476032,
   275.56542
  ],
  "i": 54,
  "text": "The app runs on its own nodes."
 },
 {
  "start": 275.56542,
  "end": 277.890703,
  "sil_before": [
   274.476032,
   275.56542
  ],
  "sil_after": [
   277.890703,
   278.448753
  ],
  "i": 55,
  "text": "Every Vprog owns its own accounts."
 },
 {
  "start": 278.448753,
  "end": 280.725578,
  "sil_before": [
   277.890703,
   278.448753
  ],
  "sil_after": [
   280.725578,
   286.682404
  ],
  "i": 56,
  "text": "and it's the only thing allowed to write to them."
 },
 {
  "start": 286.682404,
  "end": 287.681723,
  "sil_before": [
   280.725578,
   286.682404
  ],
  "sil_after": [
   287.681723,
   288.324308
  ],
  "i": 57,
  "text": "and provers."
 },
 {
  "start": 288.324308,
  "end": 289.772245,
  "sil_before": [
   287.681723,
   288.324308
  ],
  "sil_after": [
   289.772245,
   290.677551
  ],
  "i": 58,
  "text": "for profit operators."
 },
 {
  "start": 290.677551,
  "end": 293.326054,
  "sil_before": [
   289.772245,
   290.677551
  ],
  "sil_after": [
   293.326054,
   296.223152
  ],
  "i": 59,
  "text": "post a zero-knowledge proof back to Caspa."
 },
 {
  "start": 296.223152,
  "end": 299.224603,
  "sil_before": [
   293.326054,
   296.223152
  ],
  "sil_after": [
   299.224603,
   299.655941
  ],
  "i": 60,
  "text": "That's a math receipt that says the state is correct."
 },
 {
  "start": 299.655941,
  "end": 301.319025,
  "sil_before": [
   299.224603,
   299.655941
  ],
  "sil_after": [
   301.319025,
   301.644966
  ],
  "i": 61,
  "text": "and Casper checks the receipt."
 },
 {
  "start": 301.644966,
  "end": 302.978934,
  "sil_before": [
   301.319025,
   301.644966
  ],
  "sil_after": [
   302.978934,
   309.922653
  ],
  "i": 62,
  "text": "instead of redoing the math."
 },
 {
  "start": 309.922653,
  "end": 311.53771,
  "sil_before": [
   302.978934,
   309.922653
  ],
  "sil_after": [
   311.53771,
   314.859048
  ],
  "i": 63,
  "text": "And this buys you two things."
 },
 {
  "start": 314.859048,
  "end": 315.541995,
  "sil_before": [
   311.53771,
   314.859048
  ],
  "sil_after": [
   315.541995,
   316.347551
  ],
  "i": 64,
  "text": "Sovereignty."
 },
 {
  "start": 316.347551,
  "end": 317.73771,
  "sil_before": [
   315.541995,
   316.347551
  ],
  "sil_after": [
   317.73771,
   318.488594
  ],
  "i": 65,
  "text": "If another app breaks..."
 },
 {
  "start": 318.488594,
  "end": 319.52415,
  "sil_before": [
   317.73771,
   318.488594
  ],
  "sil_after": [
   319.52415,
   320.753696
  ],
  "i": 66,
  "text": "Yours keeps running."
 },
 {
  "start": 320.753696,
  "end": 321.746621,
  "sil_before": [
   319.52415,
   320.753696
  ],
  "sil_after": [
   321.746621,
   322.565828
  ],
  "i": 67,
  "text": "and composability."
 },
 {
  "start": 322.565828,
  "end": 323.964739,
  "sil_before": [
   321.746621,
   322.565828
  ],
  "sil_after": [
   323.964739,
   325.394535
  ],
  "i": 68,
  "text": "apps can read each other's state."
 },
 {
  "start": 325.394535,
  "end": 328.875465,
  "sil_before": [
   323.964739,
   325.394535
  ],
  "sil_after": [
   328.875465,
   329.341973
  ],
  "i": 69,
  "text": "and a transaction that touches two apps goes through as one unit."
 },
 {
  "start": 329.341973,
  "end": 330.092993,
  "sil_before": [
   328.875465,
   329.341973
  ],
  "sil_after": [
   330.092993,
   357.386621
  ],
  "i": 70,
  "text": "or not at all."
 },
 {
  "start": 357.386621,
  "end": 362.489909,
  "sil_before": [
   330.092993,
   357.386621
  ],
  "sil_after": [
   362.489909,
   365.294059
  ],
  "i": 71,
  "text": "And this just means the rules for checking all of this live inside of Casper's consensus itself."
 },
 {
  "start": 365.294059,
  "end": 367.197166,
  "sil_before": [
   362.489909,
   365.294059
  ],
  "sil_after": [
   367.197166,
   381.307256
  ],
  "i": 72,
  "text": "not on some other chain."
 },
 {
  "start": 381.307256,
  "end": 383.527959,
  "sil_before": [
   367.197166,
   381.307256
  ],
  "sil_after": [
   383.527959,
   385.159524
  ],
  "i": 73,
  "text": "Now, where does this all actually stand?"
