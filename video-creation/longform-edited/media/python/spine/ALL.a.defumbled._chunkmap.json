  "text": "then pointing out your own documents."
 },
 {
  "start": 648.571973,
  "end": 650.56771,
  "sil_before": [
   647.496871,
   648.571973
  ],
  "sil_after": [
   650.56771,
   651.712063
  ],
  "i": 119,
  "text": "Now you're doing retrieval, chunking."
 },
 {
  "start": 651.712063,
  "end": 652.275102,
  "sil_before": [
