   636.700726
  ],
  "sil_after": [
   637.561293,
   637.895986
  ],
  "i": 116,
  "text": "then give it memory."
 },
 {
  "start": 637.895986,
  "end": 641.947868,
  "sil_before": [
   637.561293,
   637.895986
  ],
  "sil_after": [
   641.947868,
   645.743696
  ],
  "i": 117,
