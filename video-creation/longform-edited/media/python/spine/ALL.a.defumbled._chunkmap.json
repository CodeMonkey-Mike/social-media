   651.712063
  ],
  "sil_after": [
   652.275102,
   658.896281
  ],
  "i": 120,
  "text": "Similarity"
 },
 {
  "start": 658.896281,
  "end": 661.89839,
  "sil_before": [
   652.275102,
   658.896281
  ],
  "sil_after": [
   661.89839,
   662.242721
  ],
  "i": 121,
