  "start": 1178.89542,
  "end": 1180.307052,
  "sil_before": [
   1178.531837,
   1178.89542
  ],
  "sil_after": [
   1180.307052,
   1183.281565
  ],
  "i": 130,
  "text": "The business and the token."
 },
 {
  "start": 1183.281565,
  "end": 1187.09678,
  "sil_before": [
   1180.307052,
   1183.281565
  ],
  "sil_after": [
   1187.09678,
   1191.116735
  ],
  "i": 131,
  "text": "With most crypto, the business is fake and a token is all you have."
 },
 {
  "start": 1191.116735,
  "end": 1195.210159,
  "sil_before": [
   1187.09678,
   1191.116735
  ],
  "sil_after": [
   1195.210159,
   1195.734785
  ],
  "i": 132,
  "text": "Here, it's really the other way around. It's a real business."
 },
 {
  "start": 1195.734785,
  "end": 1197.169796,
  "sil_before": [
   1195.210159,
   1195.734785
  ],
  "sil_after": [
   1197.169796,
   1198.594921
  ],
  "i": 133,
  "text": "and that's not even debatable."
 },
