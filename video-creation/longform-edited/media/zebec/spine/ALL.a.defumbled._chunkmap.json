  "text": "Even the app and code activity got questioned."
 },
 {
  "start": 1104.731701,
  "end": 1109.718957,
  "sil_before": [
   1099.899388,
   1104.731701
  ],
  "sil_after": [
   1109.718957,
   1114.604558
  ],
  "i": 120,
  "text": "I'm not going to repeat all red flags as if they're true, but I'm going to check them and so should you."
 },
 {
  "start": 1114.604558,
  "end": 1118.757234,
  "sil_before": [
   1109.718957,
   1114.604558
  ],
  "sil_after": [
   1118.757234,
   1119.472109
  ],
  "i": 121,
  "text": "Because as usual, nothing is financial advice. Do your own research."
