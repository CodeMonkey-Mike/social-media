  "text": "Sell an entire software and cloud packages to Enterprise."
 },
 {
  "start": 1021.188594,
  "end": 1023.975601,
  "sil_before": [
   1005.252789,
   1021.188594
  ],
  "sil_after": [
   1023.975601,
   1036.650635
  ],
  "i": 111,
  "text": "Nobody rips that out to run their paycheck through a crypto app."
 },
