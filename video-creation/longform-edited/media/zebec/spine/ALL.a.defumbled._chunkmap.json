  "start": 1092.294898,
  "end": 1095.220703,
  "sil_before": [
   1088.488776,
   1092.294898
  ],
  "sil_after": [
   1095.220703,
   1097.264376
  ],
  "i": 118,
  "text": "Big wallet selling while buyers piled in late."
 },
