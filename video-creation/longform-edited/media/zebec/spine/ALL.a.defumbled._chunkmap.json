  "end": 1043.243968,
  "sil_before": [
   1039.258662,
   1040.472426
  ],
  "sil_after": [
   1043.243968,
   1065.883855
  ],
  "i": 113,
  "text": "It's becoming a small rail inside a very big machine."
 },
 {
  "start": 1065.883855,
  "end": 1068.562721,
  "sil_before": [
   1043.243968,
   1065.883855
  ],
  "sil_after": [
   1068.562721,
   1072.699002
  ],
  "i": 114,
  "text": "And then there's the stuff that marketing will never tweet."
