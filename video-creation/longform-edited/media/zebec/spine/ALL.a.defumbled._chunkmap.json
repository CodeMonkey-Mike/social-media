  "text": "thin actual liquidity against the entire market cap."
 },
 {
  "start": 1084.527891,
  "end": 1088.488776,
  "sil_before": [
   1082.891791,
   1084.527891
  ],
  "sil_after": [
   1088.488776,
   1092.294898
  ],
  "i": 117,
  "text": "So the price was propped up on exchanges more than by real on-chain demand."
 },
