  "start": 1036.650635,
  "end": 1039.258662,
  "sil_before": [
   1023.975601,
   1036.650635
  ],
  "sil_after": [
   1039.258662,
   1040.472426
  ],
  "i": 112,
  "text": "The realistic path here is not killing ADP."
