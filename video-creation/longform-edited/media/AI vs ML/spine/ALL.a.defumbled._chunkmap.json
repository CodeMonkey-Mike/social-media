[
 {
  "start": 7.832744,
  "end": 10.378458,
  "sil_before": [
   0.0,
   7.832744
  ],
  "sil_after": [
   10.378458,
   16.226122
  ],
  "i": 0,
  "text": "AI engineer versus ML engineer."
 },
 {
  "start": 16.226122,
  "end": 17.796621,
  "sil_before": [
   10.378458,
   16.226122
  ],
  "sil_after": [
   17.796621,
   18.135624
  ],
  "i": 1,
  "text": "They sound like the same job."
 },
 {
  "start": 18.135624,
  "end": 18.951655,
  "sil_before": [
   17.796621,
   18.135624
  ],
  "sil_after": [
   18.951655,
   19.264399
  ],
  "i": 2,
  "text": "They are not."
 },
 {
  "start": 19.264399,
  "end": 22.14229,
  "sil_before": [
   18.951655,
   19.264399
  ],
  "sil_after": [
   22.14229,
   30.895941
  ],
  "i": 3,
  "text": "At the top, the pay gap between them is huge."
 },
 {
  "start": 30.895941,
  "end": 34.961769,
  "sil_before": [
   22.14229,
   30.895941
  ],
  "sil_after": [
   34.961769,
   44.332925
  ],
  "i": 4,
  "text": "One of these rolls gets the big checks, the other one gets the door open."
 },
 {
  "start": 44.332925,
  "end": 45.748526,
  "sil_before": [
   34.961769,
   44.332925
  ],
  "sil_after": [
   45.748526,
   49.646236
  ],
  "i": 5,
  "text": "So let's break it all down."
 },
 {
  "start": 49.646236,
  "end": 55.258254,
  "sil_before": [
   45.748526,
   49.646236
  ],
  "sil_after": [
   55.258254,
   61.226213
  ],
  "i": 6,
  "text": "The AI engineer is commonly associated with shipping products. On a model, someone else is already trained."
 },
 {
  "start": 61.226213,
  "end": 64.730703,
  "sil_before": [
   55.258254,
   61.226213
  ],
  "sil_after": [
   64.730703,
   65.138639
  ],
  "i": 7,
  "text": "The ML engineer is commonly associated with the model itself."
 },
 {
  "start": 65.138639,
  "end": 67.532676,
  "sil_before": [
   64.730703,
   65.138639
  ],
  "sil_after": [
   67.532676,
   68.911202
  ],
  "i": 8,
  "text": "Billing it, training it and deploying it."
 },
 {
  "start": 68.911202,
  "end": 76.015782,
  "sil_before": [
   67.532676,
   68.911202
  ],
  "sil_after": [
   76.015782,
   87.522766
  ],
  "i": 9,
  "text": "Day to day, that means wiring a model like Claude into your data and your product, and then testing whether the answers are any good."
 },
 {
  "start": 87.522766,
  "end": 88.480522,
  "sil_before": [
   76.015782,
   87.522766
  ],
  "sil_after": [
   88.480522,
   88.800181
  ],
  "i": 10,
  "text": "That's my side."
 },
 {
  "start": 88.800181,
  "end": 94.1461,
  "sil_before": [
   88.480522,
   88.800181
  ],
  "sil_after": [
   94.1461,
   104.886576
  ],
  "i": 11,
  "text": "I've run Cloud agents across whole pipelines, and I never actually trained a model."
 },
 {
  "start": 104.886576,
  "end": 110.401837,
  "sil_before": [
   94.1461,
   104.886576
  ],
  "sil_after": [
   110.401837,
   117.494082
  ],
  "i": 12,
  "text": "So why does an AI engineer even exist? Because the hard part, the training, is already done for you."
 },
 {
  "start": 117.494082,
  "end": 122.306621,
  "sil_before": [
   110.401837,
   117.494082
  ],
  "sil_after": [
   122.306621,
   122.742902
  ],
  "i": 13,
  "text": "But as soon as that API bill gets too big, you can and should"
 },
 {
  "start": 122.742902,
  "end": 124.506349,
  "sil_before": [
   122.306621,
   122.742902
  ],
  "sil_after": [
   124.506349,
   124.992834
  ],
  "i": 14,
  "text": "Post and tune your own model."
 },
 {
  "start": 124.992834,
  "end": 129.942925,
  "sil_before": [
   124.506349,
   124.992834
  ],
  "sil_after": [
   129.942925,
   135.559864
  ],
  "i": 15,
  "text": "which is something that I've been thinking about lately. Hmm, how to cut those costs."
 },
 {
  "start": 135.559864,
  "end": 136.364739,
  "sil_before": [
   129.942925,
   135.559864
  ],
  "sil_after": [
   136.364739,
   136.804717
  ],
  "i": 16,
  "text": "To sum it up..."
 },
 {
  "start": 136.804717,
  "end": 141.725533,
  "sil_before": [
   136.364739,
   136.804717
  ],
  "sil_after": [
   141.725533,
   147.323356
  ],
  "i": 17,
  "text": "AI engineering is less about developing models and more about adapting and evaluating them."
 },
 {
  "start": 147.323356,
  "end": 153.032426,
  "sil_before": [
   141.725533,
   147.323356
  ],
  "sil_after": [
   153.032426,
   155.871769
  ],
  "i": 18,
  "text": "If you have the research background, the stats, the math, the graduate degree, go for ML."
 },
 {
  "start": 155.871769,
  "end": 158.558435,
  "sil_before": [
   153.032426,
   155.871769
  ],
  "sil_after": [
   158.558435,
   165.068322
  ],
  "i": 19,
  "text": "If you're a software developer, choose AI."
 },
 {
  "start": 165.068322,
  "end": 169.541224,
  "sil_before": [
   158.558435,
   165.068322
  ],
  "sil_after": [
   169.541224,
   179.167868
  ],
  "i": 20,
  "text": "If you want to train models, ML. If you want to ship products, AI."
 },
 {
  "start": 179.167868,
  "end": 183.892086,
  "sil_before": [
   169.541224,
   179.167868
  ],
  "sil_after": [
   183.892086,
   193.850703
  ],
  "i": 21,
  "text": "Think of shipping a support chatbot on Claude versus training a fraud model."
 },
 {
  "start": 193.850703,
  "end": 199.871746,
  "sil_before": [
   183.892086,
   193.850703
  ],
  "sil_after": [
   199.871746,
   205.652086
  ],
  "i": 22,
  "text": "And right now LinkedIn's fastest growing job in the US for 2026 is AI engineer."
 },
 {
  "start": 205.652086,
  "end": 208.940431,
  "sil_before": [
   199.871746,
   205.652086
  ],
  "sil_after": [
   208.940431,
   216.541338
  ],
  "i": 23,
  "text": "If you have the code but not the math, AI is your way in."
 },
 {
  "start": 216.541338,
  "end": 218.827347,
  "sil_before": [
   208.940431,
   216.541338
  ],
  "sil_after": [
   218.827347,
   219.219728
  ],
  "i": 24,
  "text": "If you have the math but not the production code."
 },
 {
  "start": 219.219728,
  "end": 219.87941,
  "sil_before": [
   218.827347,
   219.219728
  ],
  "sil_after": [
   219.87941,
   220.307755
  ],
  "i": 25,
  "text": "Here's the thing."
 },
 {
  "start": 220.307755,
  "end": 222.45415,
  "sil_before": [
   219.87941,
   220.307755
  ],
  "sil_after": [
   222.45415,
   236.038594
  ],
  "i": 26,
  "text": "ML teams won shipping experience too."
 },
 {
  "start": 236.038594,
  "end": 236.987868,
  "sil_before": [
   222.45415,
   236.038594
  ],
  "sil_after": [
   236.987868,
   239.435488
  ],
  "i": 27,
  "text": "Now the money."
 },
 {
  "start": 239.435488,
  "end": 244.176372,
  "sil_before": [
   236.987868,
   239.435488
  ],
  "sil_after": [
   244.176372,
   249.486871
  ],
  "i": 28,
  "text": "In total pay, the typical engineer in the US makes around $155,000 a year."
 },
 {
  "start": 249.486871,
  "end": 256.116508,
  "sil_before": [
   244.176372,
   249.486871
  ],
  "sil_after": [
   256.116508,
   258.242744
  ],
  "i": 29,
  "text": "And the top 10% of ML engineers start at around $495,000 a year."
 },
 {
  "start": 258.242744,
  "end": 259.254853,
  "sil_before": [
   256.116508,
   258.242744
  ],
  "sil_after": [
   259.254853,
   262.498526
  ],
  "i": 30,
  "text": "My god, dude."
 },
 {
  "start": 262.498526,
  "end": 265.075692,
  "sil_before": [
   259.254853,
   262.498526
  ],
  "sil_after": [
   265.075692,
   267.345692
  ],
  "i": 31,
  "text": "That's a $340,000 gap."
 },
 {
  "start": 267.345692,
  "end": 269.734218,
  "sil_before": [
   265.075692,
   267.345692
  ],
  "sil_after": [
   269.734218,
   277.856803
  ],
  "i": 32,
  "text": "and it goes to the people who train the models."
 },
 {
  "start": 277.856803,
  "end": 280.165556,
  "sil_before": [
   269.734218,
   277.856803
  ],
  "sil_after": [
   280.165556,
   280.487415
  ],
  "i": 33,
  "text": "But those seats are few."
 },
 {
  "start": 280.487415,
  "end": 283.184626,
  "sil_before": [
   280.165556,
   280.487415
  ],
  "sil_after": [
   283.184626,
   283.810091
  ],
  "i": 34,
  "text": "and you're competing with PhDs for them."
 },
 {
  "start": 283.810091,
  "end": 284.819637,
  "sil_before": [
   283.184626,
   283.810091
  ],
  "sil_after": [
   284.819637,
   297.016803
  ],
  "i": 35,
  "text": "Something to ponder."
 },
 {
  "start": 297.016803,
  "end": 300.781678,
  "sil_before": [
   284.819637,
   297.016803
  ],
  "sil_after": [
   300.781678,
   306.36746
  ],
  "i": 36,
  "text": "Therefore, for most developers, AI engineering is the key."
 },
 {
  "start": 306.36746,
  "end": 309.116463,
  "sil_before": [
   300.781678,
   306.36746
  ],
  "sil_after": [
   309.116463,
   313.752132
  ],
  "i": 37,
  "text": "The door is open, you already have the skills."
 },
 {
  "start": 313.752132,
  "end": 318.215011,
  "sil_before": [
   309.116463,
   313.752132
  ],
  "sil_after": [
   318.215011,
   331.192041
  ],
  "i": 38,
  "text": "So subscribe for more steady content on how to become an AI engineer."
 },
 {
  "start": 331.192041,
  "end": 335.781088,
  "sil_before": [
   318.215011,
   331.192041
  ],
  "sil_after": [
   335.781088,
   347.502766
  ],
  "i": 39,
  "text": "All my content on this channel is geared to help you on your AI engineering journey."
 },
 {
  "start": 347.502766,
  "end": 349.388526,
  "sil_before": [
   335.781088,
   347.502766
  ],
  "sil_after": [
   349.388526,
   349.915714
  ],
  "i": 40,
  "text": "and watch this next video right here."
 },
 {
  "start": 349.915714,
  "end": 351.063832,
  "sil_before": [
   349.388526,
   349.915714
  ],
  "sil_after": [
   351.063832,
   351.681451
  ],
  "i": 41,
  "text": "Or maybe even this one."
 },
 {
  "start": 351.681451,
  "end": 352.41381,
  "sil_before": [
   351.063832,
   351.681451
  ],
  "sil_after": [
   352.41381,
   352.836961
  ],
  "i": 42,
  "text": "for this one."
 },
 {
  "start": 352.836961,
  "end": 353.840272,
  "sil_before": [
   352.41381,
   352.836961
  ],
  "sil_after": [
   353.840272,
   356.379864
  ],
  "i": 43,
  "text": "Or even this one!"
 }
]