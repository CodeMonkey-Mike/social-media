[
 {
  "start": 5.079819,
  "end": 8.772086,
  "sil_before": [
   0.0,
   5.079819
  ],
  "sil_after": [
   8.772086,
   21.544172
  ],
  "i": 0,
  "text": "For 30 years, Japan has handed the world free money."
 },
 {
  "start": 21.544172,
  "end": 25.600068,
  "sil_before": [
   8.772086,
   21.544172
  ],
  "sil_after": [
   25.600068,
   25.938027
  ],
  "i": 1,
  "text": "Trillions of dollars had flowed out of Japan into US stocks."
 },
 {
  "start": 25.938027,
  "end": 26.568322,
  "sil_before": [
   25.600068,
   25.938027
  ],
  "sil_after": [
   26.568322,
   26.951701
  ],
  "i": 2,
  "text": "bonds."
 },
 {
  "start": 26.951701,
  "end": 28.497506,
  "sil_before": [
   26.568322,
   26.951701
  ],
  "sil_after": [
   28.497506,
   43.440227
  ],
  "i": 3,
  "text": "And yes, into crypto."
 },
 {
  "start": 43.440227,
  "end": 47.793583,
  "sil_before": [
   28.497506,
   43.440227
  ],
  "sil_after": [
   47.793583,
   51.608186
  ],
  "i": 4,
  "text": "It was because keeping that money at home basically paid nothing."
 },
 {
  "start": 51.608186,
  "end": 53.42746,
  "sil_before": [
   47.793583,
   51.608186
  ],
  "sil_after": [
   53.42746,
   59.214444
  ],
  "i": 5,
  "text": "That error is ending."
 },
 {
  "start": 59.214444,
  "end": 62.765261,
  "sil_before": [
   53.42746,
   59.214444
  ],
  "sil_after": [
   62.765261,
   73.3461
  ],
  "i": 6,
  "text": "And some of that money is already packing up and going home."
 },
 {
  "start": 73.3461,
  "end": 76.407483,
  "sil_before": [
   62.765261,
   73.3461
  ],
  "sil_after": [
   76.407483,
   76.747483
  ],
  "i": 7,
  "text": "This isn't a story about whether Japan's central bank"
 },
 {
  "start": 76.747483,
  "end": 78.427891,
  "sil_before": [
   76.407483,
   76.747483
  ],
  "sil_after": [
   78.427891,
   78.837937
  ],
  "i": 8,
  "text": "Hikes rates one more time."
 },
 {
  "start": 78.837937,
  "end": 79.986417,
  "sil_before": [
   78.427891,
   78.837937
  ],
  "sil_after": [
   79.986417,
   88.547619
  ],
  "i": 9,
  "text": "It's bigger than that."
 },
 {
  "start": 88.547619,
  "end": 93.146803,
  "sil_before": [
   79.986417,
   88.547619
  ],
  "sil_after": [
   93.146803,
   93.737166
  ],
  "i": 10,
  "text": "It's decades of capital that only left Japan because home paid nothing."
 },
 {
  "start": 93.737166,
  "end": 95.681519,
  "sil_before": [
   93.146803,
   93.737166
  ],
  "sil_after": [
   95.681519,
   101.495351
  ],
  "i": 11,
  "text": "And home doesn't pay nothing anymore."
 },
 {
  "start": 101.495351,
  "end": 105.664875,
  "sil_before": [
   95.681519,
   101.495351
  ],
  "sil_after": [
   105.664875,
   106.57932
  ],
  "i": 12,
  "text": "Japan is the single largest foreign holder of US government debt."
 },
 {
  "start": 106.57932,
  "end": 108.937211,
  "sil_before": [
   105.664875,
   106.57932
  ],
  "sil_after": [
   108.937211,
   110.636803
  ],
  "i": 13,
  "text": "over $1.2 trillion."
 },
 {
  "start": 110.636803,
  "end": 114.616485,
  "sil_before": [
   108.937211,
   110.636803
  ],
  "sil_after": [
   114.616485,
   114.961565
  ],
  "i": 14,
  "text": "And Japanese investors already pulled tens of billions of that back out."
 },
 {
  "start": 114.961565,
  "end": 117.30932,
  "sil_before": [
   114.616485,
   114.961565
  ],
  "sil_after": [
   117.30932,
   135.225805
  ],
  "i": 15,
  "text": "in the first few months of 2026."
 },
 {
  "start": 135.225805,
  "end": 137.498753,
  "sil_before": [
   117.30932,
   135.225805
  ],
  "sil_after": [
   137.498753,
   139.204603
  ],
  "i": 16,
  "text": "We've seen the last version of this before."
 },
 {
  "start": 176.383469,
  "end": 178.160658,
  "sil_before": [
   139.243673,
   176.383469
  ],
  "sil_after": [
   178.160658,
   178.689683
  ],
  "i": 17,
  "text": "In August of 2024."
 },
 {
  "start": 178.689683,
  "end": 186.811156,
  "sil_before": [
   178.160658,
   178.689683
  ],
  "sil_after": [
   186.811156,
   205.335147
  ],
  "i": 18,
  "text": "We saw something very similar happen where Bitcoin went from 64K down to 49K within just a couple of days."
 },
 {
  "start": 205.335147,
  "end": 206.27288,
  "sil_before": [
   186.811156,
   205.335147
  ],
  "sil_after": [
   206.27288,
   206.946576
  ],
  "i": 19,
  "text": "So today..."
 },
 {
  "start": 206.946576,
  "end": 209.430748,
  "sil_before": [
   206.27288,
   206.946576
  ],
  "sil_after": [
   209.430748,
   209.815488
  ],
  "i": 20,
  "text": "what this money actually was doing overseas."
 },
 {
  "start": 209.815488,
  "end": 211.883288,
  "sil_before": [
   209.430748,
   209.815488
  ],
  "sil_after": [
   211.883288,
   212.421791
  ],
  "i": 21,
  "text": "There are two different ways it can come home."
 },
 {
  "start": 212.421791,
  "end": 215.313719,
  "sil_before": [
   211.883288,
   212.421791
  ],
  "sil_after": [
   215.313719,
   215.819524
  ],
  "i": 22,
  "text": "The proof that has already broke markets once."
 },
 {
  "start": 215.819524,
  "end": 218.896259,
  "sil_before": [
   215.313719,
   215.819524
  ],
  "sil_after": [
   218.896259,
   219.529796
  ],
  "i": 23,
  "text": "Exactly how much of it is already moving out right now."
 },
 {
  "start": 219.529796,
  "end": 221.823605,
  "sil_before": [
   218.896259,
   219.529796
  ],
  "sil_after": [
   221.823605,
   222.166757
  ],
  "i": 24,
  "text": "and what it means for crypto specifically."
 },
 {
  "start": 222.166757,
  "end": 223.644354,
  "sil_before": [
   221.823605,
   222.166757
  ],
  "sil_after": [
   223.644354,
   235.339683
  ],
  "i": 25,
  "text": "if more of it follows."
 },
 {
  "start": 235.339683,
  "end": 237.37585,
  "sil_before": [
   223.644354,
   235.339683
  ],
  "sil_after": [
   237.37585,
   237.963991
  ],
  "i": 26,
  "text": "the mechanisms, the receipts."
 },
 {
  "start": 237.963991,
  "end": 239.600839,
  "sil_before": [
   237.37585,
   237.963991
  ],
  "sil_after": [
   239.600839,
   240.048639
  ],
  "i": 27,
  "text": "and what to actually look out for."
 },
 {
  "start": 240.048639,
  "end": 242.410703,
  "sil_before": [
   239.600839,
   240.048639
  ],
  "sil_after": [
   242.410703,
   251.353243
  ],
  "i": 28,
  "text": "and what it means for our current bear market."
 },
 {
  "start": 251.353243,
  "end": 253.256735,
  "sil_before": [
   242.410703,
   251.353243
  ],
  "sil_after": [
   253.256735,
   258.461224
  ],
  "i": 29,
  "text": "So what exactly is the carry trade?"
 },
 {
  "start": 258.461224,
  "end": 260.771565,
  "sil_before": [
   253.256735,
   258.461224
  ],
  "sil_after": [
   260.771565,
   261.259637
  ],
  "i": 30,
  "text": "Strip away all the jargon and it's simple."
 },
 {
  "start": 261.259637,
  "end": 263.120567,
  "sil_before": [
   260.771565,
   261.259637
  ],
  "sil_after": [
   263.120567,
   264.922381
  ],
  "i": 31,
  "text": "Money looks for the best return it can get."
 },
 {
  "start": 264.922381,
  "end": 266.911497,
  "sil_before": [
   263.120567,
   264.922381
  ],
  "sil_after": [
   266.911497,
   267.511293
  ],
  "i": 32,
  "text": "If your own country pays you nothing..."
 },
 {
  "start": 267.511293,
  "end": 270.04712,
  "sil_before": [
   266.911497,
   267.511293
  ],
  "sil_after": [
   270.04712,
   271.55059
  ],
  "i": 33,
  "text": "You send your money somewhere else where it pays more."
 },
 {
  "start": 271.55059,
  "end": 272.161814,
  "sil_before": [
   270.04712,
   271.55059
  ],
  "sil_after": [
   272.161814,
   279.709433
  ],
  "i": 34,
  "text": "Bottom line."
 },
 {
  "start": 279.709433,
  "end": 281.190408,
  "sil_before": [
   272.161814,
   279.709433
  ],
  "sil_after": [
   281.190408,
   281.899229
  ],
  "i": 35,
  "text": "for the last 30 years."
 },
 {
  "start": 281.899229,
  "end": 284.24551,
  "sil_before": [
   281.190408,
   281.899229
  ],
  "sil_after": [
   284.24551,
   287.321633
  ],
  "i": 36,
  "text": "Japan kept interest rates at basically zero."
 },
 {
  "start": 287.321633,
  "end": 289.506236,
  "sil_before": [
   284.24551,
   287.321633
  ],
  "sil_after": [
   289.506236,
   294.486667
  ],
  "i": 37,
  "text": "and for a long stretch even below zero."
 },
 {
  "start": 294.486667,
  "end": 296.875034,
  "sil_before": [
   289.506236,
   294.486667
  ],
  "sil_after": [
   296.875034,
   297.433469
  ],
  "i": 38,
  "text": "So two very different kinds of investors."
 },
 {
  "start": 297.433469,
  "end": 298.989116,
  "sil_before": [
   296.875034,
   297.433469
  ],
  "sil_after": [
   298.989116,
   305.305102
  ],
  "i": 39,
  "text": "Both did the same exact thing."
 },
 {
  "start": 305.305102,
  "end": 305.952404,
  "sil_before": [
   298.989116,
   305.305102
  ],
  "sil_after": [
   305.952404,
   306.430181
  ],
  "i": 40,
  "text": "real money."
 },
 {
  "start": 306.430181,
  "end": 312.552562,
  "sil_before": [
   305.952404,
   306.430181
  ],
  "sil_after": [
   312.552562,
   313.933311
  ],
  "i": 41,
  "text": "Japan's own life insurers, pension funds, and banks hold in trillions of dollars in savings."
 },
 {
  "start": 313.933311,
  "end": 315.25034,
  "sil_before": [
   312.552562,
   313.933311
  ],
  "sil_after": [
   315.25034,
   315.860839
  ],
  "i": 42,
  "text": "bought foreign bonds."
 },
 {
  "start": 315.860839,
  "end": 318.599433,
  "sil_before": [
   315.25034,
   315.860839
  ],
  "sil_after": [
   318.599433,
   322.022902
  ],
  "i": 43,
  "text": "and foreign stocks instead of Japanese assets."
 },
 {
  "start": 322.022902,
  "end": 324.090975,
  "sil_before": [
   318.599433,
   322.022902
  ],
  "sil_after": [
   324.090975,
   325.0878
  ],
  "i": 44,
  "text": "just because those actually paid something."
 },
 {
  "start": 325.0878,
  "end": 330.609365,
  "sil_before": [
   324.090975,
   325.0878
  ],
  "sil_after": [
   330.609365,
   337.293175
  ],
  "i": 45,
  "text": "Japan's own pension fund keeps roughly a quarter of its entire portfolio in foreign stocks alone."
 },
 {
  "start": 337.293175,
  "end": 338.34517,
  "sil_before": [
   330.609365,
   337.293175
  ],
  "sil_after": [
   338.34517,
   342.055238
  ],
  "i": 46,
  "text": "and the borrowed money."
 },
 {
  "start": 342.055238,
  "end": 344.829728,
  "sil_before": [
   338.34517,
   342.055238
  ],
  "sil_after": [
   344.829728,
   345.169977
  ],
  "i": 47,
  "text": "speculators and funds actually borrowed."
 },
 {
  "start": 345.169977,
  "end": 352.05712,
  "sil_before": [
   344.829728,
   345.169977
  ],
  "sil_after": [
   352.05712,
   358.05458
  ],
  "i": 48,
  "text": "yen at near zero rates, converted it and used it to buy risk assets like stocks and crypto."
 },
 {
  "start": 358.05458,
  "end": 359.744875,
  "sil_before": [
   352.05712,
   358.05458
  ],
  "sil_after": [
   359.744875,
   368.154535
  ],
  "i": 49,
  "text": "and anywhere paying a real return."
 },
 {
  "start": 368.154535,
  "end": 371.119025,
  "sil_before": [
   359.744875,
   368.154535
  ],
  "sil_after": [
   371.119025,
   371.60898
  ],
  "i": 50,
  "text": "Both lanes together move trillions of dollars."
 },
 {
  "start": 371.60898,
  "end": 373.051837,
  "sil_before": [
   371.119025,
   371.60898
  ],
  "sil_after": [
   373.051837,
   374.065737
  ],
  "i": 51,
  "text": "This isn't a niche trade."
 },
 {
  "start": 374.065737,
  "end": 378.970567,
  "sil_before": [
   373.051837,
   374.065737
  ],
  "sil_after": [
   378.970567,
   389.648209
  ],
  "i": 52,
  "text": "It's one of the reasons US assets and crypto had so much capital chasing it for so long."
 },
 {
  "start": 389.648209,
  "end": 391.31034,
  "sil_before": [
   378.970567,
   389.648209
  ],
  "sil_after": [
   391.31034,
   397.411633
  ],
  "i": 53,
  "text": "And here's the part that matters."
 },
 {
  "start": 397.411633,
  "end": 400.513401,
  "sil_before": [
   391.31034,
   397.411633
  ],
  "sil_after": [
   400.513401,
   402.196009
  ],
  "i": 54,
  "text": "Both lanes made sense while two things stay true."
 },
 {
  "start": 402.196009,
  "end": 403.938095,
  "sil_before": [
   400.513401,
   402.196009
  ],
  "sil_after": [
   403.938095,
   407.056145
  ],
  "i": 55,
  "text": "Japan keeps paying nothing."
 },
 {
  "start": 407.056145,
  "end": 408.51839,
  "sil_before": [
   403.938095,
   407.056145
  ],
  "sil_after": [
   408.51839,
   411.232313
  ],
  "i": 56,
  "text": "and the yen stays weak."
 },
 {
  "start": 417.548163,
  "end": 422.665624,
  "sil_before": [
   411.379274,
   417.548163
  ],
  "sil_after": [
   422.665624,
   429.828277
  ],
  "i": 57,
  "text": "Change either one and the math that justifies sending money abroad starts to break."
 },
 {
  "start": 429.828277,
  "end": 434.859252,
  "sil_before": [
   422.665624,
   429.828277
  ],
  "sil_after": [
   434.859252,
   441.740295
  ],
  "i": 58,
  "text": "So when people say the curry trade could blow up, they're only describing half of it."
 },
 {
  "start": 441.740295,
  "end": 444.729683,
  "sil_before": [
   434.859252,
   441.740295
  ],
  "sil_after": [
   444.729683,
   445.703492
  ],
  "i": 59,
  "text": "There are two completely different ways this money goes home."
 },
 {
  "start": 445.703492,
  "end": 447.107868,
  "sil_before": [
   444.729683,
   445.703492
  ],
  "sil_after": [
   447.107868,
   448.245805
  ],
  "i": 60,
  "text": "One is slow and quiet."
 },
 {
  "start": 448.245805,
  "end": 449.94093,
  "sil_before": [
   447.107868,
   448.245805
  ],
  "sil_after": [
   449.94093,
   453.014898
  ],
  "i": 61,
  "text": "The other is fast and violent."
 },
 {
  "start": 453.014898,
  "end": 455.53381,
  "sil_before": [
   449.94093,
   453.014898
  ],
  "sil_after": [
   455.53381,
   470.773129
  ],
  "i": 62,
  "text": "Understanding both is why I'm making this video."
 },
 {
  "start": 470.773129,
  "end": 474.154717,
  "sil_before": [
   455.53381,
   470.773129
  ],
  "sil_after": [
   474.154717,
   477.353039
  ],
  "i": 63,
  "text": "The slow way doesn't need a crisis or even a headline."
 },
 {
  "start": 477.353039,
  "end": 481.161995,
  "sil_before": [
   474.154717,
   477.353039
  ],
  "sil_after": [
   481.161995,
   483.569887
  ],
  "i": 64,
  "text": "Japan's life insurers and pension funds simply compare returns."
 },
 {
  "start": 483.569887,
  "end": 486.941678,
  "sil_before": [
   481.161995,
   483.569887
  ],
  "sil_after": [
   486.941678,
   487.502766
  ],
  "i": 65,
  "text": "If a Japanese government bond starts paying a real yield again..."
 },
 {
  "start": 487.502766,
  "end": 490.174853,
  "sil_before": [
   486.941678,
   487.502766
  ],
  "sil_after": [
   490.174853,
   490.727982
  ],
  "i": 66,
  "text": "There's less of a reason to hold a foreign bond instead."
 },
 {
  "start": 490.727982,
  "end": 492.921293,
  "sil_before": [
   490.174853,
   490.727982
  ],
  "sil_after": [
   492.921293,
   493.331837
  ],
  "i": 67,
  "text": "for the same or even a worse return."
 },
 {
  "start": 493.331837,
  "end": 494.362698,
  "sil_before": [
   492.921293,
   493.331837
  ],
  "sil_after": [
   494.362698,
   507.329342
  ],
  "i": 68,
  "text": "plus a currency risk."
 },
 {
  "start": 507.329342,
  "end": 508.878503,
  "sil_before": [
   494.362698,
   507.329342
  ],
  "sil_after": [
   508.878503,
   509.411497
  ],
  "i": 69,
  "text": "There's no trigger event required."
 },
 {
  "start": 509.411497,
  "end": 512.355488,
  "sil_before": [
   508.878503,
   509.411497
  ],
  "sil_after": [
   512.355488,
   512.875329
  ],
  "i": 70,
  "text": "It's just money quietly going where there's a better deal."
 },
 {
  "start": 512.875329,
  "end": 514.080952,
  "sil_before": [
   512.355488,
   512.875329
  ],
  "sil_after": [
   514.080952,
   518.977642
  ],
  "i": 71,
  "text": "And it's already happening."
 },
 {
  "start": 518.977642,
  "end": 521.507052,
  "sil_before": [
   514.080952,
   518.977642
  ],
  "sil_after": [
   521.507052,
   526.278163
  ],
  "i": 72,
  "text": "Then the fast way is the one that makes the headlines."
 },
 {
