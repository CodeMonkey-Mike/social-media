[
 {
  "start": 3.973288,
  "end": 9.312086,
  "sil_before": [
   0.0,
   3.973288
  ],
  "sil_after": [
   9.312086,
   11.632698
  ],
  "i": 0,
  "text": "Right before the 4th of July, a crypto bill that was supposed to sail through the Senate stalled."
 },
 {
  "start": 11.632698,
  "end": 12.855102,
  "sil_before": [
   9.312086,
   11.632698
  ],
  "sil_after": [
   12.855102,
   15.727211
  ],
  "i": 1,
  "text": "most people shrugged."
 },
 {
  "start": 15.727211,
  "end": 18.065374,
  "sil_before": [
   12.855102,
   15.727211
  ],
  "sil_after": [
   18.065374,
   18.834512
  ],
  "i": 2,
  "text": "Just another bill stuck in Washington."
 },
 {
  "start": 24.59288,
  "end": 29.103651,
  "sil_before": [
   19.014263,
   24.59288
  ],
  "sil_after": [
   29.103651,
   31.301179
  ],
  "i": 3,
  "text": "But the thing jamming it up is a question that sounds way too small a matter."
 },
 {
  "start": 31.301179,
  "end": 33.358707,
  "sil_before": [
   29.103651,
   31.301179
  ],
  "sil_after": [
   33.358707,
   51.711338
  ],
  "i": 4,
  "text": "Can a stablecoin pay you interest?"
 },
 {
  "start": 51.711338,
  "end": 54.953379,
  "sil_before": [
   33.358707,
   51.711338
  ],
  "sil_after": [
   54.953379,
   55.273424
  ],
  "i": 5,
  "text": "And that tiny sounding question is hiding one of the."
 },
 {
  "start": 55.273424,
  "end": 57.338186,
  "sil_before": [
   54.953379,
   55.273424
  ],
  "sil_after": [
   57.338186,
   62.921156
  ],
  "i": 6,
  "text": "biggest money moves of the decade."
 },
 {
  "start": 62.921156,
  "end": 65.617868,
  "sil_before": [
   57.338186,
   62.921156
  ],
  "sil_after": [
   65.617868,
   66.018254
  ],
  "i": 7,
  "text": "Because while everyone argues about interest..."
 },
 {
  "start": 66.018254,
  "end": 69.093991,
  "sil_before": [
   65.617868,
   66.018254
  ],
  "sil_after": [
   69.093991,
   72.343583
  ],
  "i": 8,
  "text": "Two bills are quietly doing something much bigger."
 },
 {
  "start": 72.343583,
  "end": 74.189274,
  "sil_before": [
   69.093991,
   72.343583
  ],
  "sil_after": [
   74.189274,
   74.683537
  ],
  "i": 9,
  "text": "keeping the US dollar on top."
 },
 {
  "start": 74.683537,
  "end": 76.279229,
  "sil_before": [
   74.189274,
   74.683537
  ],
  "sil_after": [
   76.279229,
   76.947256
  ],
  "i": 10,
  "text": "for another 50 years."
 },
 {
  "start": 76.947256,
  "end": 78.644535,
  "sil_before": [
   76.279229,
   76.947256
  ],
  "sil_after": [
   78.644535,
   88.385805
  ],
  "i": 11,
  "text": "and they're doing it with crypto."
 },
 {
  "start": 88.385805,
  "end": 90.820703,
  "sil_before": [
   78.644535,
   88.385805
  ],
  "sil_after": [
   90.820703,
   91.241905
  ],
  "i": 12,
  "text": "The Genius Act already signed into law."
 },
 {
  "start": 91.241905,
  "end": 94.521429,
  "sil_before": [
   90.820703,
   91.241905
  ],
  "sil_after": [
   94.521429,
   96.121769
  ],
  "i": 13,
  "text": "and the Clarity Act, the one stuck in the center right now."
 },
 {
  "start": 96.121769,
  "end": 99.761066,
  "sil_before": [
   94.521429,
   96.121769
  ],
  "sil_after": [
   99.761066,
   103.611429
  ],
  "i": 14,
  "text": "Together they turned stable coins into a Trojan horse for the dollar."
 },
 {
  "start": 103.611429,
  "end": 104.917415,
  "sil_before": [
   99.761066,
   103.611429
  ],
  "sil_after": [
   104.917415,
   113.249683
  ],
  "i": 15,
  "text": "Let me show you the whole play."
 },
 {
  "start": 122.131088,
  "end": 123.328526,
  "sil_before": [
   113.428685,
   122.131088
  ],
  "sil_after": [
   123.328526,
   123.835941
  ],
  "i": 16,
  "text": "After World War II."
 },
 {
  "start": 123.835941,
  "end": 127.526372,
  "sil_before": [
   123.328526,
   123.835941
  ],
  "sil_after": [
   127.526372,
   131.283401
  ],
  "i": 17,
  "text": "the world's gold had drained into one country, the United States."
 },
 {
  "start": 131.283401,
  "end": 133.385079,
  "sil_before": [
   127.526372,
   131.283401
  ],
  "sil_after": [
   133.385079,
   134.020204
  ],
  "i": 18,
  "text": "to everyone else, they're the practical thing."
 },
 {
  "start": 134.020204,
  "end": 135.601746,
  "sil_before": [
   133.385079,
   134.020204
  ],
  "sil_after": [
   135.601746,
   136.047596
  ],
  "i": 19,
  "text": "They pegged their money to the dollar."
 },
 {
  "start": 136.047596,
  "end": 138.31229,
  "sil_before": [
   135.601746,
   136.047596
  ],
  "sil_after": [
   138.31229,
   138.921202
  ],
  "i": 20,
  "text": "because the dollar was redeemable for gold."
 },
 {
  "start": 138.921202,
  "end": 141.248095,
  "sil_before": [
   138.31229,
   138.921202
  ],
  "sil_after": [
   141.248095,
   143.787868
  ],
  "i": 21,
  "text": "The dollar became the world's reserve currency."
 },
 {
  "start": 157.613039,
  "end": 159.4478,
  "sil_before": [
   150.251791,
   157.613039
  ],
  "sil_after": [
   159.4478,
   159.8922
  ],
  "i": 22,
  "text": "Then America started abusing it."
 },
 {
  "start": 159.8922,
  "end": 162.908209,
  "sil_before": [
   159.4478,
   159.8922
  ],
  "sil_after": [
   162.908209,
   167.752517
  ],
  "i": 23,
  "text": "It printed far more dollars than it had gold to back them."
 },
 {
  "start": 169.867982,
  "end": 172.505828,
  "sil_before": [
   167.756395,
   169.867982
  ],
  "sil_after": [
   172.505828,
   173.119456
  ],
  "i": 24,
  "text": "By the late 60s, the world caught on."
 },
 {
  "start": 173.119456,
  "end": 174.269297,
  "sil_before": [
   172.505828,
   173.119456
  ],
  "sil_after": [
   174.269297,
   174.947823
  ],
  "i": 25,
  "text": "and came to collect."
 },
 {
  "start": 174.947823,
  "end": 176.185465,
  "sil_before": [
   174.269297,
   174.947823
  ],
  "sil_after": [
   176.185465,
   177.723197
  ],
  "i": 26,
  "text": "It wasn't enough gold."
 },
 {
  "start": 177.723197,
  "end": 181.697732,
  "sil_before": [
   176.185465,
   177.723197
  ],
  "sil_after": [
   181.697732,
   182.161134
  ],
  "i": 27,
  "text": "So in 1971, Nixon slammed the gold window shut."
 },
 {
  "start": 182.161134,
  "end": 183.749864,
  "sil_before": [
   181.697732,
   182.161134
  ],
  "sil_after": [
   183.749864,
   195.784785
  ],
  "i": 28,
  "text": "The gold standard was dead."
 },
 {
  "start": 195.784785,
  "end": 199.207687,
  "sil_before": [
   183.749864,
   195.784785
  ],
  "sil_after": [
   199.207687,
   200.35746
  ],
  "i": 29,
  "text": "losing the reserve currency would have ended American power."
 },
 {
  "start": 200.35746,
  "end": 202.016644,
  "sil_before": [
   199.207687,
   200.35746
  ],
  "sil_after": [
   202.016644,
   202.55585
  ],
  "i": 30,
  "text": "So they invented a new leash."
 },
 {
  "start": 202.55585,
  "end": 203.446054,
  "sil_before": [
   202.016644,
   202.55585
  ],
  "sil_after": [
   203.446054,
   208.596145
  ],
  "i": 31,
  "text": "the Petrodollar."
 },
 {
  "start": 208.596145,
  "end": 215.403129,
  "sil_before": [
   203.446054,
   208.596145
  ],
  "sil_after": [
   215.403129,
   215.926531
  ],
  "i": 32,
  "text": "Oil would only be priced in dollars. Every nation on earth that wanted oil first had to get US dollars."
 },
 {
  "start": 215.926531,
  "end": 218.992562,
  "sil_before": [
   215.403129,
   215.926531
  ],
  "sil_after": [
   218.992562,
   229.19356
  ],
  "i": 33,
  "text": "and those dollars flowed back into US treasuries."
 },
 {
  "start": 229.19356,
  "end": 230.080295,
  "sil_before": [
   218.992562,
   229.19356
  ],
  "sil_after": [
   230.080295,
   230.419841
  ],
  "i": 34,
  "text": "That's the trick."
 },
 {
  "start": 230.419841,
  "end": 231.717098,
  "sil_before": [
   230.080295,
   230.419841
  ],
  "sil_after": [
   231.717098,
   237.385057
  ],
  "i": 35,
  "text": "every single time."
 },
 {
  "start": 237.385057,
  "end": 239.18449,
  "sil_before": [
   231.717098,
   237.385057
  ],
  "sil_after": [
   239.18449,
   239.498844
  ],
  "i": 36,
  "text": "force the world to need dollars."
 },
 {
  "start": 239.498844,
  "end": 242.602721,
  "sil_before": [
   239.18449,
   239.498844
  ],
  "sil_after": [
   242.602721,
   245.498594
  ],
  "i": 37,
  "text": "and then soak those dollars back into American debt."
 },
 {
  "start": 247.227959,
  "end": 248.661973,
  "sil_before": [
   245.557778,
   247.227959
  ],
  "sil_after": [
   248.661973,
   250.078889
  ],
  "i": 38,
  "text": "No gold required."
 },
 {
  "start": 250.078889,
  "end": 252.112063,
  "sil_before": [
   248.661973,
   250.078889
  ],
  "sil_after": [
   252.112063,
   253.997596
  ],
  "i": 39,
  "text": "Just leverage over everyone."
 },
 {
  "start": 253.997596,
  "end": 256.005533,
  "sil_before": [
   252.112063,
   253.997596
  ],
  "sil_after": [
   256.005533,
   256.368821
  ],
  "i": 40,
  "text": "and it held for 50 years."
 },
 {
  "start": 256.368821,
  "end": 258.21322,
  "sil_before": [
   256.005533,
   256.368821
  ],
  "sil_after": [
   258.21322,
   269.870635
  ],
  "i": 41,
  "text": "until the starter's slipping again."
 },
 {
  "start": 269.870635,
  "end": 274.271973,
  "sil_before": [
   258.21322,
   269.870635
  ],
  "sil_after": [
   274.271973,
   274.628617
  ],
  "i": 42,
  "text": "So fast forward to today where the dollar is slipping again. Same story."
 },
 {
  "start": 274.628617,
  "end": 277.482063,
  "sil_before": [
   274.271973,
   274.628617
  ],
  "sil_after": [
   277.482063,
   279.580658
  ],
  "i": 43,
  "text": "They're printing far more than the economy can absorb."
 },
 {
  "start": 279.580658,
  "end": 281.002086,
  "sil_before": [
   277.482063,
   279.580658
  ],
  "sil_after": [
   281.002086,
   281.461247
  ],
  "i": 44,
  "text": "They needed a new leash."
 },
 {
  "start": 281.461247,
  "end": 282.911497,
  "sil_before": [
   281.002086,
   281.461247
  ],
  "sil_after": [
   282.911497,
   285.672086
  ],
  "i": 45,
  "text": "and they just legislated one."
 },
 {
  "start": 285.672086,
  "end": 286.105828,
  "sil_before": [
   282.911497,
   285.672086
  ],
  "sil_after": [
   286.105828,
   290.46712
  ],
  "i": 46,
  "text": ""
 },
 {
  "start": 290.46712,
  "end": 292.658526,
  "sil_before": [
   286.105828,
   290.46712
  ],
  "sil_after": [
   292.658526,
   295.309365
  ],
  "i": 47,
  "text": "And here's the part almost nobody connects."
 },
 {
  "start": 295.309365,
  "end": 298.84415,
  "sil_before": [
   292.658526,
   295.309365
  ],
  "sil_after": [
   298.84415,
   301.197687
  ],
  "i": 48,
  "text": "A dollar stable coin isn't just magic internet money."
 },
 {
  "start": 301.197687,
  "end": 302.381247,
  "sil_before": [
   298.84415,
   301.197687
  ],
  "sil_after": [
   302.381247,
   302.682109
  ],
  "i": 49,
  "text": "behind every coin."
 },
 {
  "start": 302.682109,
  "end": 305.883537,
  "sil_before": [
   302.381247,
   302.682109
  ],
  "sil_after": [
   305.883537,
   309.887891
  ],
  "i": 50,
  "text": "The issue of parks, actual dollars, and US treasuries."
 },
 {
  "start": 309.887891,
  "end": 313.790794,
  "sil_before": [
   305.883537,
   309.887891
  ],
  "sil_after": [
   313.790794,
   314.097415
  ],
  "i": 51,
  "text": "And in July of 2025, this month last year,"
 },
 {
  "start": 314.097415,
  "end": 315.567302,
  "sil_before": [
   313.790794,
   314.097415
  ],
  "sil_after": [
   315.567302,
   318.021156
  ],
  "i": 52,
  "text": "that stop being optional."
 },
 {
  "start": 318.021156,
  "end": 319.730181,
  "sil_before": [
   315.567302,
   318.021156
  ],
  "sil_after": [
   319.730181,
   322.042857
  ],
  "i": 53,
  "text": "The genius act became law."
 },
 {
  "start": 322.042857,
  "end": 329.313288,
  "sil_before": [
   319.730181,
   322.042857
  ],
  "sil_after": [
   329.313288,
   341.864104
  ],
  "i": 54,
  "text": "It forces every dollar stablecoin to hold 100% reserves in cash and short-term US treasuries."
 },
 {
  "start": 341.864104,
  "end": 343.581156,
  "sil_before": [
   329.313288,
   341.864104
  ],
  "sil_after": [
   343.581156,
   344.618027
  ],
  "i": 55,
  "text": "Read what this actually means."
 },
 {
  "start": 344.618027,
  "end": 350.981247,
  "sil_before": [
   343.581156,
   344.618027
  ],
  "sil_after": [
   350.981247,
   356.431383
  ],
  "i": 56,
  "text": "Every dollar stablecoin on the planet is now a forced buyer of American government debt by law."
 },
 {
  "start": 356.431383,
  "end": 359.803741,
  "sil_before": [
   350.981247,
   356.431383
  ],
  "sil_after": [
   359.803741,
   360.220295
  ],
  "i": 57,
  "text": "The petrodollar funneled the world's money into treasuries."
 },
 {
  "start": 360.220295,
  "end": 364.249138,
  "sil_before": [
   359.803741,
   360.220295
  ],
  "sil_after": [
   364.249138,
   366.404444
  ],
  "i": 58,
  "text": "Stablecoins finding the world's everyday money into treasuries."
 },
 {
  "start": 366.404444,
  "end": 367.166281,
  "sil_before": [
   364.249138,
   366.404444
  ],
  "sil_after": [
   367.166281,
   367.477483
  ],
  "i": 59,
  "text": "Same trick."
 },
 {
  "start": 367.477483,
  "end": 368.443968,
  "sil_before": [
   367.166281,
   367.477483
  ],
  "sil_after": [
   368.443968,
   378.956259
  ],
  "i": 60,
  "text": "new rails."
 },
 {
  "start": 382.611043,
  "end": 385.512925,
  "sil_before": [
   379.011859,
   382.611043
  ],
  "sil_after": [
   385.512925,
   385.88449
  ],
  "i": 61,
  "text": "This is Bretton Woods 3.0 and this time."
 },
 {
  "start": 385.88449,
  "end": 390.309932,
  "sil_before": [
   385.512925,
   385.88449
  ],
  "sil_after": [
   390.309932,
   390.775215
  ],
  "i": 62,
  "text": "The dollar doesn't need gold. The dollar doesn't need oil. It just needs."
 },
 {
  "start": 390.775215,
  "end": 391.616372,
  "sil_before": [
   390.309932,
   390.775215
  ],
  "sil_after": [
   391.616372,
   400.19551
  ],
  "i": 63,
  "text": "your phone."
 },
 {
  "start": 400.19551,
  "end": 405.828549,
  "sil_before": [
   391.616372,
   400.19551
  ],
  "sil_after": [
   405.828549,
   406.171973
  ],
  "i": 64,
  "text": "And speaking of your phone, the best thing you could do with it right now is to scroll down"
 },
 {
  "start": 406.171973,
  "end": 407.539478,
  "sil_before": [
   405.828549,
   406.171973
  ],
  "sil_after": [
   407.539478,
   407.878322
  ],
  "i": 65,
  "text": "on that description."
 },
 {
  "start": 407.878322,
  "end": 412.541769,
  "sil_before": [
   407.539478,
   407.878322
  ],
  "sil_after": [
   412.541769,
   412.929116
  ],
  "i": 66,
  "text": "Tap on that link to join the community. The best community ever, my community."
 },
 {
  "start": 412.929116,
  "end": 414.433424,
  "sil_before": [
   412.541769,
   412.929116
  ],
  "sil_after": [
   414.433424,
   414.788821
  ],
  "i": 67,
  "text": "We make tons of software."
 },
 {
  "start": 414.788821,
  "end": 418.892812,
  "sil_before": [
   414.433424,
   414.788821
  ],
  "sil_after": [
   418.892812,
   419.355578
  ],
  "i": 68,
  "text": "where 50 X's and 100 X's are just commonplace these days."
 },
 {
  "start": 419.355578,
  "end": 423.775442,
  "sil_before": [
   418.892812,
   419.355578
  ],
  "sil_after": [
   423.775442,
   438.090726
  ],
  "i": 69,
  "text": "And if you like this content, make sure you click that like button and that subscribe button."
 },
 {
  "start": 438.090726,
  "end": 442.847778,
  "sil_before": [
   423.775442,
   438.090726
  ],
  "sil_after": [
   442.847778,
   448.400907
  ],
  "i": 70,
  "text": "and click that bell icon too, so you never miss content like this, because in a second..."
 },
 {
  "start": 448.400907,
  "end": 451.332449,
  "sil_before": [
   442.847778,
   448.400907
  ],
  "sil_after": [
   451.332449,
   458.29737
  ],
  "i": 71,
  "text": "I'm going to show you the part that almost nobody gets right."
 },
 {
  "start": 468.208163,
  "end": 473.668662,
  "sil_before": [
   458.33254,
   468.208163
  ],
  "sil_after": [
   473.668662,
   479.489819
  ],
  "i": 72,
  "text": "There's a real interest ban on the books, and you're probably earning interest on your stables right now."
 },
 {
  "start": 479.489819,
  "end": 481.530771,
  "sil_before": [
   473.668662,
   479.489819
  ],
  "sil_after": [
   481.530771,
   489.379705
  ],
  "i": 73,
  "text": "Here's a loophole that explains why."
 },
 {
  "start": 502.500317,
  "end": 502.797324,
  "sil_before": [
   489.414558,
   502.500317
  ],
  "sil_after": [
   502.797324,
   503.10424
  ],
  "i": 74,
  "text": "Now."
 },
 {
  "start": 503.10424,
  "end": 506.729365,
  "sil_before": [
   502.797324,
   503.10424
  ],
  "sil_after": [
   506.729365,
   511.010113
  ],
  "i": 75,
  "text": "Every government on earth wants a central bank digital currency."
 },
 {
  "start": 511.010113,
  "end": 511.798005,
  "sil_before": [
   506.729365,
   511.010113
  ],
  "sil_after": [
   511.798005,
   512.126825
  ],
  "i": 76,
  "text": "One ledger."
 },
 {
  "start": 512.126825,
  "end": 513.165193,
  "sil_before": [
   511.798005,
   512.126825
  ],
  "sil_after": [
   513.165193,
   514.595261
  ],
  "i": 77,
  "text": "Total Visibility."
 },
 {
  "start": 514.595261,
  "end": 517.012902,
  "sil_before": [
   513.165193,
   514.595261
  ],
  "sil_after": [
   517.012902,
   520.683401
  ],
  "i": 78,
  "text": "control over every transaction you make."
 },
 {
  "start": 520.683401,
  "end": 521.645125,
  "sil_before": [
   517.012902,
   520.683401
  ],
  "sil_after": [
   521.645125,
   524.501451
  ],
  "i": 79,
  "text": "There's one problem."
 },
 {
  "start": 524.501451,
  "end": 526.472948,
  "sil_before": [
   521.645125,
   524.501451
  ],
  "sil_after": [
   526.472948,
   532.424036
  ],
  "i": 80,
  "text": "Their own citizens don't want it."
 },
 {
  "start": 532.424036,
  "end": 538.514263,
  "sil_before": [
   526.472948,
   532.424036
  ],
  "sil_after": [
   538.514263,
   539.707483
  ],
  "i": 81,
  "text": "A government coin that watches every single dollar you spend is a surveillance tool, and people know it."
 },
 {
  "start": 539.707483,
  "end": 543.549955,
  "sil_before": [
   538.514263,
   539.707483
  ],
  "sil_after": [
   543.549955,
   546.123968
  ],
  "i": 82,
  "text": "So most of those projects are frozen in pilot mode, going nowhere."
 },
 {
  "start": 557.130476,
  "end": 559.070045,
  "sil_before": [
   546.254558,
   557.130476
  ],
  "sil_after": [
   559.070045,
   562.104127
  ],
  "i": 83,
  "text": "So Washington did something smarter."
 },
 {
  "start": 562.104127,
  "end": 563.956553,
  "sil_before": [
   559.070045,
   562.104127
  ],
  "sil_after": [
   563.956553,
   564.517642
  ],
  "i": 84,
  "text": "It didn't build a government coin."
 },
 {
  "start": 564.517642,
  "end": 569.269728,
  "sil_before": [
   563.956553,
   564.517642
  ],
  "sil_after": [
   569.269728,
   573.061202
  ],
  "i": 85,
  "text": "It let private companies build the dollar coin, then wrote the laws to control them."
 },
 {
  "start": 573.061202,
  "end": 575.166553,
  "sil_before": [
   569.269728,
   573.061202
  ],
  "sil_after": [
   575.166553,
   575.657052
  ],
  "i": 86,
  "text": "It's not run by the central bank."
 },
 {
  "start": 575.657052,
  "end": 578.606054,
  "sil_before": [
   575.166553,
   575.657052
  ],
  "sil_after": [
   578.606054,
   578.997211
  ],
  "i": 87,
  "text": "It's regulated by Congress and enforced by the Treasury."
 },
 {
  "start": 578.997211,
  "end": 579.990249,
  "sil_before": [
   578.606054,
   578.997211
  ],
  "sil_after": [
   579.990249,
   580.438141
  ],
  "i": 88,
  "text": "Same control."
 },
 {
  "start": 580.438141,
  "end": 581.409569,
  "sil_before": [
   579.990249,
   580.438141
  ],
  "sil_after": [
   581.409569,
   584.37449
  ],
  "i": 89,
  "text": "None of the stigma."
 },
 {
  "start": 584.37449,
  "end": 584.773356,
  "sil_before": [
   581.409569,
   584.37449
  ],
  "sil_after": [
   584.773356,
   585.150839
  ],
  "i": 90,
  "text": "that"
 },
 {
  "start": 585.150839,
  "end": 586.428299,
  "sil_before": [
   584.773356,
   585.150839
  ],
  "sil_after": [
   586.428299,
   599.41059
  ],
  "i": 91,
  "text": "is the Trojan Horse."
 },
 {
  "start": 599.41059,
  "end": 603.05,
  "sil_before": [
   586.428299,
   599.41059
  ],
  "sil_after": [
   603.05,
   603.404059
  ],
  "i": 92,
  "text": "a quasi private central bank digital currency."
 },
 {
  "start": 603.404059,
  "end": 608.065488,
  "sil_before": [
   603.05,
   603.404059
  ],
  "sil_after": [
   608.065488,
   613.394082
  ],
  "i": 93,
  "text": "that the people install themselves because it just looks like a better bank account."
 },
 {
  "start": 613.394082,
  "end": 614.701927,
  "sil_before": [
   608.065488,
   613.394082
  ],
  "sil_after": [
   614.701927,
   615.159478
  ],
  "i": 94,
  "text": "Nobody riots over it."
 },
 {
  "start": 615.159478,
  "end": 618.368209,
  "sil_before": [
   614.701927,
   615.159478
  ],
  "sil_after": [
   618.368209,
   618.711451
  ],
  "i": 95,
  "text": "Nobody cares. Nobody writes over an app that pays them."
 },
 {
  "start": 618.711451,
  "end": 619.986712,
  "sil_before": [
   618.368209,
   618.711451
  ],
  "sil_after": [
   619.986712,
   625.620499
  ],
  "i": 96,
  "text": "And that's exactly the point."
 },
 {
  "start": 631.461111,
  "end": 635.206848,
  "sil_before": [
   625.721111,
   631.461111
  ],
  "sil_after": [
   635.206848,
   637.607234
  ],
  "i": 97,
  "text": "So here's the part that everyone trips up, and honestly, it tripped me up too."
 },
 {
  "start": 637.607234,
  "end": 638.986803,
  "sil_before": [
   635.206848,
   637.607234
  ],
  "sil_after": [
   638.986803,
   640.136621
  ],
  "i": 98,
  "text": "There's a real interest ban."
 },
 {
  "start": 640.136621,
  "end": 641.591633,
  "sil_before": [
   638.986803,
   640.136621
  ],
  "sil_after": [
   641.591633,
   641.993855
  ],
  "i": 99,
  "text": "But it's not in the Clarity Act."
 },
 {
  "start": 641.993855,
  "end": 644.563741,
  "sil_before": [
   641.591633,
   641.993855
  ],
  "sil_after": [
   644.563741,
   645.796259
  ],
  "i": 100,
  "text": "and it does not do what people think it does."
 },
 {
  "start": 645.796259,
  "end": 647.613379,
  "sil_before": [
   644.563741,
   645.796259
  ],
  "sil_after": [
   647.613379,
   648.556395
  ],
  "i": 101,
  "text": "The ban is in the Genius Act."
 },
 {
  "start": 648.556395,
  "end": 650.026712,
  "sil_before": [
   647.613379,
   648.556395
  ],
  "sil_after": [
   650.026712,
   651.737687
  ],
  "i": 102,
  "text": "And that one's already law."
 },
 {
  "start": 651.737687,
  "end": 655.41195,
  "sil_before": [
   650.026712,
   651.737687
  ],
  "sil_after": [
   655.41195,
   655.731519
  ],
  "i": 103,
  "text": "And it says the issuer of her stablecoin, a company like Circle"
 },
 {
  "start": 655.731519,
  "end": 658.152472,
  "sil_before": [
   655.41195,
   655.731519
  ],
  "sil_after": [
   658.152472,
   662.852132
  ],
  "i": 104,
  "text": "cannot pay you yield just for holding their coin."
 },
 {
  "start": 662.852132,
  "end": 667.807574,
  "sil_before": [
   658.152472,
   662.852132
  ],
  "sil_after": [
   667.807574,
   668.464898
  ],
  "i": 105,
  "text": "The funny thing is that you're probably still earning yield on your stable coins right now."
 },
 {
  "start": 668.464898,
  "end": 671.139501,
  "sil_before": [
   667.807574,
   668.464898
  ],
  "sil_after": [
   671.139501,
   676.036122
  ],
  "i": 106,
  "text": "So that begs the question, like what gives?"
 },
 {
  "start": 676.036122,
  "end": 677.808095,
  "sil_before": [
   671.139501,
   676.036122
  ],
  "sil_after": [
   677.808095,
   679.401451
  ],
  "i": 107,
  "text": "The band stops at the issuer."
 },
 {
  "start": 679.401451,
  "end": 681.319138,
  "sil_before": [
   677.808095,
   679.401451
  ],
  "sil_after": [
   681.319138,
   681.778322
  ],
  "i": 108,
  "text": "It never touches the exchanges."
 },
 {
  "start": 681.778322,
  "end": 683.107007,
  "sil_before": [
   681.319138,
   681.778322
  ],
  "sil_after": [
   683.107007,
   685.160454
  ],
  "i": 109,
  "text": "Circle can pay you."
 },
 {
  "start": 685.160454,
  "end": 689.822721,
  "sil_before": [
   683.107007,
   685.160454
  ],
  "sil_after": [
   689.822721,
   690.310862
  ],
  "i": 110,
  "text": "but Coinbase can hand you about 3.5% and call it a loyalty reward."
 },
 {
  "start": 690.310862,
  "end": 692.124558,
  "sil_before": [
   689.822721,
   690.310862
  ],
  "sil_after": [
   692.124558,
   695.011814
  ],
  "i": 111,
  "text": "because Coinbase isn't the issuer."
 },
 {
  "start": 695.011814,
  "end": 696.518481,
  "sil_before": [
   692.124558,
   695.011814
  ],
  "sil_after": [
   696.518481,
   704.122925
  ],
  "i": 112,
  "text": "Same money, same interest."
 },
 {
  "start": 704.122925,
  "end": 707.765238,
  "sil_before": [
   696.518481,
   704.122925
  ],
  "sil_after": [
   707.765238,
   712.288118
  ],
  "i": 113,
  "text": "It just takes one extra hop so it doesn't count as the issue we're paying you."
 },
 {
  "start": 712.288118,
  "end": 714.449773,
  "sil_before": [
   707.765238,
   712.288118
  ],
  "sil_after": [
   714.449773,
   720.361769
  ],
  "i": 114,
  "text": "The lower has a coinbase shaped hole in it."
 },
 {
  "start": 720.361769,
  "end": 724.450091,
  "sil_before": [
   714.449773,
   720.361769
  ],
  "sil_after": [
   724.450091,
   728.787256
  ],
  "i": 115,
  "text": "And that hole is worth over a billion dollars a year to Coinbase alone."
 },
 {
  "start": 728.787256,
  "end": 729.261701,
  "sil_before": [
   724.450091,
   728.787256
  ],
  "sil_after": [
   729.261701,
   732.74127
  ],
  "i": 116,
  "text": ""
 },
 {
  "start": 732.74127,
  "end": 737.117075,
  "sil_before": [
   729.261701,
   732.74127
  ],
  "sil_after": [
   737.117075,
   738.599252
  ],
  "i": 117,
  "text": "So now the banks want that hole closed. Regulators are proposing closing it."
 },
 {
  "start": 738.599252,
  "end": 741.431066,
  "sil_before": [
   737.117075,
   738.599252
  ],
  "sil_after": [
   741.431066,
   741.928912
  ],
  "i": 118,
  "text": "And the clarity act, the one stuck in a center right now."
 },
 {
  "start": 741.928912,
  "end": 743.36932,
  "sil_before": [
   741.431066,
   741.928912
  ],
  "sil_after": [
   743.36932,
   749.153492
  ],
  "i": 119,
  "text": "is where the fight is playing out."
 },
 {
  "start": 749.153492,
  "end": 751.487778,
  "sil_before": [
   743.36932,
   749.153492
  ],
  "sil_after": [
   751.487778,
   751.939093
  ],
  "i": 120,
  "text": "That's the real reason that clarity matters."
 },
 {
  "start": 751.939093,
  "end": 757.620907,
  "sil_before": [
   751.487778,
   751.939093
  ],
  "sil_after": [
   757.620907,
   761.903016
  ],
  "i": 121,
  "text": "Not because it bans interest, but because it decides whether or not that loophole lives or dies."
 },
 {
  "start": 761.903016,
  "end": 764.183084,
  "sil_before": [
   757.620907,
   761.903016
  ],
  "sil_after": [
   764.183084,
   764.603288
  ],
  "i": 122,
  "text": "whether you keep earning interest on your stablecoins."
 },
 {
  "start": 764.603288,
  "end": 767.097029,
  "sil_before": [
   764.183084,
   764.603288
  ],
  "sil_after": [
   767.097029,
   767.433039
  ],
  "i": 123,
  "text": "and how hard America gets to sell the dollar."
 },
 {
  "start": 767.433039,
  "end": 768.486077,
  "sil_before": [
   767.097029,
   767.433039
  ],
  "sil_after": [
   768.486077,
   780.823061
  ],
  "i": 124,
  "text": "to the rest of the world."
 },
 {
  "start": 780.823061,
  "end": 785.582154,
  "sil_before": [
   768.486077,
   780.823061
  ],
  "sil_after": [
   785.582154,
   794.480839
  ],
  "i": 125,
  "text": "Which is why this boring sounding bill matters more than the price of any coin this month."
 },
 {
  "start": 794.480839,
  "end": 796.266531,
  "sil_before": [
   785.582154,
   794.480839
  ],
  "sil_after": [
   796.266531,
   796.643605
  ],
  "i": 126,
  "text": "And the timing is everything."
 },
 {
  "start": 796.643605,
  "end": 799.180363,
  "sil_before": [
   796.266531,
   796.643605
  ],
  "sil_after": [
   799.180363,
   800.006485
  ],
  "i": 127,
  "text": "Right now the US government is drowning in debt."
 },
 {
  "start": 800.006485,
  "end": 801.703878,
  "sil_before": [
   799.180363,
   800.006485
  ],
  "sil_after": [
   801.703878,
   802.508118
  ],
  "i": 128,
  "text": "and it needs the world to keep buying."
 },
 {
  "start": 802.508118,
  "end": 805.696168,
  "sil_before": [
   801.703878,
   802.508118
  ],
  "sil_after": [
   805.696168,
   806.114671
  ],
  "i": 129,
  "text": "Long-term treasury yields are near multi-decade highs."
 },
 {
  "start": 806.114671,
  "end": 807.476848,
  "sil_before": [
   805.696168,
   806.114671
  ],
  "sil_after": [
   807.476848,
   814.372517
  ],
  "i": 130,
  "text": "The real demand is thin."
 },
 {
  "start": 814.372517,
  "end": 819.31873,
  "sil_before": [
   807.476848,
   814.372517
  ],
  "sil_after": [
   819.31873,
   822.970249
  ],
  "i": 131,
  "text": "Every time America needed to sell more debt and manufacture new users of the dollar."
 },
 {
  "start": 822.970249,
  "end": 824.51,
  "sil_before": [
   819.31873,
   822.970249
  ],
  "sil_after": [
   824.51,
   825.815646
  ],
  "i": 132,
  "text": "Gold gave it Bretton Woods."
 },
 {
  "start": 825.815646,
  "end": 827.407302,
  "sil_before": [
   824.51,
   825.815646
  ],
  "sil_after": [
   827.407302,
   828.103764
  ],
  "i": 133,
  "text": "Oil gave it the petrodollar."
 },
 {
  "start": 828.103764,
  "end": 829.937029,
  "sil_before": [
   827.407302,
   828.103764
  ],
  "sil_after": [
   829.937029,
   834.690204
  ],
  "i": 134,
  "text": "Now crypto gives us stable coins."
 },
 {
  "start": 834.690204,
  "end": 840.28542,
  "sil_before": [
   829.937029,
   834.690204
  ],
  "sil_after": [
   840.28542,
   840.65966
  ],
  "i": 135,
  "text": "Estimates put the new treasury demand in the trillions over the coming years. A fresh captive lender"
 },
 {
  "start": 840.65966,
  "end": 841.927143,
  "sil_before": [
   840.28542,
   840.65966
  ],
  "sil_after": [
   841.927143,
   849.86644
  ],
  "i": 136,
  "text": "for the bankrupt government."
 },
 {
  "start": 849.86644,
  "end": 852.099433,
  "sil_before": [
   841.927143,
   849.86644
  ],
  "sil_after": [
   852.099433,
   879.154785
  ],
  "i": 137,
  "text": "built out of the world's everyday money."
 },
 {
  "start": 879.154785,
  "end": 884.607166,
  "sil_before": [
   852.099433,
   879.154785
  ],
  "sil_after": [
   884.607166,
   885.188957
  ],
  "i": 138,
  "text": "So at the exact moment that the world is asking, how long is the dollar gonna last from here?"
 },
 {
  "start": 885.188957,
  "end": 889.548957,
  "sil_before": [
   884.607166,
   885.188957
  ],
  "sil_after": [
   889.548957,
   894.687914
  ],
  "i": 139,
  "text": "Washington's answer is to put the dollar into everybody's hand on the entire planet."
 },
 {
  "start": 894.687914,
  "end": 895.64424,
  "sil_before": [
   889.548957,
   894.687914
  ],
  "sil_after": [
   895.64424,
   896.074875
  ],
  "i": 140,
  "text": "not by force."
 },
 {
  "start": 896.074875,
  "end": 896.900272,
  "sil_before": [
   895.64424,
   896.074875
  ],
  "sil_after": [
   896.900272,
   897.873741
  ],
  "i": 141,
  "text": "by choice."
 },
 {
  "start": 897.873741,
  "end": 899.16415,
  "sil_before": [
   896.900272,
   897.873741
  ],
  "sil_after": [
   899.16415,
   899.591746
  ],
  "i": 142,
  "text": "and behind the scenes."
 },
 {
  "start": 899.591746,
  "end": 902.479252,
  "sil_before": [
   899.16415,
   899.591746
  ],
  "sil_after": [
   902.479252,
   914.77127
  ],
  "i": 143,
  "text": "Your purchasing power gets funneled straight into the debt."
 },
 {
  "start": 914.77127,
  "end": 916.190748,
  "sil_before": [
