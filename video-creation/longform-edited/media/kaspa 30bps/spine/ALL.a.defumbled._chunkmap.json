 },
 {
  "start": 16.003991,
  "end": 18.137687,
  "sil_before": [
   7.9122,
   16.003991
  ],
  "sil_after": [
   18.137687,
   18.53644
  ],
  "i": 2,
  "text": "This is where Casper is headed next."
 },
 {
  "start": 18.53644,
  "end": 19.674263,
  "sil_before": [
   18.137687,
   18.53644
  ],
  "sil_after": [
   19.674263,
   20.061837
  ],
  "i": 3,
