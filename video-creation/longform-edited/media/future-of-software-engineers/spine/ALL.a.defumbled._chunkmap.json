[
 {
  "start": 4.585873,
  "end": 5.295692,
  "sil_before": [
   0.0,
   4.585873
  ],
  "sil_after": [
   5.295692,
   5.750748
  ],
  "i": 0,
  "text": "at Google."
 },
 {
  "start": 5.750748,
  "end": 9.872358,
  "sil_before": [
   5.295692,
   5.750748
  ],
  "sil_after": [
   9.872358,
   20.638209
  ],
  "i": 1,
  "text": "75% of all new code is generated by AI."
 },
 {
  "start": 20.638209,
  "end": 21.689751,
  "sil_before": [
   9.872358,
   20.638209
  ],
  "sil_after": [
   21.689751,
   22.123243
  ],
  "i": 2,
  "text": "Engineers approve it."
 },
 {
  "start": 22.123243,
  "end": 23.729932,
  "sil_before": [
   21.689751,
   22.123243
  ],
  "sil_after": [
   23.729932,
   24.044036
  ],
  "i": 3,
  "text": "That's Google's own CEO."
 },
 {
  "start": 24.044036,
  "end": 25.642449,
  "sil_before": [
   23.729932,
   24.044036
  ],
  "sil_after": [
   25.642449,
   31.212925
  ],
  "i": 4,
  "text": "in April 2026."
 },
 {
  "start": 31.212925,
  "end": 38.140726,
  "sil_before": [
   25.642449,
   31.212925
  ],
  "sil_after": [
   38.140726,
   38.580748
  ],
  "i": 5,
  "text": "At Anthropic, the company that makes Clawed, over 90% of what went into their codebase is September 2026."
 },
 {
  "start": 38.580748,
  "end": 40.132766,
  "sil_before": [
   38.140726,
   38.580748
  ],
  "sil_after": [
   40.132766,
   42.600181
  ],
  "i": 6,
  "text": "was written by Claude."
 },
 {
  "start": 42.600181,
  "end": 44.84381,
  "sil_before": [
   40.132766,
   42.600181
  ],
  "sil_after": [
   44.84381,
   53.839819
  ],
  "i": 7,
  "text": "That's in their own filing with the SEC."
 },
 {
  "start": 53.839819,
  "end": 57.221383,
  "sil_before": [
   44.84381,
   53.839819
  ],
  "sil_after": [
   57.221383,
   67.112698
  ],
  "i": 8,
  "text": "You just cannot keep your head down and write code anymore."
 },
 {
  "start": 67.112698,
  "end": 72.790045,
  "sil_before": [
   57.221383,
   67.112698
  ],
  "sil_after": [
   72.790045,
   79.249206
  ],
  "i": 9,
  "text": "So the question isn't whether an AI writes the code. The question is what the software engineer is actually getting paid for."
 },
 {
  "start": 79.249206,
  "end": 80.637914,
  "sil_before": [
   72.790045,
   79.249206
  ],
  "sil_after": [
   80.637914,
   83.172789
  ],
  "i": 10,
  "text": "So let me show you how we got here."
 },
 {
  "start": 83.172789,
  "end": 84.049569,
  "sil_before": [
   80.637914,
   83.172789
  ],
  "sil_after": [
   84.049569,
   85.865034
  ],
  "i": 11,
  "text": "Start with Google."
 },
 {
  "start": 85.865034,
  "end": 91.659751,
  "sil_before": [
   84.049569,
   85.865034
  ],
  "sil_after": [
   91.659751,
   93.3622
  ],
  "i": 12,
  "text": "In October of 2024, their CEO said that more than a quarter of all new code was generated by AI."
 },
 {
  "start": 93.3622,
  "end": 95.064036,
  "sil_before": [
   91.659751,
   93.3622
  ],
  "sil_after": [
   95.064036,
   95.55576
  ],
  "i": 13,
  "text": "By the fall of 2025."
 },
 {
  "start": 95.55576,
  "end": 96.603651,
  "sil_before": [
   95.064036,
   95.55576
  ],
  "sil_after": [
   96.603651,
   96.998163
  ],
  "i": 14,
  "text": "It was 50%."
 },
 {
  "start": 96.998163,
  "end": 99.001497,
  "sil_before": [
   96.603651,
   96.998163
  ],
  "sil_after": [
   99.001497,
   99.335261
  ],
  "i": 15,
  "text": "by April 2026."
 },
 {
  "start": 99.335261,
  "end": 100.206553,
  "sil_before": [
   99.001497,
   99.335261
  ],
  "sil_after": [
   100.206553,
   106.018186
  ],
  "i": 16,
  "text": "75."
 },
 {
  "start": 106.018186,
  "end": 107.958503,
  "sil_before": [
   100.206553,
   106.018186
  ],
  "sil_after": [
   107.958503,
   109.007188
  ],
  "i": 17,
  "text": "Anthropic moved even faster."
 },
 {
  "start": 109.007188,
  "end": 112.293673,
  "sil_before": [
   107.958503,
   109.007188
  ],
  "sil_after": [
   112.293673,
   113.16263
  ],
  "i": 18,
  "text": "Before Cloud Code launched in February of 2025,"
 },
 {
  "start": 113.16263,
  "end": 116.030499,
  "sil_before": [
   112.293673,
   113.16263
  ],
  "sil_after": [
   116.030499,
   117.708776
  ],
  "i": 19,
  "text": "Clogged share of their code was in the low single digits."
 },
 {
  "start": 117.708776,
  "end": 119.405351,
  "sil_before": [
   116.030499,
   117.708776
  ],
  "sil_after": [
   119.405351,
   119.878912
  ],
  "i": 20,
  "text": "May of 2026."
 },
 {
  "start": 119.878912,
  "end": 122.56059,
  "sil_before": [
   119.405351,
   119.878912
  ],
  "sil_after": [
   122.56059,
   123.157052
  ],
  "i": 21,
  "text": "Claude had authored more than 80% of the code they merged."
 },
 {
  "start": 123.157052,
  "end": 125.32322,
  "sil_before": [
   122.56059,
   123.157052
  ],
  "sil_after": [
   125.32322,
   129.955034
  ],
  "i": 22,
  "text": "by September over 90%."
 },
 {
  "start": 129.955034,
  "end": 132.219796,
  "sil_before": [
   125.32322,
   129.955034
  ],
  "sil_after": [
   132.219796,
   132.946395
  ],
  "i": 23,
  "text": "Both companies describe the same change."
 },
 {
  "start": 132.946395,
  "end": 138.964512,
  "sil_before": [
   132.219796,
   132.946395
  ],
  "sil_after": [
   138.964512,
   142.193492
  ],
  "i": 24,
  "text": "Anthropics Firelink says this engineer is increasingly direct and review its work rather than write code line by line."
 },
 {
  "start": 142.193492,
  "end": 144.97542,
  "sil_before": [
   138.964512,
   142.193492
  ],
  "sil_after": [
   144.97542,
   146.823401
  ],
  "i": 25,
  "text": "Less typing, more directing, and more reviewing."
 },
 {
  "start": 146.823401,
  "end": 149.810907,
  "sil_before": [
   144.97542,
   146.823401
  ],
  "sil_after": [
   149.810907,
   150.261519
  ],
  "i": 26,
  "text": "Now the big idea behind all of this is recursive self-improvement."
 },
 {
  "start": 150.261519,
  "end": 153.905283,
  "sil_before": [
   149.810907,
   150.261519
  ],
  "sil_after": [
   153.905283,
   158.478345
  ],
  "i": 27,
  "text": "An AI that designs and builds its own successor with no human in the loop."
 },
 {
  "start": 158.478345,
  "end": 160.058571,
  "sil_before": [
   153.905283,
   158.478345
  ],
  "sil_after": [
   160.058571,
   160.871927
  ],
  "i": 28,
  "text": "Anthropics own words on that."
 },
 {
  "start": 160.871927,
  "end": 161.76619,
  "sil_before": [
   160.058571,
   160.871927
  ],
  "sil_after": [
   161.76619,
   177.559796
  ],
  "i": 29,
  "text": "We're not there yet."
 },
 {
  "start": 177.559796,
  "end": 179.604331,
  "sil_before": [
   161.76619,
   177.559796
  ],
  "sil_after": [
   179.604331,
   182.559478
  ],
  "i": 30,
  "text": "but the loop has started closing."
 },
 {
  "start": 182.559478,
  "end": 185.35746,
  "sil_before": [
   179.604331,
   182.559478
  ],
  "sil_after": [
   185.35746,
   189.594036
  ],
  "i": 31,
  "text": "Each version of Claude already helps build the next one."
 },
 {
  "start": 189.594036,
  "end": 193.074739,
  "sil_before": [
   185.35746,
   189.594036
  ],
  "sil_after": [
   193.074739,
   193.925351
  ],
  "i": 32,
  "text": "And on November 10th, 2026, in its IPO filing."
 },
 {
  "start": 193.925351,
  "end": 198.698844,
  "sil_before": [
   193.074739,
   193.925351
  ],
  "sil_after": [
   198.698844,
   202.568254
  ],
  "i": 33,
  "text": "Anthropic told investors it has met its own threshold for AI accelerating AI progress."
 },
 {
  "start": 202.568254,
  "end": 204.723787,
  "sil_before": [
   198.698844,
   202.568254
  ],
  "sil_after": [
   204.723787,
   210.0078
  ],
  "i": 34,
  "text": "based on what it expects for future models."
 },
 {
  "start": 210.0078,
  "end": 211.921088,
  "sil_before": [
   204.723787,
   210.0078
  ],
  "sil_after": [
   211.921088,
   218.872744
  ],
  "i": 35,
  "text": "not on what today's models have shown."
 },
 {
  "start": 218.872744,
  "end": 221.298073,
  "sil_before": [
   211.921088,
   218.872744
  ],
  "sil_after": [
   221.298073,
   222.772494
  ],
  "i": 36,
  "text": "We're at the end of 2026 now."
 },
 {
  "start": 222.772494,
  "end": 224.848798,
  "sil_before": [
   221.298073,
   222.772494
  ],
  "sil_after": [
   224.848798,
   228.798707
  ],
  "i": 37,
  "text": "Now picture the end of 2027."
 },
 {
  "start": 228.798707,
  "end": 234.799501,
  "sil_before": [
   224.848798,
   228.798707
  ],
  "sil_after": [
   234.799501,
   244.418866
  ],
  "i": 38,
  "text": "Anthropic says in 2027 AI systems could be capable of tasks that take humans weeks to do"
 },
 {
  "start": 244.418866,
  "end": 248.577324,
  "sil_before": [
   234.799501,
   244.418866
  ],
  "sil_after": [
   248.577324,
   259.446961
  ],
  "i": 39,
  "text": "So picture how much demand is left for an engineer who only wants to sit there and code."
 },
 {
  "start": 259.446961,
  "end": 260.357846,
  "sil_before": [
   248.577324,
   259.446961
  ],
  "sil_after": [
   260.357846,
   261.283968
  ],
  "i": 40,
  "text": "code got cheap."
 },
 {
  "start": 261.283968,
  "end": 262.220862,
  "sil_before": [
   260.357846,
   261.283968
  ],
  "sil_after": [
   262.220862,
   267.829252
  ],
  "i": 41,
  "text": "but outcomes didn't."
 },
 {
  "start": 267.829252,
  "end": 272.264943,
  "sil_before": [
   262.220862,
   267.829252
  ],
  "sil_after": [
   272.264943,
   282.766576
  ],
  "i": 42,
  "text": "A company doesn't pay you for the code. It pays you for what the code does to the business."
 },
 {
  "start": 282.766576,
  "end": 284.736395,
  "sil_before": [
   272.264943,
   282.766576
  ],
  "sil_after": [
   284.736395,
   287.729002
  ],
  "i": 43,
  "text": "Here's how software has usually been built."
 },
 {
  "start": 287.729002,
  "end": 290.072925,
  "sil_before": [
   284.736395,
   287.729002
  ],
  "sil_after": [
   290.072925,
   290.606508
  ],
  "i": 44,
  "text": "Engineers work in a pod inside their company."
 },
 {
  "start": 290.606508,
  "end": 294.154717,
  "sil_before": [
   290.072925,
   290.606508
  ],
  "sil_after": [
   294.154717,
   306.35805
  ],
  "i": 45,
  "text": "A small cross-functional team, typically of 10 people or fewer."
 },
 {
  "start": 306.35805,
  "end": 309.889546,
  "sil_before": [
   294.154717,
   306.35805
  ],
  "sil_after": [
   309.889546,
   316.688435
  ],
  "i": 46,
  "text": "We're working on one or more steps of a funnel or features of a product."
 },
 {
  "start": 316.688435,
  "end": 322.687166,
  "sil_before": [
   309.889546,
   316.688435
  ],
  "sil_after": [
   322.687166,
   323.325714
  ],
  "i": 47,
  "text": "A typical pod look like this, a front engineer, a backend engineer, a QA engineer, a project manager."
 },
 {
  "start": 323.325714,
  "end": 324.894671,
  "sil_before": [
   322.687166,
   323.325714
  ],
  "sil_after": [
   324.894671,
   328.354218
  ],
  "i": 48,
  "text": "a designer, maybe a marketer."
 },
 {
  "start": 328.354218,
  "end": 330.088526,
  "sil_before": [
   324.894671,
   328.354218
  ],
  "sil_after": [
   330.088526,
   335.844286
  ],
  "i": 49,
  "text": "Six seats, six people."
 },
 {
  "start": 335.844286,
  "end": 339.526281,
  "sil_before": [
   330.088526,
   335.844286
  ],
  "sil_after": [
   339.526281,
   348.045465
  ],
  "i": 50,
  "text": "Now one single engineer can fill almost all of those seats."
 },
 {
  "start": 348.045465,
  "end": 349.724853,
  "sil_before": [
   339.526281,
   348.045465
  ],
  "sil_after": [
   349.724853,
   350.14263
  ],
  "i": 51,
  "text": "The engineer supplies the goal."
 },
 {
  "start": 350.14263,
  "end": 351.652789,
  "sil_before": [
   349.724853,
   350.14263
  ],
  "sil_after": [
   351.652789,
   352.327959
  ],
  "i": 52,
  "text": "The AI agents do the work."
 },
 {
  "start": 352.327959,
  "end": 354.129796,
  "sil_before": [
   351.652789,
   352.327959
  ],
  "sil_after": [
   354.129796,
   356.252426
  ],
  "i": 53,
  "text": "and the engineer reviews what comes back."
 },
 {
  "start": 356.252426,
  "end": 359.488571,
  "sil_before": [
   354.129796,
   356.252426
  ],
  "sil_after": [
   359.488571,
   415.119546
  ],
  "i": 54,
  "text": "The pod doesn't disappear. One engineer runs the whole pod."
 },
 {
  "start": 415.119546,
  "end": 416.492472,
  "sil_before": [
   359.488571,
   415.119546
  ],
  "sil_after": [
   416.492472,
   416.929388
  ],
  "i": 55,
  "text": "I run a whole company this way."
 },
 {
  "start": 416.929388,
  "end": 420.368231,
  "sil_before": [
   416.492472,
   416.929388
  ],
  "sil_after": [
   420.368231,
   420.713923
  ],
  "i": 56,
  "text": "the research of the scripts to the edits to the reviews."
 },
 {
  "start": 420.713923,
  "end": 424.296213,
  "sil_before": [
   420.368231,
   420.713923
  ],
  "sil_after": [
   424.296213,
   428.405306
  ],
  "i": 57,
  "text": "to the software that we build, to the customer service, pretty much everything."
 },
 {
  "start": 428.405306,
  "end": 431.56068,
  "sil_before": [
   424.296213,
   428.405306
  ],
  "sil_after": [
   431.56068,
   452.483991
  ],
  "i": 58,
  "text": "Just one person directing a whole bunch of agents."
 },
 {
  "start": 452.483991,
  "end": 454.941837,
  "sil_before": [
   431.56068,
   452.483991
  ],
  "sil_after": [
   454.941837,
   457.962268
  ],
  "i": 59,
  "text": "And when you run the whole pod, you own a piece of the business."
 },
 {
  "start": 457.962268,
  "end": 462.437642,
  "sil_before": [
   454.941837,
   457.962268
  ],
  "sil_after": [
   462.437642,
   476.796145
  ],
  "i": 60,
  "text": "That's why software engineers need to be more business minded nowadays, more entrepreneurial."
 },
 {
  "start": 476.796145,
  "end": 478.623923,
  "sil_before": [
   462.437642,
   476.796145
  ],
  "sil_after": [
   478.623923,
   483.878458
  ],
  "i": 61,
  "text": "So which piece of the business do you own?"
 },
 {
  "start": 483.878458,
  "end": 487.837937,
  "sil_before": [
   478.623923,
   483.878458
  ],
  "sil_after": [
   487.837937,
   515.661882
  ],
  "i": 62,
  "text": "Nowadays there seems to be four versions of an engineer, and each one has a different answer."
 },
 {
  "start": 515.661882,
  "end": 517.094467,
  "sil_before": [
   487.837937,
   515.661882
  ],
  "sil_after": [
   517.094467,
   517.54093
  ],
  "i": 63,
  "text": "To see them, you need one map."
 },
 {
  "start": 517.54093,
  "end": 518.389524,
  "sil_before": [
   517.094467,
   517.54093
  ],
  "sil_after": [
   518.389524,
   518.902268
  ],
  "i": 64,
  "text": "pirate funnel."
 },
 {
  "start": 518.902268,
  "end": 520.442971,
  "sil_before": [
   518.389524,
   518.902268
  ],
  "sil_after": [
   520.442971,
   522.00576
  ],
  "i": 65,
  "text": "A A A R R R"
 },
 {
  "start": 522.00576,
  "end": 525.439909,
  "sil_before": [
   520.442971,
   522.00576
  ],
  "sil_after": [
   525.439909,
   531.446372
  ],
  "i": 66,
  "text": "Awareness, acquisition, activation, retention, referral, and revenue."
 },
 {
  "start": 531.446372,
  "end": 534.112789,
  "sil_before": [
   525.439909,
   531.446372
  ],
  "sil_after": [
   534.112789,
   540.518413
  ],
  "i": 67,
  "text": "It comes from Dave McClure's startup metrics for pirates."
 },
 {
  "start": 540.518413,
  "end": 543.553673,
  "sil_before": [
   534.112789,
   540.518413
  ],
  "sil_after": [
   543.553673,
   582.289002
  ],
  "i": 68,
  "text": "Every customer moves through each of these six steps."
 },
 {
  "start": 582.289002,
  "end": 583.912517,
  "sil_before": [
   543.553673,
   582.289002
  ],
  "sil_after": [
   583.912517,
   584.512086
  ],
  "i": 69,
  "text": "First, the Growth Engineer."
 },
 {
  "start": 584.512086,
  "end": 586.491723,
  "sil_before": [
   583.912517,
   584.512086
  ],
  "sil_after": [
   586.491723,
   589.146327
  ],
  "i": 70,
  "text": "This world has existed for quite a while."
 },
 {
  "start": 589.146327,
  "end": 596.258549,
  "sil_before": [
   586.491723,
   589.146327
  ],
  "sil_after": [
   596.258549,
   603.846236
  ],
  "i": 71,
  "text": "It's a growth marketer and software engineer all in one person. And sometimes a software engineer can be just a front end developer or it can be full stack."
 },
 {
  "start": 603.846236,
  "end": 605.861859,
  "sil_before": [
   596.258549,
   603.846236
  ],
  "sil_after": [
   605.861859,
   606.184898
  ],
  "i": 72,
  "text": "A growth marketer is all about strategy."
 },
 {
  "start": 606.184898,
  "end": 609.969773,
  "sil_before": [
   605.861859,
   606.184898
  ],
  "sil_after": [
   609.969773,
   610.341043
  ],
  "i": 73,
  "text": "bigger picture. A growth hacker is slightly more technical than a growth marketer."
 },
 {
  "start": 610.341043,
  "end": 611.868889,
  "sil_before": [
   609.969773,
   610.341043
  ],
  "sil_after": [
   611.868889,
   612.192698
  ],
  "i": 74,
  "text": "tactics, shorter term growth."
 },
 {
  "start": 612.192698,
  "end": 612.998095,
  "sil_before": [
   611.868889,
   612.192698
  ],
  "sil_after": [
   612.998095,
   613.566803
  ],
  "i": 75,
  "text": "wrap a turnaround."
 },
 {
  "start": 613.566803,
  "end": 617.340952,
  "sil_before": [
   612.998095,
   613.566803
  ],
  "sil_after": [
   617.340952,
   621.274626
  ],
  "i": 76,
  "text": "The Growth Engineer has all of those traits, and they're also a Software Engineer."
 },
 {
  "start": 621.274626,
  "end": 623.112766,
  "sil_before": [
   617.340952,
   621.274626
  ],
  "sil_after": [
   623.112766,
   625.504943
  ],
  "i": 77,
  "text": "They know all six steps of the funnel."
 },
 {
  "start": 625.504943,
  "end": 630.054195,
  "sil_before": [
   623.112766,
   625.504943
  ],
  "sil_after": [
   630.054195,
   630.407347
  ],
  "i": 78,
  "text": "and they work in one or more of them. Landing pages, signups, onboarding, activation."
 },
 {
  "start": 630.407347,
  "end": 631.051066,
  "sil_before": [
   630.054195,
   630.407347
  ],
  "sil_after": [
   631.051066,
   635.895374
  ],
  "i": 79,
  "text": "retention."
 },
 {
  "start": 635.895374,
  "end": 638.835261,
  "sil_before": [
   631.051066,
   635.895374
  ],
  "sil_after": [
   638.835261,
   643.126281
  ],
  "i": 80,
  "text": "Every idea is an experiment and it gets scrapped or scaled."
 },
 {
  "start": 643.126281,
  "end": 646.427324,
  "sil_before": [
   638.835261,
   643.126281
  ],
  "sil_after": [
   646.427324,
   652.335828
  ],
  "i": 81,
  "text": "The outcome they own would be something like signups, subscription, revenue."
 },
 {
  "start": 652.335828,
  "end": 658.537143,
  "sil_before": [
   646.427324,
   652.335828
  ],
  "sil_after": [
   658.537143,
   664.073878
  ],
  "i": 82,
  "text": "I've worked as a growth engineer and the whole job is about getting the product out there and getting the market to say yes."
 },
 {
  "start": 664.073878,
  "end": 665.503991,
  "sil_before": [
   658.537143,
   664.073878
  ],
  "sil_after": [
   665.503991,
   666.599524
  ],
  "i": 83,
  "text": "Second, the product engineer."
 },
 {
  "start": 666.599524,
  "end": 670.636712,
  "sil_before": [
   665.503991,
   666.599524
  ],
  "sil_after": [
   670.636712,
   671.411134
  ],
  "i": 84,
  "text": "They're mostly concerned with features, what the customer actually interacts with inside of the product."
 },
 {
  "start": 671.411134,
  "end": 673.619864,
  "sil_before": [
   670.636712,
   671.411134
  ],
  "sil_after": [
   673.619864,
   681.243832
  ],
  "i": 85,
  "text": "There's a lot of overlap with the growth engineer."
 },
 {
  "start": 681.243832,
  "end": 682.90966,
  "sil_before": [
   673.619864,
   681.243832
  ],
  "sil_after": [
   682.90966,
   689.676032
  ],
  "i": 86,
  "text": "The difference is what they care about most."
 },
 {
  "start": 689.676032,
  "end": 694.555102,
  "sil_before": [
   682.90966,
   689.676032
  ],
  "sil_after": [
   694.555102,
   695.033946
  ],
  "i": 87,
  "text": "The product engineer has to care about the customer, what the customer needs, and above all, retention."
 },
 {
  "start": 695.033946,
  "end": 696.907664,
  "sil_before": [
   694.555102,
   695.033946
  ],
  "sil_after": [
   696.907664,
   704.183129
  ],
  "i": 88,
  "text": "getting the customer to keep using the product."
 },
 {
  "start": 704.183129,
  "end": 706.84551,
  "sil_before": [
   696.907664,
   704.183129
  ],
  "sil_after": [
   706.84551,
   711.898707
  ],
  "i": 89,
  "text": "One company that hires product engineers sums it up."
 },
 {
  "start": 711.898707,
  "end": 715.623537,
  "sil_before": [
   706.84551,
   711.898707
  ],
  "sil_after": [
   715.623537,
   723.400204
  ],
  "i": 90,
  "text": "care more about outcomes and impact than the exact implementation."
 },
 {
  "start": 723.400204,
  "end": 726.33932,
  "sil_before": [
   715.623537,
   723.400204
  ],
  "sil_after": [
   726.33932,
   727.236259
  ],
  "i": 91,
  "text": "Some product engineers even work inside of a client's business."
 },
 {
  "start": 727.236259,
  "end": 728.994558,
  "sil_before": [
   726.33932,
   727.236259
  ],
  "sil_after": [
   728.994558,
   729.692222
  ],
  "i": 92,
  "text": "building their company's product into it."
 },
 {
  "start": 729.692222,
  "end": 731.31941,
  "sil_before": [
   728.994558,
   729.692222
  ],
  "sil_after": [
   731.31941,
   737.310544
  ],
  "i": 93,
  "text": "That's the forward deployed engineer."
 },
 {
  "start": 737.310544,
  "end": 740.117029,
  "sil_before": [
   731.31941,
   737.310544
  ],
  "sil_after": [
   740.117029,
   759.089841
  ],
  "i": 94,
  "text": "If the customer doesn't come back, the feature didn't work."
 },
 {
  "start": 759.089841,
  "end": 759.501995,
  "sil_before": [
   740.117029,
   759.089841
  ],
  "sil_after": [
   759.501995,
   759.917959
  ],
  "i": 95,
  "text": "Third."
 },
 {
  "start": 759.917959,
  "end": 760.995374,
  "sil_before": [
   759.501995,
   759.917959
  ],
  "sil_after": [
   760.995374,
   770.400204
  ],
  "i": 96,
  "text": "The Platform Engineer."
 },
 {
  "start": 770.400204,
  "end": 772.053583,
  "sil_before": [
   760.995374,
   770.400204
  ],
  "sil_after": [
   772.053583,
   772.415102
  ],
  "i": 97,
  "text": "This one might not touch marketing."
 },
 {
  "start": 772.415102,
  "end": 773.479546,
  "sil_before": [
   772.053583,
   772.415102
  ],
  "sil_after": [
   773.479546,
   774.889478
  ],
  "i": 98,
  "text": "or the product at all."
 },
 {
  "start": 774.889478,
  "end": 780.462971,
  "sil_before": [
   773.479546,
   774.889478
  ],
  "sil_after": [
   780.462971,
   783.448209
  ],
  "i": 99,
  "text": "They work on something internal, the systems, the backend of the company, the platform every other team builds on."
 },
 {
  "start": 783.448209,
  "end": 787.749025,
  "sil_before": [
   780.462971,
   783.448209
  ],
  "sil_after": [
   787.749025,
   791.715533
  ],
  "i": 100,
  "text": "Their customers are inside the company, the application developers, the data scientists."
 },
 {
  "start": 791.715533,
  "end": 796.896145,
  "sil_before": [
   787.749025,
   791.715533
  ],
  "sil_after": [
   796.896145,
   803.52127
  ],
  "i": 101,
  "text": "A few platform teams serve many product teams, and that's why a platform team can have a product manager of its own."
 },
 {
  "start": 803.52127,
  "end": 806.88229,
  "sil_before": [
   796.896145,
   803.52127
  ],
  "sil_after": [
   806.88229,
   816.9622
  ],
  "i": 102,
  "text": "And the outcome is that they own the company's speed, reliability, and cost."
 },
 {
  "start": 816.9622,
  "end": 819.565261,
  "sil_before": [
   806.88229,
   816.9622
  ],
  "sil_after": [
   819.565261,
   820.047619
  ],
  "i": 103,
  "text": "Their customer sits inside the company and."
 },
 {
  "start": 820.047619,
  "end": 820.890159,
  "sil_before": [
   819.565261,
   820.047619
  ],
  "sil_after": [
   820.890159,
   826.304218
  ],
  "i": 104,
  "text": "is still a customer."
 },
 {
  "start": 826.304218,
  "end": 828.614014,
  "sil_before": [
   820.890159,
   826.304218
  ],
  "sil_after": [
   828.614014,
   829.31907
  ],
  "i": 105,
  "text": "And fourth, the GTM engineer."
 },
 {
  "start": 829.31907,
  "end": 830.878073,
  "sil_before": [
   828.614014,
   829.31907
  ],
  "sil_after": [
   830.878073,
   831.389184
  ],
  "i": 106,
  "text": "GTM means go to market."
 },
 {
  "start": 831.389184,
  "end": 833.52483,
  "sil_before": [
   830.878073,
   831.389184
  ],
  "sil_after": [
   833.52483,
   834.730431
  ],
  "i": 107,
  "text": "This is a software engineer who works with sales."
 },
 {
  "start": 834.730431,
  "end": 837.576417,
  "sil_before": [
   833.52483,
   834.730431
  ],
  "sil_after": [
   837.576417,
   838.738617
  ],
  "i": 108,
  "text": "Clay, the company that says I coined the term in 2023."
 },
 {
  "start": 838.738617,
  "end": 842.405828,
  "sil_before": [
   837.576417,
   838.738617
  ],
  "sil_after": [
   842.405828,
   842.808866
  ],
  "i": 109,
  "text": "defines the work as building automated revenue systems using AI."
 },
 {
  "start": 842.808866,
  "end": 843.648776,
  "sil_before": [
   842.405828,
   842.808866
  ],
  "sil_after": [
   843.648776,
   843.95737
  ],
  "i": 110,
  "text": "Data enrichment."
 },
 {
  "start": 843.95737,
  "end": 845.128118,
  "sil_before": [
   843.648776,
   843.95737
  ],
  "sil_after": [
   845.128118,
   854.610816
  ],
  "i": 111,
  "text": "and workflow automation."
 },
 {
  "start": 854.610816,
  "end": 857.998639,
  "sil_before": [
   845.128118,
   854.610816
  ],
  "sil_after": [
   857.998639,
   862.224014
  ],
  "i": 112,
  "text": "There's some overlap with both their engineer, but they work in different systems."
 },
 {
  "start": 862.224014,
  "end": 866.181338,
  "sil_before": [
   857.998639,
   862.224014
  ],
  "sil_after": [
   866.181338,
   866.766145
  ],
  "i": 113,
  "text": "The CRM, which is a sales team's customer database, like Salesforce."
 },
 {
  "start": 866.766145,
  "end": 869.258617,
  "sil_before": [
   866.181338,
   866.766145
  ],
  "sil_after": [
   869.258617,
   873.639615
  ],
  "i": 114,
  "text": "plus outbound email and the sales pipeline."
 },
 {
  "start": 873.639615,
  "end": 876.624966,
  "sil_before": [
   869.258617,
   873.639615
  ],
  "sil_after": [
   876.624966,
   885.760476
  ],
  "i": 115,
  "text": "Growth owns the funnel, GTM owns the pipeline."
 },
 {
  "start": 885.760476,
  "end": 890.78585,
  "sil_before": [
   876.624966,
   885.760476
  ],
  "sil_after": [
   890.78585,
   891.190794
  ],
  "i": 116,
  "text": "So look at the whole map. Four engineers, not one of them is defined by a programming language or framework."
 },
 {
  "start": 891.190794,
  "end": 893.160045,
  "sil_before": [
   890.78585,
   891.190794
  ],
  "sil_after": [
   893.160045,
   900.08551
  ],
  "i": 117,
  "text": "Each one is defined by the outcome that they own."
 },
 {
  "start": 900.08551,
  "end": 905.072381,
  "sil_before": [
   893.160045,
   900.08551
  ],
  "sil_after": [
   905.072381,
   905.591655
  ],
  "i": 118,
  "text": "And if that was a bit complex, feel free to push the J key on your computer to go back a couple times."
 },
 {
  "start": 905.591655,
  "end": 906.78322,
  "sil_before": [
   905.072381,
   905.591655
  ],
  "sil_after": [
   906.78322,
   919.587619
  ],
  "i": 119,
  "text": "just to watch that over again."
 },
 {
  "start": 919.587619,
  "end": 920.912245,
  "sil_before": [
   906.78322,
   919.587619
  ],
  "sil_after": [
   920.912245,
   922.379184
  ],
  "i": 120,
  "text": "Now here's what the market says."
 },
 {
  "start": 922.379184,
  "end": 924.052472,
  "sil_before": [
   920.912245,
   922.379184
  ],
  "sil_after": [
   924.052472,
   924.53424
  ],
  "i": 121,
  "text": "Software jobs aren't disappearing."
 },
 {
  "start": 924.53424,
  "end": 928.351406,
  "sil_before": [
   924.052472,
   924.53424
  ],
  "sil_after": [
   928.351406,
   930.795782
  ],
  "i": 122,
  "text": "On Indeed, software development postings are up around 24% in a year."
 },
 {
  "start": 930.795782,
  "end": 931.998798,
  "sil_before": [
   928.351406,
   930.795782
  ],
  "sil_after": [
   931.998798,
   932.62254
  ],
  "i": 123,
  "text": "But look at where the growth went."
 },
 {
  "start": 932.62254,
  "end": 938.302086,
  "sil_before": [
   931.998798,
   932.62254
  ],
  "sil_after": [
   938.302086,
   938.756689
  ],
  "i": 124,
  "text": "71% of the increase went to senior roles and entry level jobs are only 4.5%."
 },
 {
  "start": 938.756689,
  "end": 940.032902,
  "sil_before": [
   938.302086,
   938.756689
  ],
  "sil_after": [
   940.032902,
   947.358889
  ],
  "i": 125,
  "text": "of software postings."
 },
 {
  "start": 947.358889,
  "end": 949.86424,
  "sil_before": [
   940.032902,
   947.358889
  ],
  "sil_after": [
   949.86424,
   950.873673
  ],
  "i": 126,
  "text": "The government's 10-year outlook draws the same line."
 },
 {
  "start": 950.873673,
  "end": 953.999002,
  "sil_before": [
   949.86424,
   950.873673
  ],
  "sil_after": [
   953.999002,
   960.675828
  ],
  "i": 127,
  "text": "The Bureau of Labor Statistics splits this into two jobs."
 },
 {
  "start": 960.675828,
  "end": 961.683673,
  "sil_before": [
   953.999002,
   960.675828
  ],
  "sil_after": [
   961.683673,
   962.310544
  ],
  "i": 128,
  "text": "computer programmers."
 },
 {
  "start": 962.310544,
  "end": 964.521247,
  "sil_before": [
   961.683673,
   962.310544
  ],
  "sil_after": [
   964.521247,
   965.074286
  ],
  "i": 129,
  "text": "people who write modifying test code."
 },
 {
  "start": 965.074286,
  "end": 966.725692,
  "sil_before": [
   964.521247,
   965.074286
  ],
  "sil_after": [
   966.725692,
   967.630045
  ],
  "i": 130,
  "text": "projected to sink 7%."
 },
 {
  "start": 967.630045,
  "end": 968.753288,
  "sil_before": [
   966.725692,
   967.630045
  ],
  "sil_after": [
   968.753288,
   969.835397
  ],
  "i": 131,
  "text": "by 2035."
 },
 {
  "start": 969.835397,
  "end": 972.187551,
  "sil_before": [
   968.753288,
   969.835397
  ],
  "sil_after": [
   972.187551,
   972.65737
  ],
  "i": 132,
  "text": "Software developers, people who design software."
 },
 {
  "start": 972.65737,
  "end": 974.626871,
  "sil_before": [
   972.187551,
   972.65737
  ],
  "sil_after": [
   974.626871,
   977.988571
  ],
  "i": 133,
  "text": "projected to grow 10%."
 },
 {
  "start": 977.988571,
  "end": 979.494943,
  "sil_before": [
   974.626871,
   977.988571
  ],
  "sil_after": [
   979.494943,
   979.841791
  ],
  "i": 134,
  "text": "The demand didn't disappear."
 },
 {
  "start": 979.841791,
  "end": 980.750295,
  "sil_before": [
   979.494943,
   979.841791
  ],
  "sil_after": [
   980.750295,
   988.307279
  ],
  "i": 135,
  "text": "It just moved."
 },
 {
  "start": 988.307279,
  "end": 989.371338,
  "sil_before": [
   980.750295,
   988.307279
  ],
  "sil_after": [
   989.371338,
   989.688889
  ],
  "i": 136,
  "text": "Now, teenagers."
 },
 {
  "start": 989.688889,
  "end": 991.058481,
  "sil_before": [
   989.371338,
   989.688889
  ],
  "sil_after": [
   991.058481,
   991.477959
  ],
  "i": 137,
  "text": "who haven't entered the market yet."
 },
 {
  "start": 991.477959,
  "end": 993.281497,
  "sil_before": [
   991.058481,
   991.477959
  ],
  "sil_after": [
   993.281497,
   993.885102
  ],
  "i": 138,
  "text": "I think they'll come with his mindset already."
 },
 {
  "start": 993.885102,
  "end": 995.331723,
  "sil_before": [
   993.281497,
   993.885102
  ],
  "sil_after": [
   995.331723,
   998.152834
  ],
  "i": 139,
  "text": "Adapting is easier for them."
 },
 {
  "start": 998.152834,
  "end": 1000.320907,
  "sil_before": [
   995.331723,
   998.152834
  ],
  "sil_after": [
   1000.320907,
   1002.57966
  ],
  "i": 140,
  "text": "but they're walking into fewer junior openings."
 },
 {
  "start": 1002.57966,
  "end": 1006.013628,
  "sil_before": [
   1000.320907,
   1002.57966
  ],
  "sil_after": [
   1006.013628,
   1007.142766
  ],
  "i": 141,
  "text": "A Stanford study found that in the jobs most exposed to AI..."
 },
 {
  "start": 1007.142766,
  "end": 1012.342177,
