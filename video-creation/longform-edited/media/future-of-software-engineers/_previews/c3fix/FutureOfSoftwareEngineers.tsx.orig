  { tIn: 473.98, tOut: 477.381, kind: 'container', ref: 'D17', state: 'D17-s2' },
];

// =====================================================================================================================
// 6. TRANSITIONS, exactly TRANSITIONS.md section 5 / TRANSITION-PLAN.json (48 rows). Every row is wired below and
//    reconciled against the COVERS edges at module load (a planned row with no edge, or an edge with no row, throws).
// =====================================================================================================================
const XF = 11;                                                // hand:xfade-scale 0.35 s (0.93 -> 1; charts 0.97 -> 1)
const RECEIPT_VIEW_XF = 9;                                    // a view change inside one receipt: quick 0.3 s cross-fade
const FACE_CUTS: { tc: number; id: 'hand:film-burn'; dir: 'in' | 'out' }[] = [
  { tc: 5.355, id: 'hand:film-burn', dir: 'out' },    // 0:05.4 F1 out -> C5
  { tc: 22.555, id: 'hand:film-burn', dir: 'in' },    // 0:22.6 C6 -> F2
  { tc: 25.955, id: 'hand:film-burn', dir: 'out' },   // 0:26.0 F2 out -> D1
  { tc: 123.322, id: 'hand:film-burn', dir: 'in' },   // 2:03.3 D4 -> F3
  { tc: 125.255, id: 'hand:film-burn', dir: 'out' },  // 2:05.3 F3 out -> D5
  { tc: 250.508, id: 'hand:film-burn', dir: 'in' },   // 4:10.5 C1 GROWTH -> F4
  { tc: 256.741, id: 'hand:film-burn', dir: 'out' },  // 4:16.7 F4 out -> D9
  { tc: 289.741, id: 'hand:film-burn', dir: 'in' },   // 4:49.7 D9 -> F5
  { tc: 292.608, id: 'hand:film-burn', dir: 'out' },  // 4:52.6 F5 out -> D11
  { tc: 317.975, id: 'hand:film-burn', dir: 'in' },   // 5:18.0 C1 PLATFORM -> F6
  { tc: 321.908, id: 'hand:film-burn', dir: 'out' },  // 5:21.9 F6 out -> D12
  { tc: 350.481, id: 'hand:film-burn', dir: 'in' },   // 5:50.5 C1 GTM -> F7
  { tc: 353.481, id: 'hand:film-burn', dir: 'out' },  // 5:53.5 F7 out -> C1 ALL
  { tc: 437.348, id: 'hand:film-burn', dir: 'in' },   // 7:17.3 D15 -> F8
  { tc: 442.281, id: 'hand:film-burn', dir: 'out' },  // 7:22.3 F8 out -> D16
  { tc: 460.181, id: 'hand:film-burn', dir: 'in' },   // 7:40.2 D16 -> F9
  { tc: 465.148, id: 'hand:film-burn', dir: 'out' },  // 7:45.1 F9 out -> D17
];
const XFADES: { tc: number; id: 'hand:xfade-scale' }[] = [   // role container-xfade, 27 cover swaps
  10.85, 33.78, 68.14, 77.6, 84.94, 90.49, 107.31, 129.92, 167.38, 180.34, 194.41, 209.72, 221.7, 235.48, 262.89,
  275.03, 281.97, 304.14, 329.58, 339.35, 368.28, 376.29, 381.39, 385.88, 408.31, 418.07, 433.34,
].map((tc) => ({ tc, id: 'hand:xfade-scale' as const }));
// receipt-motion rows: single-scene camera moves fitted to the view (no sound): 'motion-3d-pan-1-up' (0:20.0 C6-cover),
// 'motion-3d-orbit-2-right-down' (5:29.6 C12-title-date), 'motion-3d-pan-2-left' (6:58.1 C10-headline) -> COVERS `mo`.
// punch-leak row: 'lightleaks-soft-short-5' (2:04.3 F3, peaks ON the join frame 3729, sfx off: the no-SFX ruling).
const LEAK = { id: 'lightleaks-soft-short-5', at: 124.289 };
// TRANSITIONS_WAIVED: melt-rgb-soft-1 — named ONLY in TRANSITIONS.md "Open questions" as the strategist's optional, advised-against
//   marquee for 194.41 if Mike asks; it is not a planned row (TRANSITION-PLAN.json melt budget 0, section 5 has no melt row).

// ---- group the state rows into placements (blocks) and classify every edge ----
type Block = { ref: string; kind: Kind; tIn: number; tOut: number; rows: Cover[]; entry: 'xfade' | 'cut'; tail: number };
const BLOCKS: Block[] = (() => {
  const out: Block[] = [];
  for (const c of COVERS) {
    const last = out[out.length - 1];
    if (last && last.ref === c.ref && Math.abs(last.tOut - c.tIn) < 0.01) {      // STATE SWAP: same placement
      last.rows.push(c); last.tOut = c.tOut;
      if (c.kind === 'deck') last.kind = 'deck';
      continue;
    }
    const contiguous = !!last && Math.abs(last.tOut - c.tIn) < 0.01;
    if (contiguous) last.tail = XF;                                               // held under the incoming fade
    out.push({ ref: c.ref, kind: c.kind, tIn: c.tIn, tOut: c.tOut, rows: [c], entry: contiguous ? 'xfade' : 'cut', tail: 0 });
  }
  return out;
})();
(() => {   // reconcile the comp to TRANSITIONS.md section 5 (throws, so a drift cannot render)
  const near = (a: number, b: number) => Math.abs(a - b) < 0.02;
  const swapEdges = BLOCKS.filter((b) => b.entry === 'xfade').map((b) => b.tIn);
  for (const e of swapEdges) if (!XFADES.some((x) => near(x.tc, e))) throw new Error(`cover swap at ${e}s has no container-xfade row`);
  for (const x of XFADES) if (!swapEdges.some((e) => near(x.tc, e))) throw new Error(`container-xfade ${x.tc}s has no cover swap`);
  const faceEdges = FACE_WINDOWS.flatMap(([a, b]) => [a, b]).filter((t) => t > 0.01);
  for (const e of faceEdges) if (!FACE_CUTS.some((c) => near(c.tc, e))) throw new Error(`face edge ${e}s has no film-burn row`);
  if (FACE_CUTS.length !== faceEdges.length) throw new Error('film-burn rows != face edges');
  for (const b of BLOCKS) if (b.entry === 'cut' && !FACE_WINDOWS.some(([, z]) => near(z, b.tIn))) throw new Error(`cover ${b.ref} at ${b.tIn}s neither swaps nor follows a face`);
})();

// =====================================================================================================================
// helpers: easing, camera rects (stage px, {x, y, w}, h = w * 9/16), the 1920x1080 stage box
// =====================================================================================================================
const clamp01 = (x: number) => Math.max(0, Math.min(1, x));
const ramp = (t: number, at: number, dur: number) => (dur <= 0 ? (t >= at ? 1 : 0) : clamp01((t - at) / dur));
const easeOut = (p: number) => 1 - Math.pow(1 - p, 3);
const easeInOut = (p: number) => (p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2);
const mix = (a: number, b: number, p: number) => a + (b - a) * p;
type Rect = [number, number, number];                        // x, y, w (stage px)
type CamKey = { t: number; r: Rect; e?: 'out' | 'inout' };
const camAt = (keys: CamKey[], t: number): Rect => {
  if (t <= keys[0].t) return keys[0].r;
  for (let i = 1; i < keys.length; i++) {
    const a = keys[i - 1], b = keys[i];
    if (t < b.t) {
      const p0 = (t - a.t) / (b.t - a.t);
      const p = b.e === 'out' ? easeOut(p0) : easeInOut(p0);
      return [mix(a.r[0], b.r[0], p), mix(a.r[1], b.r[1], p), mix(a.r[2], b.r[2], p)];
    }
  }
  return keys[keys.length - 1].r;
};
const shrink = (r: Rect, d: number): Rect => {               // a slow drift inside a camera: the same centre, 1/d wide
  const h = (r[2] * 9) / 16, cx = r[0] + r[2] / 2, cy = r[1] + h / 2, w = r[2] / d;
  return [cx - w / 2, cy - (w * 9) / 32, w];
};
/** The stage box with a camera rect applied: s = 1920 / w, translate(-x s, -y s) scale(s), origin 0 0 (_state-cues.md). */
const Stage: React.FC<{ cam: Rect; children: React.ReactNode }> = ({ cam, children }) => {
  const s = 1920 / cam[2];
  return (
    <AbsoluteFill style={{ overflow: 'hidden', background: '#0a0c10' }}>
      <div style={{ position: 'absolute', left: 0, top: 0, width: 1920, height: 1080, transformOrigin: '0 0', isolation: 'isolate',
                    transform: `translate(${-cam[0] * s}px, ${-cam[1] * s}px) scale(${s})` }}>
        {children}
      </div>
    </AbsoluteFill>
  );
};
const fullImg = { position: 'absolute', left: 0, top: 0, width: 1920, height: 1080 } as const;

// =====================================================================================================================
// 5. CONTAINERS: the D cards (state PNGs from the slide-builder, hard swaps on identical pixels, SPOTLIGHT one point at a
//    time, FILL THE FRAME) + a slow push 1.00 -> 1.02 over each placement (never dead still).
// =====================================================================================================================
const stateAt = (b: Block, t: number) => {
  let s = b.rows[0].state;
  for (const r of b.rows) if (t >= r.tIn - 1e-6) s = r.state;
  return s;
};
const CardBlock: React.FC<{ c: Block }> = ({ c }) => {
  const t = useSrcT();
  const push = mix(1, 1.02, easeInOut(ramp(t, c.tIn, c.tOut - c.tIn)));
  return (
    <AbsoluteFill style={{ background: '#0a0c10', overflow: 'hidden' }}>
      <AbsoluteFill style={{ transform: `scale(${push})` }}>
        <Img src={staticFile(`card-slides/${stateAt(c, t)}.png`)} style={fullImg} />
      </AbsoluteFill>
    </AbsoluteFill>
  );
};

// =====================================================================================================================
// 5 / 7a. SYSTEM-DESIGN DIAGRAMS C1 + C2: pixel-locked state stills, every swap a SPOTLIGHT move over shared pixels
//    (assets/diagrams/_state-cues.md: cross-fade 0.3 s · stepped mask, each new strip fading in 0.15 s · region box 0.25 s),
//    never a redraw; every hold pushes (C1) or drifts inside its camera (C2).
// =====================================================================================================================
type Op =
  | { k: 'base'; img: string }
  | { k: 'xf'; img: string; at: number; dur: number }
  | { k: 'pulse'; img: string; at: number; up: number; holdTo: number; down: number }
  | { k: 'lr'; img: string; at: number[]; edges: number[] }
  | { k: 'tb'; img: string; xs: [number, number]; at: number[]; edges: number[] }
  | { k: 'box'; img: string; boxes: [number, number, number, number, number][] }
  | { k: 'wipeUp'; img: string; at: number; end: number; y0: number; y1: number };
const STRIP = 0.15, BOX_FADE = 0.25, PAD = 4;
const opStart = (o: Op) => (o.k === 'base' ? -Infinity : o.k === 'lr' || o.k === 'tb' ? o.at[0] : o.k === 'box' ? o.boxes[0][4] : o.at);
const opFull = (o: Op, t: number) =>     // does this op cover the whole frame (opaque) at t? (pixel contract: B == A outside a mask)
  o.k === 'base' || (o.k === 'xf' && t >= o.at + o.dur) || (o.k === 'lr' && t >= o.at[o.at.length - 1] + STRIP)
  || (o.k === 'wipeUp' && t >= o.end + 0.05);
const diagSrc = (img: string) => staticFile(`diagrams/${img}.png`);
const OpLayer: React.FC<{ o: Op; t: number }> = ({ o, t }) => {
  switch (o.k) {
    case 'base': return <Img src={diagSrc(o.img)} style={fullImg} />;
    case 'xf': return <Img src={diagSrc(o.img)} style={{ ...fullImg, opacity: ramp(t, o.at, o.dur) }} />;
    case 'pulse': {
      const a = t < o.holdTo ? ramp(t, o.at, o.up) : 1 - ramp(t, o.holdTo, o.down);
      return a > 0 ? <Img src={diagSrc(o.img)} style={{ ...fullImg, opacity: a }} /> : null;
    }
    case 'lr': return <>{o.at.map((at, i) => {
      const a = ramp(t, at, STRIP); if (a <= 0) return null;
      const x0 = i ? o.edges[i - 1] : 0, x1 = o.edges[i];
      return <Img key={i} src={diagSrc(o.img)} style={{ ...fullImg, opacity: a, clipPath: `inset(0px ${1920 - x1}px 0px ${x0}px)` }} />;
    })}</>;
    case 'tb': return <>{o.at.map((at, i) => {
      const a = ramp(t, at, STRIP); if (a <= 0) return null;
      const y0 = i ? o.edges[i - 1] : 0, y1 = o.edges[i];
      return <Img key={i} src={diagSrc(o.img)} style={{ ...fullImg, opacity: a, clipPath: `inset(${y0}px ${1920 - o.xs[1]}px ${1080 - y1}px ${o.xs[0]}px)` }} />;
    })}</>;
    case 'box': return <>{o.boxes.map(([x0, y0, x1, y1, at], i) => {
      const a = ramp(t, at, BOX_FADE); if (a <= 0) return null;
      return <Img key={i} src={diagSrc(o.img)} style={{ ...fullImg, opacity: a, clipPath: `inset(${y0 - PAD}px ${1920 - x1 - PAD}px ${1080 - y1 - PAD}px ${x0 - PAD}px)` }} />;
    })}</>;
    case 'wipeUp': {
      if (t < o.at) return null;
      const edge = mix(o.y0, o.y1, easeOut(ramp(t, o.at, o.end - o.at)));
      return <Img src={diagSrc(o.img)} style={{ ...fullImg, clipPath: `inset(${edge}px 0px 0px 0px)` }} />;
    }
  }
};
const OpStack: React.FC<{ ops: Op[]; t: number }> = ({ ops, t }) => {
  const live = ops.filter((o) => opStart(o) <= t);
  let from = 0;
  live.forEach((o, i) => { if (opFull(o, t)) from = i; });
  return <>{live.slice(from).map((o, i) => <OpLayer key={from + i} o={o} t={t} />)}</>;
};

// C1 · the pirate funnel map, one program per placement (state cues word-checked in _state-cues.md)
const SLICE_EDGES = [329, 541, 753, 965, 1177, 1920];
type C1Place = { tIn: number; ops: Op[]; push: [number, number, number] };   // push: cx, cy, to-scale
const C1_PLACES: C1Place[] = [
  { tIn: 194.41, push: [750, 560, 1.03], ops: [   // FUNNEL
    { k: 'base', img: 'C1-funnel-outline' },
    { k: 'xf', img: 'C1-funnel-title', at: 196.46, dur: 0.3 },
    { k: 'lr', img: 'C1-funnel-letters', at: [197.4, 198.14, 198.34, 198.66, 198.92, 199.18], edges: SLICE_EDGES },
    { k: 'lr', img: 'C1-funnel-names', at: [199.86, 200.32, 201.12, 201.76, 202.34, 202.9], edges: SLICE_EDGES },
    { k: 'xf', img: 'C1-funnel', at: 204.0, dur: 0.3 },
  ] },
  { tIn: 235.48, push: [430, 420, 1.03], ops: [   // GROWTH
    { k: 'base', img: 'C1-funnel' },
    { k: 'pulse', img: 'C1-funnel-glow', at: 236.02, up: 0.25, holdTo: 236.8, down: 0.4 },
    { k: 'xf', img: 'C1-growth-bracket', at: 237.8, dur: 0.3 },
    { k: 'lr', img: 'C1-growth-tags', at: [239.6, 240.52, 241.18, 241.8, 242.8], edges: [302, 422, 586, 760, 1920] },
    { k: 'lr', img: 'C1-growth-test', at: [243.76, 245.8, 246.42], edges: [395, 535, 1920] },
    { k: 'lr', img: 'C1-growth', at: [248.6, 249.9], edges: [760, 1920] },
  ] },
  { tIn: 262.89, push: [860, 500, 1.03], ops: [   // PRODUCT
    { k: 'base', img: 'C1-product-bracket' },
    { k: 'xf', img: 'C1-product-overlap', at: 263.84, dur: 0.3 },
    { k: 'xf', img: 'C1-product-customer', at: 269.38, dur: 0.3 },
    { k: 'xf', img: 'C1-product-retention', at: 272.02, dur: 0.35 },
    { k: 'xf', img: 'C1-product', at: 272.98, dur: 0.3 },
  ] },
  { tIn: 304.14, push: [750, 760, 1.03], ops: [   // PLATFORM
    { k: 'base', img: 'C1-platform-floor' },
    { k: 'lr', img: 'C1-platform-customers', at: [306.46, 307.78], edges: [633, 1920] },
    { k: 'wipeUp', img: 'C1-platform-arrows', at: 310.02, end: 310.52, y0: 852, y1: 690 },
    { k: 'xf', img: 'C1-platform-pm', at: 312.98, dur: 0.3 },
    { k: 'lr', img: 'C1-platform', at: [316.34, 316.5, 317.48], edges: [1156, 1300, 1920] },
  ] },
  { tIn: 339.35, push: [1500, 520, 1.03], ops: [  // GTM
    { k: 'base', img: 'C1-gtm-lane' },
    { k: 'tb', img: 'C1-gtm', xs: [1440, 1800], at: [343.4, 344.64, 348.08, 349.52], edges: [460, 516, 592, 1080] },
  ] },
  { tIn: 353.481, push: [960, 560, 1.025], ops: [ // ALL (the finished map, shown once)
    { k: 'base', img: 'C1-all-base' },
    { k: 'xf', img: 'C1-all', at: 359.06, dur: 0.4 },
  ] },
];
// FUNNEL: the comp-drawn customer dot, (96, 668) -> the six slice centres, + the travelling C1-funnel-glow spotlight
const DOT_IN = 206.76;
const DOT_HOPS: [number, number][] = [[96, 206.76], [223, 207.0], [435, 207.45], [647, 207.9], [859, 208.35], [1071, 208.8], [1283, 209.25]];
const SLICE_CENTRES = [223, 435, 647, 859, 1071, 1283];
const dotX = (t: number) => {
  for (let i = 1; i < DOT_HOPS.length; i++) {
    const [x0, t0] = DOT_HOPS[i - 1], [x1, t1] = DOT_HOPS[i];
    if (t < t1) return t < t0 ? x0 : mix(x0, x1, easeInOut((t - t0) / (t1 - t0)));
  }
  return DOT_HOPS[DOT_HOPS.length - 1][0];
};
const CustomerDot: React.FC<{ t: number }> = ({ t }) => {
  if (t < DOT_IN) return null;
  const a = ramp(t, DOT_IN, 0.2);
  const x = dotX(t);
  return (
    <>
      {SLICE_CENTRES.map((cx, i) => {
        const w = clamp01(1 - Math.abs(x - cx) / 160) * 0.6 * a;
        if (w <= 0.01) return null;
        const x0 = 120 + 212 * i, x1 = x0 + 206;
        return <Img key={i} src={diagSrc('C1-funnel-glow')} style={{ ...fullImg, opacity: w, clipPath: `inset(0px ${1920 - x1}px 0px ${x0}px)` }} />;
      })}
      <svg width={1920} height={1080} style={{ ...fullImg, overflow: 'visible' }}>
        <circle cx={x} cy={668} r={20} fill="rgba(0,230,138,.35)" opacity={a} />
        <circle cx={x} cy={668} r={9} fill="#e8eaf0" opacity={a} />
      </svg>
    </>
  );
};
// ALL: label pulses 1, 2, 3, 4 (comp spotlight ring r 22, 2.5 px #00e68a, glow, label box padded 10; in 0.12 s, out 0.35 s)
const RINGS: [number, number, number, number, number][] = [
  [120, 206, 473, 242, 355.02], [810, 206, 1172, 242, 355.32], [142, 863, 521, 899, 355.62], [1440, 206, 1724, 242, 355.92],
];
const LabelRings: React.FC<{ t: number }> = ({ t }) => (
  <>{RINGS.map(([x0, y0, x1, y1, at], i) => {
    const a = t < at + 0.12 ? ramp(t, at, 0.12) : 1 - ramp(t, at + 0.12, 0.35);
    if (a <= 0) return null;
    return <div key={i} style={{ position: 'absolute', left: x0 - 10, top: y0 - 10, width: x1 - x0 + 20, height: y1 - y0 + 20, borderRadius: 22,
      border: '2.5px solid #00e68a', boxShadow: '0 0 24px rgba(0,230,138,.5)', boxSizing: 'border-box', opacity: a }} />;
  })}</>
);
const C1Block: React.FC<{ c: Block }> = ({ c }) => {
  const t = useSrcT();
  const place = C1_PLACES.find((p) => Math.abs(p.tIn - c.tIn) < 0.01);
  if (!place) throw new Error(`C1 placement at ${c.tIn}s has no program`);
  const [cx, cy, to] = place.push;
  const s = mix(1, to, easeInOut(ramp(t, c.tIn, c.tOut - c.tIn)));
  return (
    <AbsoluteFill style={{ overflow: 'hidden', background: '#0a0c10' }}>
      <div style={{ ...fullImg, transformOrigin: `${cx}px ${cy}px`, transform: `scale(${s})` }}>
        <OpStack ops={place.ops} t={t} />
        {place.tIn === 194.41 && <CustomerDot t={t} />}
        {place.tIn === 353.481 && <LabelRings t={t} />}
      </div>
    </AbsoluteFill>
  );
};

// C2 · the pod, then and now: 4320x2430 stills (the stage at 2.25x) rendered into a 1920x1080 box + the camera rects
const CAM_LEFT: Rect = [80, 304.8, 870], CAM_RIGHT: Rect = [970, 304.8, 870], CAM_FULL: Rect = [0, 0, 1920];
const C2_OPS: Op[] = [
  { k: 'base', img: 'C2-empty' },
  { k: 'tb', img: 'C2-scope', xs: [100, 930], at: [135.78, 139.32], edges: [420, 1080] },
  { k: 'box', img: 'C2-seats', boxes: [
    [137, 463, 383, 571, 144.78], [393, 463, 639, 571, 145.82], [649, 463, 895, 571, 146.84],
    [137, 581, 383, 689, 148.22], [393, 581, 639, 689, 149.84], [649, 581, 895, 689, 150.74]] },
  { k: 'xf', img: 'C2-then', at: 151.6, dur: 0.3 },
  { k: 'xf', img: 'C2-now-base', at: 153.58, dur: 0.4 },
  { k: 'xf', img: 'C2-goal', at: 158.18, dur: 0.3 },
  { k: 'xf', img: 'C2-agents', at: 159.92, dur: 0.3 },
  { k: 'xf', img: 'C2-now', at: 162.54, dur: 0.3 },
  { k: 'xf', img: 'C2-dim', at: 163.98, dur: 0.8 },
  { k: 'xf', img: 'C2-final', at: 165.6, dur: 0.3 },
];
// holds drift 1.00 -> 1.015 inside the current camera; moves ease in-out (cubic): LEFT -> RIGHT 153.40 -> 154.25,
// RIGHT -> FULL 163.98 -> 164.78
const C2_HOLDS: { cam: Rect; a: number; b: number }[] = [
  { cam: CAM_LEFT, a: 129.92, b: 153.4 }, { cam: CAM_RIGHT, a: 154.25, b: 163.98 }, { cam: CAM_FULL, a: 164.78, b: 167.38 },
];
const C2_DRIFT = 1.015;
const c2Cam = (t: number): Rect => {
  for (let i = 0; i < C2_HOLDS.length; i++) {
    const h = C2_HOLDS[i];
    if (t < h.a && i > 0) {
      const prev = C2_HOLDS[i - 1];
      const p = easeInOut(ramp(t, prev.b, h.a - prev.b));
      const r0 = shrink(prev.cam, C2_DRIFT);
      return [mix(r0[0], h.cam[0], p), mix(r0[1], h.cam[1], p), mix(r0[2], h.cam[2], p)];
    }
    if (t < h.b || i === C2_HOLDS.length - 1) return shrink(h.cam, mix(1, C2_DRIFT, easeInOut(ramp(t, h.a, h.b - h.a))));
  }
  return CAM_FULL;
};
const C2Block: React.FC = () => {
  const t = useSrcT();
  return <Stage cam={c2Cam(t)}><OpStack ops={C2_OPS} t={t} /></Stage>;
};

// =====================================================================================================================
// RECEIPTS (real-site captures, 3840x2160 = the 1920x1080 frame at 2x; rects in frame px from
// _previews/receipt-capture/receipts-geometry.json + the capture itself). Each VIEW = a camera program (settling push
// that STOPS before any highlight; a highlight never lands on a moving camera) + [HIGHLIGHT] rows (#ffe14d, wiping left
// to right over the quoted words, drawn in capture coordinates inside the camera, multiply) OR a library MOTION move.
// =====================================================================================================================
type HL = { at: number; dur: number; rects: [number, number, number, number][] };
type View = { cam: CamKey[]; hl: HL[] };
const VIEWS: Record<string, View> = {
  // C5 Pichai, Cloud Next '26: 'approved by engineers' on "approve" (5.96); both halves stay in frame
  'C5-sentence': { cam: [{ t: 5.355, r: [300, 66, 1350] }, { t: 5.92, r: [397, 120, 1150], e: 'out' }],
    hl: [{ at: 5.96, dur: 0.55, rects: [[1009, 431, 175, 26]] }] },
  // byline 'CEO of Google and Alphabet' on "CEO" (7.96), date 'Apr 22, 2026' on "April" (9.14)
  'C5-header': { cam: [{ t: 7.06, r: [150, 0, 1500] }, { t: 7.9, r: [250, 55, 1300], e: 'out' }],
    hl: [{ at: 7.96, dur: 0.5, rects: [[530, 467, 190, 28]] }, { at: 9.14, dur: 0.4, rects: [[530, 338, 90, 28]] }] },
  // C6 the S-1 'over 90% of the contributions ... written by Claude.' from "over" (13.64) to "Claude." (19.4)
  'C6-sentence': { cam: [{ t: 10.85, r: [110, 0, 1700] }, { t: 13.4, r: [285, 16, 1350], e: 'out' }],
    hl: [{ at: 13.64, dur: 5.76, rects: [[496, 381, 1090, 31]] }] },
  'C6-cover': { cam: [{ t: 20.04, r: [0, 0, 1920] }], hl: [] },                      // lib:motion-3d-pan-1-up
  // C7 the essay: a 1.4 s establishing push toward the intro, then the tight view: 'We are not there yet' (86.88 -> 88.08)
  'C7-title-sentence': { cam: [{ t: 84.94, r: [0, 0, 1920] }, { t: 86.3, r: [102, 124, 1700] }], hl: [] },
  'C7-sentence': { cam: [{ t: 86.3, r: [60, 0, 1800] }, { t: 86.85, r: [150, 0, 1700], e: 'out' }],
    hl: [{ at: 86.88, dur: 1.2, rects: [[909, 319, 288, 38]] }] },
  'C12-title-date': { cam: [{ t: 329.58, r: [0, 0, 1920] }], hl: [] },               // lib:motion-3d-orbit-2-right-down
  // C12 Clay's definition, 'building automated revenue systems using AI, data enrichment, and workflow automation'
  'C12-definition': { cam: [{ t: 332.94, r: [200, 0, 1500] }, { t: 333.8, r: [375, 57, 1150], e: 'out' }],
    hl: [{ at: 333.84, dur: 4.76, rects: [[840, 360, 468, 24], [584, 385, 196, 24]] }] },
  // C9 Indeed's own chart, never restyled: full view, then the push heads for the Senior roles 71% bar from "71%" (378.50)
  'C9-chart': { cam: [{ t: 376.29, r: [0, 0, 1920] }, { t: 378.5, r: [19, 11, 1882] }, { t: 379.8, r: [88, 208, 1250] }], hl: [] },
  'C10-headline': { cam: [{ t: 418.07, r: [0, 0, 1920] }], hl: [] },                 // lib:motion-3d-pan-2-left
  // C10 the six facts: settle on Fact 2 ('about 19% below' on "19" 424.94), then Fact 4 ('reduced hiring of young workers'
  // from "mostly" 431.12 to "hired" 432.72); the camera move ends before each highlight starts
  'C10-reduced-hiring': { cam: [{ t: 422.08, r: [0, 0, 1920] }, { t: 422.9, r: [210, 0, 1500], e: 'out' },
    { t: 430.2, r: [210, 0, 1500] }, { t: 431.05, r: [210, 236, 1500] }],
    hl: [{ at: 424.94, dur: 0.6, rects: [[1031, 355, 263, 36]] }, { at: 431.12, dur: 1.6, rects: [[1180, 666, 362, 38], [382, 713, 126, 36]] }] },
};
const Highlights: React.FC<{ hl: HL[]; t: number }> = ({ hl, t }) => (
  <>{hl.map((h, i) => {
    const total = h.rects.reduce((s, r) => s + r[2], 0);
    let done = easeInOut(ramp(t, h.at, h.dur)) * total;
    if (done <= 0) return null;
    return h.rects.map((r, j) => {
      const w = Math.max(0, Math.min(r[2], done));
      done -= r[2];
      if (w <= 0) return null;
      return <div key={`${i}-${j}`} style={{ position: 'absolute', left: r[0], top: r[1], width: w, height: r[3], background: '#ffe14d', mixBlendMode: 'multiply', borderRadius: 3 }} />;
    });
  })}</>
);
const ReceiptStage: React.FC<{ state: string; t: number; still?: boolean }> = ({ state, t, still }) => {
  const v = VIEWS[state];
  return (
    <Stage cam={still ? [0, 0, 1920] : camAt(v.cam, t)}>
      <Img src={staticFile(`receipts/${state}.png`)} style={fullImg} />
      {!still && <Highlights hl={v.hl} t={t} />}
    </Stage>
  );
};
/** The SCENE a Motion3D move is handed, PRE-FRAMED for that move (QA 2026-11-14). Motion3D wrap-tiles its scene 3x3 and
 * its 3D Pan Left swivels 44 deg, so a full-frame capture showed a second copy of the page at the right edge for the whole
 * view and cut the C10 headline's first half (the plan: "both halves of the headline in frame"); the orbit cut the C12
 * title; the pan-up showed the page's bottom paragraph above its top. Each scene is the planned OBJECT (the capture's own
 * crop, unaltered pixels) on its page colour, placed inside the region the move keeps on screen for its whole fitted run
 * and clear of every wrapped copy: checked with a model of the engine's transform chain
 * (_previews/qa/motion/layout_check.py: min margin to the frame edge 73 / 34 px, 0 wrapped-copy samples on screen). */
type MotionScene = { bg: string; crop: [number, number, number, number]; box: [number, number, number, number]; wrapX?: boolean; fade?: [number, number];
  hide?: [number, number, number, number] };   // hide: a capture region outside the object (painted the page colour)
const MOTION_SCENES: Record<string, MotionScene> = {
  // the S-1 cover page as an object on its own gray; the page fades to that gray below y 780-880 so the pan-up's wrap
  // (scene y -164 at its start = the tile above's bottom) shows gray, never the page's last paragraph
  'C6-cover': { bg: 'rgb(228,228,228)', crop: [0, 0, 1920, 1080], box: [0, 0, 1920, 1080], fade: [780, 880] },
  // the Stanford headline block (date line, the WHOLE headline, tags, the "Canaries" line) on the page's maroon, at 0.731,
  // centred where the pan keeps it (x 1360-2340 crosses the tile seam: drawn twice so the wrap stitches it)
  'C10-headline': { bg: 'rgb(64,20,21)', crop: [300, 320, 1640, 770], box: [1360, 375, 2340, 705], wrapX: true },
  // the Clay post: the Clay mark + nav, the title, the subtitle and the meta row with 'Apr 21, 2026', at 0.543; the
  // page's left INDEX sidebar (x < 250, from y 440) is not part of the object
  'C12-title-date': { bg: '#fff', crop: [60, 0, 1700, 505], box: [530, 381, 1420, 655], hide: [0, 440, 250, 505] },
};
const MotionSceneEl: React.FC<{ state: string }> = ({ state }) => {
  const m = MOTION_SCENES[state];
  const [cx0, cy0, cx1, cy1] = m.crop, [bx0, by0, bx1] = m.box;
  const s = (bx1 - bx0) / (cx1 - cx0);
  const block = (dx: number) => (
    <div key={dx} style={{ position: 'absolute', left: bx0 + dx, top: by0, width: (cx1 - cx0) * s, height: (cy1 - cy0) * s, overflow: 'hidden' }}>
      <Img src={staticFile(`receipts/${state}.png`)} style={{ position: 'absolute', left: -cx0 * s, top: -cy0 * s, width: 1920 * s, height: 1080 * s }} />
      {m.hide && <div style={{ position: 'absolute', left: (m.hide[0] - cx0) * s, top: (m.hide[1] - cy0) * s, width: (m.hide[2] - m.hide[0]) * s, height: (m.hide[3] - m.hide[1]) * s, background: m.bg }} />}
    </div>
  );
  return (
    <AbsoluteFill style={{ background: m.bg, overflow: 'hidden' }}>
      {block(0)}
      {m.wrapX && block(-1920)}
      {m.fade && <div style={{ position: 'absolute', left: 0, top: m.fade[0], width: 1920, height: 1080 - m.fade[0],
        background: `linear-gradient(to bottom, rgba(228,228,228,0) 0px, ${m.bg} ${m.fade[1] - m.fade[0]}px, ${m.bg} 100%)` }} />}
    </AbsoluteFill>
  );
};
/** [MOTION] lib:motion-3d-*: the library Motion3D engine wraps the receipt for its whole view; its 5 s move is fitted
 * to the view (engine frame = view frame * 5 / view seconds), clock set with a Freeze inside a zero-offset Sequence
 * (comp-build.md section 6 MOTION + 6a Freeze trap). No sound. */
const MotionView: React.FC<{ row: Cover; t: number }> = ({ row, t }) => {
  const lib = getTransition(row.mo!);
  if (!lib) throw new Error(`unknown motion id ${row.mo}`);
  if (!MOTION_SCENES[row.state]) throw new Error(`motion view ${row.state} has no pre-framed scene`);
  const Engine = ENGINES[lib.engine] as React.FC<any>;
  const engFrames = Math.round(lib.durationSeconds * FPS);
  const slot = row.tOut - row.tIn;
  const ef = Math.max(0, Math.min(engFrames, Math.round(((t - row.tIn) / slot) * engFrames)));
  return (
    <Sequence from={0} layout="none">
      <Freeze frame={ef}>
        <Engine from={null} to={null} outClip={() => <MotionSceneEl state={row.state} />} durationInFrames={engFrames} params={lib.params} />
      </Freeze>
    </Sequence>
  );
};
const ReceiptBlock: React.FC<{ c: Block }> = ({ c }) => {
  const t = useSrcT();
  // every view whose fade has started; a later view fades in over the earlier one (0.3 s), then the earlier one drops
  const started = c.rows.filter((r, i) => i === 0 || t >= r.tIn);
  let from = 0;
  started.forEach((r, i) => { if (i === 0 || t >= r.tIn + RECEIPT_VIEW_XF / FPS) from = i; });
  return (
    <AbsoluteFill style={{ background: '#fff' }}>
      {started.slice(from).map((r, i) => {
        const a = from + i === 0 ? 1 : ramp(t, r.tIn, RECEIPT_VIEW_XF / FPS);
        return (
          <AbsoluteFill key={r.state} style={{ opacity: a }}>
            {r.mo ? <MotionView row={r} t={t} /> : <ReceiptStage state={r.state} t={t} />}
          </AbsoluteFill>
        );
      })}
    </AbsoluteFill>
  );
};

// =====================================================================================================================
// the COVER element per placement (routes: the two animated charts are LIVE components, never a PNG)
// =====================================================================================================================
const CoverEl: React.FC<{ c: Block }> = ({ c }) => {
  const t = useSrcT();
  if (c.ref === 'C3') return <C3Chart t={t} />;                 // CHART(anim) 1, real useCurrentFrame component
  if (c.ref === 'C4') return <C4Chart t={t} />;                 // CHART(anim) 2, real useCurrentFrame component
  if (c.ref === 'C1') return <C1Block c={c} />;                 // CHART(sysdesign) 1, spotlight moves over state stills
  if (c.ref === 'C2') return <C2Block />;                       // CHART(sysdesign) 2, camera + spotlight moves
  if (c.kind === 'receipt') return <ReceiptBlock c={c} />;
  return <CardBlock c={c} />;
};
/** hand:xfade-scale ingress (container-xfade 0.35 s, 0.93 -> 1; the charts 0.97 -> 1 on their header). A placement that
 * follows a face-out enters at full opacity under the film burn, so the black spine never shows. */
const Placement: React.FC<{ c: Block }> = ({ c }) => {
  const local = useCurrentFrame();
  if (c.entry === 'cut') return <CoverEl c={c} />;
  const p = easeOut(clamp01(local / XF));
  const s0 = c.kind === 'chart' ? 0.97 : 0.93;
  return (
    <AbsoluteFill style={{ opacity: p, transform: `scale(${mix(s0, 1, p)})` }}>
      <CoverEl c={c} />
    </AbsoluteFill>
  );
};

// =====================================================================================================================
// FACE cut in / out = hand:film-burn (the video's ONE face pick): a warm radial flash peaking ON the cut, 0.38 s each
// side, silent; drawn over everything (no captions in this video).
// =====================================================================================================================
const BURN_HALF = 0.38 * FPS;
const FilmBurn: React.FC<{ cut: number; dir: 'in' | 'out' }> = ({ cut, dir }) => {
  const abs = useAbs();
  const x = (abs - cut) / BURN_HALF;
  if (Math.abs(x) >= 1) return null;
  const env = Math.pow(Math.cos((x * Math.PI) / 2), 2);
  const sweep = (x + 1) / 2;                                    // the burn travels across the frame as it flashes
  const cx = dir === 'out' ? mix(22, 70, sweep) : mix(78, 30, sweep);
  return (
    <AbsoluteFill style={{ pointerEvents: 'none' }}>
      <AbsoluteFill style={{ mixBlendMode: 'screen', opacity: 0.82 * env,
        background: `radial-gradient(ellipse 75% 95% at ${cx}% 45%, rgba(255,206,140,0.95) 0%, rgba(255,138,48,0.78) 28%, rgba(196,58,12,0.38) 58%, rgba(0,0,0,0) 86%)` }} />
      <AbsoluteFill style={{ mixBlendMode: 'screen', opacity: 0.55 * env * env,
        background: `radial-gradient(circle at ${100 - cx}% 72%, rgba(255,238,205,0.9) 0%, rgba(255,168,88,0.35) 26%, rgba(0,0,0,0) 52%)` }} />
    </AbsoluteFill>
  );
};

// [LIGHTLEAK] lib:lightleaks-soft-short-5 on the F3 join (comp-build.md section 6a: a Sequence of EXACTLY the engine window,
// cutFrame = win/2 inside it, the continuous spine as A and B, every node muted + reframed, no SFX in the comp). The engine
// swaps at p >= 0.4 (window frame 5) and peaks at 0.16 s (frame ~4.8), so the window opens 5 frames before the join frame.
const LEAK_ROW = getTransition(LEAK.id);
const LEAK_WIN = LEAK_ROW ? Math.round(LEAK_ROW.durationSeconds * FPS) : 12;
const LEAK_FROM = PUNCHES[0].frame - 5;                       // the engine's swap (window frame 5) == the punch frame

// =====================================================================================================================
// the composition
// =====================================================================================================================
export const FutureOfSoftwareEngineers: React.FC = () => {
  const frame = useCurrentFrame();
  return (
    <AbsClock.Provider value={frame}>
      <AbsoluteFill style={{ background: '#000' }}>
        {/* the spine: gated face, COVER spans black, its own VO = the comp's only audio */}
        <SpineView audio />

        {/* F3 punch-in join: library light leak, screen-composited plates over the reframed spine */}
        <Sequence from={LEAK_FROM} durationInFrames={LEAK_WIN} name="punch-leak lightleaks-soft-short-5">
          <TransitionClip id="lightleaks-soft-short-5" cutFrame={Math.round(LEAK_WIN / 2)} sfx={false}
            outgoing={() => <SpineView />} incoming={() => <SpineView />} />
        </Sequence>

        {/* the COVER track: one Sequence per placement; held XF frames under the next cover's fade-in */}
        {BLOCKS.map((c, i) => {
          const lead = EDGE_LEAD[String(c.tIn)] ?? 0;
          const end = i === BLOCKS.length - 1 ? DUR : F(c.tOut) + c.tail;   // the END CARD holds to the very last frame
          return (
            <Sequence key={i} from={F(c.tIn) - lead} durationInFrames={end - F(c.tIn) + lead} name={`${c.ref} ${c.rows[0].state}`}>
              <Placement c={c} />
            </Sequence>
          );
        })}

        {/* FACE cut in / out: hand:film-burn on all 17 face edges */}
        {FACE_CUTS.map((fc) => (
          <Sequence key={fc.tc} from={F(fc.tc) - Math.ceil(BURN_HALF)} durationInFrames={2 * Math.ceil(BURN_HALF) + 1} name={`film-burn ${fc.dir} ${fc.tc}`}>
            <FilmBurn cut={F(fc.tc)} dir={fc.dir} />
          </Sequence>
        ))}
      </AbsoluteFill>
    </AbsClock.Provider>
  );
};
