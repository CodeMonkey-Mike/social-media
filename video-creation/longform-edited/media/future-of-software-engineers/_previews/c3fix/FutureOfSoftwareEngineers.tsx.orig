/**
 * future-of-software-engineers · "Software Engineers Who Only Code Are Running Out of Time" (AI Engineering Simplified)
 * longform-edited 16:9 COMP, built by the comp-builder 2026-11-14 TO the approved blueprint:
 *   EDIT-PLAN.md (event log) · CUE-SHEET.md · TRANSITIONS.md section 5 + TRANSITION-PLAN.json · COVER-PLAN.json ·
 *   AS-RECORDED.md (9 FACE windows) · assets/diagrams/_state-cues.md · assets/slide-sources/_state-cues.md ·
 *   assets/charts/C3.spec.md + C4.spec.md · PROJECT-LOG.md Open flags (FACE 4 blacked out, covered by D18).
 * Skill: video-creation/longform-edited/skills/comp-build/comp-build.md (the skeletons there are the only authority).
 *
 * Mike's per-video rulings (PROJECT-LOG "Hard constraints", 2026-11-13) that shape this file:
 *   CAPTIONS OFF (caption_scope none; CUE-SHEET "CAPTIONS (none)"): the captions module is EMPTY on purpose, no caption
 *     layer is mounted and no cover is `cap: true` (comp-build.md section 8).
 *   NO clip inserts, NO Envato, NO ChatGPT images, NO whiteboard, NO kinetic text, NO title cards (one drone bed).
 *   NO music, NO SFX in the comp (comp-build.md section 9: the post-mix owns audio). NO watermark.
 *
 * Kinds (the gates' vocabulary): 'container' = a spotlight container (the D cards, and the C1 / C2 system-design
 * diagrams' spotlight states), 'deck' = the rich full diagram shown ONCE as the overview (C1 ALL, "THE BALANCE"),
 * 'chart' = a live animated Type 1 chart (C3, C4), 'receipt' = a real-site capture (one row per view).
 * DIAGRAM_REFS: C1, C2
 * (end declared refs)
 */
import React, { createContext, useContext } from 'react';
import {
  AbsoluteFill, Freeze, Img, OffthreadVideo, Sequence, staticFile, useCurrentFrame,
} from 'remotion';
import { ENGINES, getTransition } from './transitions';
import { TransitionClip } from './transitions/TransitionClip';
import { C3Chart, C4Chart } from './FutureOfSoftwareEngineersCharts';
// Captions OFF for this video: imported so the empty module is the visible record; never mounted.
import { ZCAPTIONS, CAPTION_WINDOWS } from './FutureOfSoftwareEngineersCaptions';

// =====================================================================================================================
// 1-2. TIME MODEL (comp-build.md section 2 + 3d): spine/ALL.f.paused.json pauses[] IS the time map.
//      This video's sidecar: pauses = [] (no card ON, no clip insert, no beat pause), pause_s 1.5 -> sh() is the identity.
// =====================================================================================================================
export const FPS = 30;
export const PAUSE = 1.5;                                     // ALL.f.paused.json pause_s (no card uses it)
export const PAUSES: { at: number; dur: number; clip?: string; label?: string }[] = [];   // ALL.f.paused.json pauses[]
export const CARD_T: number[] = [];                           // pauses[].at of the card rows: none (no title card)
export const INSERTS: { at: number; dur: number }[] = [];     // {at, dur} for EVERY pause: none
if (CARD_T.length !== PAUSES.filter((p) => !p.clip).length || INSERTS.length !== PAUSES.length) throw new Error('CARD_T / INSERTS != the sidecar pauses');
export const SPINE_SECS = 477.381;                            // the SOURCE spine spine/ALL.e.enhanced.mp4
export const sh = (t: number) => t + PAUSES.filter((p) => p.at <= t).reduce((s, p) => s + p.dur, 0);   // source -> paused
export const F = (t: number) => Math.round(sh(t) * FPS);                                                // source -> frame
/** paused-spine seconds -> source seconds (inside a pause: frozen on the pause point) */
const unsh = (tp: number) => {
  let off = 0;
  for (const p of [...PAUSES].sort((a, b) => a.at - b.at)) {
    if (tp < p.at + off) break;
    if (tp < p.at + off + p.dur) return p.at;
    off += p.dur;
  }
  return tp - off;
};
// check_spine_fps.py: DUR = ceil(paused-spine duration * fps) = 14322 frames (477.381 s)
export const DUR = Math.ceil((SPINE_SECS + PAUSES.reduce((s, p) => s + p.dur, 0)) * FPS);
// Title-card readability (comp-build.md section 6, Mike 2026-07-25): readable = lead + PAUSE - turn >= 1.0 s for EVERY
// card. This video has NO card (one bed), so the assertion is vacuous; kept so a card added later cannot regress.
const CARD_LEAD = 0.6, CARD_TURN = 11 / FPS;
if (CARD_T.length && CARD_LEAD + PAUSE - CARD_TURN < 1.0) throw new Error('title card readable < 1.0 s');
if (ZCAPTIONS.length || CAPTION_WINDOWS.length) throw new Error('captions are OFF for this video (caption_scope none)');

// =====================================================================================================================
// 3a. FACE REFRAME (measured: assets/face-reframe.json, never hand-tuned). On the spine AND every node of the spine an
//     engine mounts (the F3 light leak). No background-swap clip in this video (no assets/face-swap/).
// =====================================================================================================================
export const FACE_REFRAME = { scale: 1.411, x: -674, y: -340 };
const FACE_POINT = { x: 960, y: 432 };                        // face-reframe.json face_point_out: punch-ins scale about it
export const FACE_WINDOWS: [number, number][] = [             // AS-RECORDED / COVER-PLAN face_windows (source s)
  [0.0, 5.355], [22.555, 25.955], [123.322, 125.255], [250.508, 256.741], [289.741, 292.608],
  [317.975, 321.908], [350.481, 353.481], [437.348, 442.281], [460.181, 465.148],
];

// [PUNCH-IN] on the ONE interior desilencer join of the video (EDIT-PLAN 2:04.3, measured on the picture: F3 124.289,
// frame 3729, the pause between "cheap," 124.26 and "but" 124.38); holds to the face-out. No other window has a join.
// `frame` = the comp frame the post-join picture AIRS from: OffthreadVideo resolves the NEAREST source frame, the spine's
// pts sit 0.022 s past the frame grid and the join dropped 124.256, so pts 124.289 shows from comp frame 3728
// (verified on QA stills f3727 / f3728). The step lands there, on the jump cut as it airs.
export const PUNCHES = [{ at: 124.289, frame: 3728, until: 125.255, scale: 1.18 }];
const punchAt = (abs: number) => {
  for (const p of PUNCHES) if (abs >= p.frame && abs < F(p.until)) return p.scale;
  return 1;
};
// A face-out whose LAST face frame was dropped by a desilencer join resolves one comp frame early to the first black
// frame (nearest-frame rule). Only F1's edge has one (pts 5.322 dropped, QA still f160 was black under the burn): its
// cover enters that frame earlier. Every other edge was checked frame by frame (_previews/qa/edges/edge_luma.py).
const EDGE_LEAD: Record<string, number> = { '5.355': 1 };

// The comp's ONE absolute clock (comp-build.md section 6a: every node handed to an engine reads it, never the local frame).
const AbsClock = createContext(0);
const useAbs = () => useContext(AbsClock);
const useSrcT = () => unsh(useAbs() / FPS);

/** The spine, reframed + punched. `startFrom = abs - local` keeps a copy in sync in ANY nesting (section 6a). */
const SpineView: React.FC<{ audio?: boolean }> = ({ audio }) => {
  const abs = useAbs();
  const local = useCurrentFrame();
  return (
    <AbsoluteFill style={{ overflow: 'hidden', background: '#000' }}>
      <div style={{ position: 'absolute', inset: 0, overflow: 'hidden', transformOrigin: `${FACE_POINT.x}px ${FACE_POINT.y}px`, transform: `scale(${punchAt(abs)})` }}>
        <OffthreadVideo
          src={staticFile('spine.mp4')}
          muted={!audio}
          startFrom={Math.max(0, abs - local)}
          style={{ position: 'absolute', left: 0, top: 0, width: 1920, height: 1080, transformOrigin: '0 0',
                   transform: `translate(${FACE_REFRAME.x}px, ${FACE_REFRAME.y}px) scale(${FACE_REFRAME.scale})` }}
        />
      </div>
    </AbsoluteFill>
  );
};

