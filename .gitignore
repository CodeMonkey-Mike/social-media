# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ── Videos (all) ─────────────────────────────────────────────────────────────
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.m4v
*.wmv
*.flv
*.ts
*.mts

# ── Images ───────────────────────────────────────────────────────────────────
# ALL images under schedule-tweets/images/ are tracked (including x/, yt/, ig/,
# and reference/). Rationale: image deletion is irreversible without git, so
# we accept the repo-size cost for the recovery safety net.

# Loose debug/temp screenshots at the schedule-tweets root level are still
# excluded — those are throwaway, not generated content.
schedule-tweets/tmp-fb-debug/
schedule-tweets/tmp-tiktok-debug/
schedule-tweets/*.png
schedule-tweets/*.jpg

# Uploading helper screenshots — also throwaway
uploading/*.png
uploading/*.jpg
uploading/new/

# ── Config / secrets ─────────────────────────────────────────────────────────
schedule-tweets/config/

# ── Chrome profile directories ────────────────────────────────────────────────
schedule-tweets/UsersmnedeAppData*/
