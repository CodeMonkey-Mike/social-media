# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ── Videos (all) ─────────────────────────────────────────────────────────────
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.m4v
*.wmv
*.flv
*.mts
# NOTE: do NOT add a bare `*.ts` here. It was in this list for MPEG transport
# streams until 2026-08-07, and it silently excluded EVERY TypeScript file in the
# repo — all ~105 `constants-*.ts` / `captions*.ts` that the Remotion `.tsx` comps
# import. Only the `.tsx` files were tracked, so a fresh checkout could not build a
# single composition (three engine files had been force-added past the rule, which
# is how it stayed hidden). No `.ts` video files exist in this repo; the real
# recordings are .mkv/.mp4. If a transport stream ever shows up, ignore it by path.

# ── Images ───────────────────────────────────────────────────────────────────
# Generated content images (the image-batch output) are large (>50KB each) and
# reproducible by re-running the batches. With deletes now going to the Recycle
# Bin (cleanup-images), the git "recovery safety net" is no longer needed, so we
# do NOT track them. (gitignore can't filter by raw size; these dirs hold all the
# >50KB generated output.) Reference logos in images/reference/ are small, needed
# by generate-image.js --reference-image, and NOT reproducible — those stay tracked.
schedule-tweets/images/x/
schedule-tweets/images/ig/
schedule-tweets/images/yt/

# Loose debug/temp screenshots are throwaway, not content.
schedule-tweets/tmp-fb-debug/
schedule-tweets/tmp-fb-longform-debug/
schedule-tweets/tmp-tiktok-debug/
schedule-tweets/*.png
schedule-tweets/*.jpg

# Uploading helper screenshots — also throwaway
uploading/*.png
uploading/*.jpg
uploading/new/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ── Config / secrets ─────────────────────────────────────────────────────────
schedule-tweets/config/

# ── Chrome profile directories ────────────────────────────────────────────────
# A mis-quoted profile path creates a literal "UsersmnedeAppData..." folder wherever
# the script ran from — ignore the accident at any depth, not just schedule-tweets/.
UsersmnedeAppData*/
schedule-tweets/UsersmnedeAppData*/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/

# ── LangGraph checkpoints (private resume DB — data/*.json is the source of truth)
linkedin-automation/data/graph_checkpoints.sqlite*

# LangGraph live heartbeat — rewritten every second while a lane runs; the run
# HISTORY (lane_runs.json) is committed, this transient snapshot is not.
linkedin-automation/data/lane_progress.json
linkedin-automation/data/*.tmp

# Livestream-repurpose graph: same policy as linkedin's (history committed,
# heartbeat + checkpoints not).
video-creation/livestream-repurpose/graph/data/graph_checkpoints.sqlite*
video-creation/livestream-repurpose/graph/data/lane_progress.json
video-creation/livestream-repurpose/graph/data/*.tmp
